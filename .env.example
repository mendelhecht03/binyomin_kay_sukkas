# Owner authorization (comma-separated, case-insensitive)
DASHBOARD_ADMIN_EMAILS=owner@example.com

# Optional direct Google Sheets reporting export. Share the destination Sheet
# with this service-account email as an Editor, then paste its URL in /admin/.
# The private key stays in the hosting provider's secret store.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=site-sheets@example.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# DB and SUBMISSION_PHOTOS are hosting-managed D1 and R2 bindings declared in
# .openai/hosting.json. They are not secrets and do not belong in this file.
