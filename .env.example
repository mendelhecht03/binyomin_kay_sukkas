# Existing testimonial write bridge
SUKKAH_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
SUKKAH_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Owner authorization (comma-separated, case-insensitive)
DASHBOARD_ADMIN_EMAILS=owner@example.com

# Google service account used only by the server-side read API
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboard-reader@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Private editor IDs, never public responder IDs beginning with 1FAIpQL
GOOGLE_BUILDS_FORM_ID=private-builds-form-id
GOOGLE_RENTALS_FORM_ID=private-rentals-form-id

# JSON maps from canonical dashboard fields to stable Google question IDs
GOOGLE_BUILDS_FIELD_MAP={"name":"question-id"}
GOOGLE_RENTALS_FIELD_MAP={"name":"question-id"}

# Existing testimonial destination
GOOGLE_TESTIMONIALS_SPREADSHEET_ID=private-spreadsheet-id
GOOGLE_TESTIMONIALS_SHEET_NAME=Testimonials
