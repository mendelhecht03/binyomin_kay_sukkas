---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VisualOptionCard from "../../components/VisualOptionCard.astro";

const featureGroups = [
  {
    title: "Available additions",
    items: ["Custom lighting", "Doors and gates", "Windows or clear panels"],
  },
  {
    title: "Furnishings and decor",
    items: ["Tables and chairs", "Greenery and decor", "Flooring"],
  },
];

const useCases = ["Backyards", "Porches", "Courtyards", "Rooftops"];

const wallOptions = [
  {
    title: "Tarp walls",
    description: "",
    src: "/assets/images/custom-large-white-tarp.jpg",
    alt: "Large freestanding sukka with tarp walls in a parking lot",
    width: 1600,
    height: 900,
    className: "wall-option--white",
  },
  {
    title: "Soft fabric",
    description: "Draped walls for a lighter appearance.",
    src: "/assets/images/custom-soft-fabric.jpg",
    alt: "Custom wood-frame sukka with soft white fabric walls",
    width: 1600,
    height: 900,
    className: "wall-option--fabric",
  },
  {
    title: "Framed plywood walls",
    description: "Plywood wall panels can include windows and planned lighting.",
    src: "/assets/images/custom-plywood-walls.jpg",
    alt: "Interior of a sukka with framed plywood walls, two windows, schach, and string lighting",
    width: 1024,
    height: 576,
    className: "panel-option--plywood",
  },
  {
    title: "Light framed panels",
    description: "A light wood-look finish set inside a modular metal frame.",
    src: "/assets/images/custom-light-infill-panels.jpg",
    alt: "Light wood-look wall panels set inside a metal sukka frame",
    width: 1200,
    height: 900,
    className: "panel-option--light",
  },
  {
    title: "Wood lattice panels",
    description: "Open lattice panels create a bright, airy wall treatment.",
    src: "/assets/images/custom-lattice-top-rendering.jpg",
    alt: "Wood lattice panels used as sukka walls in daylight",
    width: 1600,
    height: 900,
    className: "panel-option--lattice",
  },
  {
    title: "Horizontal slat siding",
    description: "Closely spaced horizontal slats create a modern wood-look wall treatment.",
    src: "/assets/images/custom-horizontal-slat-siding.jpg",
    alt: "Custom sukka wall under construction with reddish-brown horizontal slat siding",
    width: 1200,
    height: 900,
    className: "panel-option--slats",
  },
];

const schachOptions = [
  {
    title: "Bamboo sticks",
    description: "Individual bamboo poles arranged across the roof as a natural schach option.",
    src: "/assets/images/custom-schach-bamboo-sticks.jpg",
    alt: "Bundles of bamboo sticks prepared for a custom sukka",
    width: 1600,
    height: 900,
    className: "schach-option--sticks",
  },
  {
    title: "Bamboo mats",
    description: "Bamboo matting laid across the roof for an even, natural finish.",
    src: "/assets/images/custom-schach-bamboo-mats.jpg",
    alt: "Close view of bamboo matting over a custom sukka roof",
    width: 1600,
    height: 1200,
    className: "schach-option--mats",
  },
  {
    title: "Evergreen",
    description: "Evergreen branches layered over bamboo for a natural finishing look.",
    src: "/assets/images/custom-schach-evergreen.jpg",
    alt: "Evergreen branches layered over bamboo schach on a rooftop sukka",
    width: 900,
    height: 1600,
    className: "schach-option--evergreen",
  },
];

const serviceAreas = [
  "Crown Heights",
  "East Flatbush",
  "Remsen Village",
  "Flatbush",
  "Boro Park",
  "Williamsburg",
  "Park Slope",
  "Manhattan",
  "Queens",
  "Monsey",
  "South Florida",
  "Los Angeles",
];
---

<BaseLayout
  title="Custom Sukkahs"
  description="Custom wood and metal sukkahs planned, built, delivered, and installed by Benyamin Kay Sukkahs."
>
  <div class="custom-page">
    <section class="custom-hero sukkah-hero-background" aria-labelledby="custom-sukkahs-heading">
      <div class="shell custom-hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>Custom Sukkahs</span>
        </nav>

        <div class="custom-hero__copy">
          <p class="eyebrow">Custom sukkahs</p>
          <h1 id="custom-sukkahs-heading">Built for your space.</h1>
          <p class="lead">
            A custom sukkah planned around your property, preferred materials, and the way you want to use it.
          </p>
        </div>
      </div>
    </section>

    <section class="section fit-section" aria-labelledby="made-to-fit-heading">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Custom planning</p>
          <h2 id="made-to-fit-heading">Beyond preset sizes.</h2>
          <p class="lead">
            Standard sukkahs use preset sizes and metal frames. A custom sukkah can adapt its size,
            structure, walls, and details to what is practical for your property.
          </p>
        </div>
        <ul class="use-case-list" aria-label="Suitable project sites">
          {useCases.map((useCase) => <li>{useCase}</li>)}
        </ul>
        <p class="audience-note">For families, shuls, businesses, apartment buildings, and schools.</p>
      </div>
    </section>

    <section class="section section-muted structure-section" aria-labelledby="frame-heading">
      <div class="shell structure-layout">
        <figure class="feature-photo structure-photo">
          <img
            src="/assets/images/home-craftsmanship.jpg"
            alt="A builder cutting wood for a custom sukkah frame"
            width="1200"
            height="2133"
            loading="lazy"
          />
        </figure>

        <div class="structure-copy">
          <p class="eyebrow">Structure</p>
          <h2 id="frame-heading">Wood or metal.</h2>
          <p class="structure-intro">Choose the frame that best fits the property, finish, and way the sukkah will be used.</p>
          <div class="material-choices">
            <article class="material-choice">
              <h3>Wood</h3>
              <p>A warm, custom appearance with flexibility in shape and finish. Paint or stain is available by special request.</p>
            </article>
            <article class="material-choice">
              <h3>Metal</h3>
              <p>Durable, long-lasting construction that is easier to store and reuse. Metal frames are commonly built from pipes.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section materials-section" aria-labelledby="walls-heading">
      <div class="shell">
        <div class="section-heading materials-heading">
          <p class="eyebrow">Wall options</p>
          <h2 id="walls-heading">Choose your siding.</h2>
          <p>Check below for custom siding used in our recent work, contact for availability</p>
        </div>
        <div class="option-card-grid" aria-label="Wall and siding examples">
          {wallOptions.map((option) => <VisualOptionCard {...option} />)}
        </div>
        <p class="material-note">
          Tarp walls come in varying thicknesses and colors. Exact options and pricing are confirmed during the quote.
        </p>
      </div>
    </section>

    <section class="section section-muted materials-section" aria-labelledby="schach-gallery-heading">
      <div class="shell">
        <div class="section-heading materials-heading">
          <p class="eyebrow">Roof materials</p>
          <h2 id="schach-gallery-heading">Schach.</h2>
          <p>Choose from natural schach options based on the project and current availability.</p>
        </div>
        <div class="option-card-grid" aria-label="Schach material examples">
          {schachOptions.map((option) => <VisualOptionCard {...option} />)}
        </div>
      </div>
    </section>

    <section class="section details-section" aria-labelledby="details-heading">
      <div class="shell details-panel">
        <div class="details-copy">
          <p class="eyebrow">Finishing touches</p>
          <h2 id="details-heading">The details can be personal.</h2>
          <p>
            Choose additional features and finishing details that make the sukkah work for your family or organization.{" "}
            <a href="/contact/">Contact us</a> to discuss other customization options.
          </p>
        </div>

        <div class="feature-groups">
          {featureGroups.map((group) => (
            <section class="feature-group" aria-labelledby={`feature-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
              <h3 id={`feature-${group.title.toLowerCase().replaceAll(" ", "-")}`}>{group.title}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="section planning-section" aria-labelledby="planning-heading">
      <div class="shell planning-panel">
        <div class="planning-intro">
          <p class="eyebrow">A complete project</p>
          <h2 id="planning-heading">From measuring to installation.</h2>
          <p class="site-visit-copy">We'll come by, take a look at the space, and work out what will fit best.</p>
          <p>
            Benyamin Kay Sukkahs can coordinate measuring, planning, material choices, fabrication,
            delivery, installation, schach installation, and on-request takedown and storage after Sukkos.
          </p>
        </div>

        <ol class="process-list">
          <li>
            <span>1</span>
            <div><h3>Site visit and measurements</h3><p>Review the size, access, and how the space will be used.</p></div>
          </li>
          <li>
            <span>2</span>
            <div><h3>Materials and build details</h3><p>Work through the structure, walls, schach, and finishing options.</p></div>
          </li>
          <li>
            <span>3</span>
            <div><h3>Installation timing</h3><p>Plan fabrication, delivery, and installation around confirmed availability.</p></div>
          </li>
        </ol>

        <aside class="timing-note">
          <strong>Timing and availability</strong>
          <p>You choose a preferred installation date, and B. Kay confirms availability.</p>
        </aside>
      </div>
    </section>

    <section class="section service-section" aria-labelledby="service-heading">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Service areas</p>
          <h2 id="service-heading">Projects near and far.</h2>
          <p>Custom projects are available in these areas. Confirm your location when requesting a quote.</p>
        </div>
        <ul class="service-list">{serviceAreas.map((area) => <li>{area}</li>)}</ul>
      </div>
    </section>

    <section class="section-compact custom-cta" aria-labelledby="quote-heading">
      <div class="shell">
        <div class="cta-panel">
          <div>
            <p class="eyebrow">Custom quote</p>
            <h2 id="quote-heading">Planning a custom sukkah?</h2>
            <p>Tell us about the space, size, materials, and timing you're considering.</p>
          </div>
          <div class="button-row">
            <a class="button button-light" href="/contact/">Request a custom quote</a>
            <a class="button custom-cta__phone" href="tel:+13474542282">Call (347) 454-2282</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .custom-page {
    overflow: clip;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .custom-hero {
    padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(3rem, 5vw, 4.25rem);
  }

  .custom-hero__inner {
    position: relative;
    z-index: 1;
  }

  .custom-hero .breadcrumb {
    margin-bottom: 0;
  }

  .custom-hero__copy {
    width: min(100%, 760px);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    text-align: center;
  }

  .custom-hero__copy .eyebrow {
    justify-content: center;
    margin-bottom: 0.8rem;
  }

  .custom-hero h1 {
    max-width: 760px;
    margin: 0 auto 1rem;
    font-size: clamp(3.15rem, 6vw, 5rem);
    line-height: 1;
  }

  .custom-hero .lead {
    max-width: 650px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.5;
  }

  .feature-photo {
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius);
    background: var(--cream-200);
  }

  .feature-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fit-section .section-heading {
    margin-bottom: 2rem;
  }

  .fit-section .section-heading h2 {
    max-width: 11ch;
  }

  .use-case-list,
  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .use-case-list li,
  .service-list li {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 0.58rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    color: var(--forest-900);
    background: var(--white);
    font-weight: 750;
    line-height: 1.2;
  }

  .audience-note {
    margin: 1.25rem 0 0;
    color: var(--ink-500);
    font-size: 0.94rem;
  }

  .structure-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: center;
  }

  .structure-photo {
    aspect-ratio: 4 / 3;
  }

  .structure-photo img {
    object-position: center 48%;
  }

  .structure-copy h2 {
    margin-bottom: 0.8rem;
  }

  .structure-intro {
    max-width: 34rem;
    margin-bottom: 1.7rem;
  }

  .material-choices {
    display: grid;
    gap: 0.8rem;
  }

  .material-choice {
    position: relative;
    overflow: hidden;
    padding: 1.2rem 1.25rem 1.25rem 1.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.78);
  }

  .material-choice::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    content: "";
    background: var(--wood-500);
  }

  .material-choice h3 {
    margin-bottom: 0.35rem;
    font-size: 1.4rem;
  }

  .material-choice p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .materials-heading {
    max-width: 42rem;
  }

  .option-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .option-card-grid :global(.wall-option--fabric img) {
    object-position: 40% center;
  }

  .option-card-grid :global(.panel-option--slats img) {
    object-position: right center;
  }

  .option-card-grid :global(.schach-option--evergreen img) {
    object-position: center 38%;
  }

  .material-note {
    max-width: 46rem;
    margin: 1.5rem 0 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--wood-500);
    border-radius: 0 var(--radius-small) var(--radius-small) 0;
    background: var(--cream-100);
    font-size: 0.92rem;
  }

  .details-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(28rem, 1.16fr);
    gap: clamp(2.5rem, 7vw, 5rem);
    padding: clamp(2rem, 5vw, 3.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: var(--cream-100);
  }

  .details-copy h2 {
    max-width: 12ch;
  }

  .details-copy p:last-child {
    margin-bottom: 0;
  }

  .details-copy a {
    color: var(--forest-950);
    font-weight: 750;
    text-decoration-color: var(--wood-500);
    text-underline-offset: 0.2em;
  }

  .feature-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .feature-group h3 {
    margin-bottom: 0.8rem;
    color: var(--wood-600);
    font-family: var(--font-nav);
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .feature-group ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-group li {
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0.65rem 0.8rem 0.65rem 1.1rem;
    border: 1px solid rgba(23, 63, 52, 0.12);
    border-radius: var(--radius-small);
    color: var(--forest-950);
    background: rgba(255, 255, 255, 0.65);
    font-weight: 650;
    line-height: 1.3;
  }

  .feature-group li::before {
    position: absolute;
    top: 0.8rem;
    bottom: 0.8rem;
    left: 0;
    width: 3px;
    border-radius: 0 3px 3px 0;
    content: "";
    background: var(--wood-500);
  }

  .planning-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(26rem, 1.05fr);
    gap: clamp(2.5rem, 7vw, 5rem);
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgba(23, 63, 52, 0.13);
    border-radius: var(--radius-large);
    background: var(--forest-100);
  }

  .planning-intro h2 {
    max-width: 13ch;
  }

  .site-visit-copy {
    color: var(--forest-900);
    font-size: 1.1rem;
    font-weight: 750;
    line-height: 1.5;
  }

  .planning-intro p:last-child {
    margin-bottom: 0;
  }

  .process-list {
    display: grid;
    align-content: start;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.9rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(23, 63, 52, 0.16);
  }

  .process-list li:last-child {
    border-bottom: 1px solid rgba(23, 63, 52, 0.16);
  }

  .process-list > li > span {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(150, 87, 32, 0.3);
    border-radius: var(--radius-small);
    color: var(--wood-600);
    background: rgba(255, 253, 248, 0.62);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .process-list h3 {
    margin: 0 0 0.25rem;
    font-family: var(--font-nav);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .process-list p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .timing-note {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(11rem, 0.35fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(23, 63, 52, 0.18);
  }

  .timing-note strong {
    color: var(--forest-950);
    font-family: var(--font-nav);
  }

  .timing-note p {
    margin: 0;
  }

  .service-section .section-heading {
    margin-bottom: 2rem;
  }

  .service-list li {
    color: var(--ink-700);
    font-size: 0.92rem;
  }

  .custom-cta .cta-panel {
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .custom-cta .eyebrow {
    color: #f0bd7e;
  }

  .custom-cta .eyebrow::before {
    background: #f0bd7e;
  }

  .custom-cta__phone {
    border-color: rgba(255, 255, 255, 0.72);
    color: var(--cream-50);
    background: transparent;
  }

  .custom-cta__phone:hover {
    border-color: var(--cream-50);
    color: var(--forest-950);
    background: var(--cream-50);
  }

  @media (max-width: 50rem) {
    .structure-layout,
    .details-panel,
    .planning-panel {
      grid-template-columns: 1fr;
    }

    .structure-photo {
      max-width: 46rem;
    }

    .option-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .details-panel,
    .planning-panel {
      gap: 2.25rem;
    }
  }

  @media (max-width: 46rem) {
    .custom-hero {
      padding-block: 1.35rem 2.5rem;
    }

    .custom-hero__copy {
      margin-top: 2rem;
    }

    .custom-hero h1 {
      margin-bottom: 0.75rem;
      font-size: clamp(2.55rem, 12vw, 3.7rem);
    }

    .custom-hero .lead {
      font-size: 1rem;
    }

    .structure-photo {
      aspect-ratio: 16 / 9;
    }

    .option-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .feature-groups {
      grid-template-columns: 1fr;
    }

    .details-panel,
    .planning-panel {
      padding: 1.5rem;
      border-radius: var(--radius);
    }

    .timing-note {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .service-list {
      gap: 0.55rem;
    }

    .service-list li {
      min-height: 38px;
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }

    .custom-cta .button-row {
      align-items: stretch;
      flex-direction: column;
    }

    .custom-cta .button {
      width: 100%;
    }
  }

  @media (max-width: 28rem) {
    .use-case-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .use-case-list li {
      justify-content: center;
      padding-inline: 0.65rem;
    }
  }

  @media (max-width: 23rem) {
    .option-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
