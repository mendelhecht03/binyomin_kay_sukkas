---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormPageActions from "../../components/FormPageActions.astro";

const featuredProject = {
  title: "A finished gathering space",
  description:
    "A roomy custom sukkah finished with tarp walls, carpeting, lighting, and space set up for guests.",
  src: "/assets/images/custom-carpet-flooring.jpg",
  alt: "Finished custom sukkah interior with carpeting, tarp walls, schach, and overhead lighting",
  width: 1200,
  height: 900,
  tags: ["Tarp walls", "Floor covering", "Lighting", "Large interior"],
};

const recentProjects = [
  {
    title: "Large community sukkah",
    description:
      "A wide custom footprint enclosed with clean white tarp walls for a practical, weather-ready finish.",
    src: "/assets/images/custom-large-white-tarp.jpg",
    alt: "Large finished freestanding sukkah with white tarp walls",
    width: 1600,
    height: 900,
    tags: ["Metal frame", "Tarp walls", "Freestanding"],
    className: "project-card--wide",
  },
  {
    title: "Wood lattice sukkah",
    description:
      "A bright, open custom build using wood lattice walls and a bamboo mat overhead.",
    src: "/assets/images/custom-lattice-top-rendering.jpg",
    alt: "Finished custom wood lattice sukkah with a bamboo mat in daylight",
    width: 1672,
    height: 941,
    tags: ["Wood lattice", "Bamboo mat", "Open finish"],
    className: "project-card--lattice",
  },
  {
    title: "Front yard custom fit",
    description:
      "A sukkah shaped around a compact front yard with cloth wall covering and a wood frame.",
    src: "/assets/images/custom-soft-fabric.jpg",
    alt: "Finished front yard custom sukkah with white cloth wall covering and a wood frame",
    width: 1600,
    height: 900,
    tags: ["Front yard", "Cloth walls", "Wood frame"],
    className: "project-card--backyard",
  },
  {
    title: "Windowed wood interior",
    description:
      "Framed plywood walls, windows, lighting, and schach create a more enclosed finished interior.",
    src: "/assets/images/custom-plywood-walls.jpg",
    alt: "Finished sukkah interior with framed plywood walls, windows, lighting, and schach",
    width: 1024,
    height: 576,
    tags: ["Plywood walls", "Windows", "Lighting"],
    className: "project-card--plywood",
  },
];

const supportingProjects = recentProjects.slice(0, 2);
const additionalProjects = recentProjects.slice(2);

const useCases = ["Backyards", "Porches", "Courtyards", "Rooftops"];

const customizationGroups = [
  {
    slug: "walls",
    title: "Walls and siding",
    summary: "Flexible coverings, framed panels, lattice, and wood finishes.",
    prompt: "View siding options",
    items: [
      {
        title: "Tarp walls",
        description: "Available in different thicknesses and colors based on the project.",
      },
      {
        title: "Cloth walls",
        description: "Cloth wall coverings for a lighter, more flexible finished appearance.",
      },
      {
        title: "Framed plywood walls",
        description: "Solid wall panels that can include planned windows and lighting.",
      },
      {
        title: "Light framed panels",
        description: "A light wood-look finish set inside a modular frame.",
      },
      {
        title: "Wood lattice panels",
        description: "An airy wall treatment that keeps the build bright and open.",
      },
      {
        title: "Horizontal slat siding",
        description: "Closely spaced slats for a warm, modern wood-look finish.",
      },
    ],
  },
  {
    slug: "schach",
    title: "Schach",
    summary: "Natural roof options selected to suit the build and availability.",
    prompt: "View schach options",
    items: [
      {
        title: "Bamboo sticks",
        description: "Individual bamboo poles arranged across the roof.",
      },
      {
        title: "Bamboo mats",
        description: "Bamboo matting laid across the roof for an even natural finish.",
      },
      {
        title: "Evergreen",
        description: "Evergreen branches layered as a natural finishing option.",
      },
    ],
  },
  {
    slug: "finishing",
    title: "Finishing touches",
    summary: "Practical additions that make the sukkah work for your group.",
    prompt: "View finishing options",
    items: [
      {
        title: "Lighting",
        description: "Plan useful lighting around the size and layout of the sukkah.",
      },
      {
        title: "Doors, gates, and windows",
        description: "Add access points, clear panels, or windows where practical.",
      },
      {
        title: "Furniture and decor",
        description: "Tables, chairs, greenery, and decor can be coordinated as needed.",
      },
      {
        title: "Flooring",
        description: "Floor coverings can help create a cleaner, more finished interior.",
      },
    ],
  },
];

const serviceAreas = ["New York", "New Jersey", "Connecticut"];
---

<BaseLayout
  title="Custom Sukkahs"
  description="See recent custom sukkahs planned and built around backyards, porches, rooftops, and other unique spaces."
>
  <div class="custom-page">
    <section class="custom-hero sukkah-hero-background" aria-labelledby="custom-sukkahs-heading">
      <div class="shell custom-hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span>Custom Sukkahs</span>
        </nav>

        <div class="custom-hero__copy">
          <p class="eyebrow">Custom sukkahs</p>
          <h1 id="custom-sukkahs-heading">Built for your space.</h1>
          <p class="lead">
            Each custom sukkah is planned around the property, available space,
            materials, and the way you want to use it.
          </p>
          <FormPageActions
            primaryLabel="Start a custom sukkah request"
            primaryHref="/request/custom-sukkah/"
            secondaryLabel="See recent projects"
            secondaryHref="#recent-projects"
            ariaLabel="Custom sukkah actions"
          />
        </div>
      </div>
    </section>

    <section id="recent-projects" class="section projects-section" aria-labelledby="recent-projects-heading">
      <div class="shell">
        <div class="section-heading projects-heading">
          <p class="eyebrow">Recent projects</p>
          <h2 id="recent-projects-heading">See what we've built.</h2>
          <p class="lead">
            Every space is different. Here are a few custom sukkahs and the
            details that helped each one work.
          </p>
        </div>

        <div class="project-showcase">
          <article class="featured-project">
            <figure class="featured-project__media">
              <img
                src={featuredProject.src}
                alt={featuredProject.alt}
                width={featuredProject.width}
                height={featuredProject.height}
                loading="eager"
                fetchpriority="high"
              />
            </figure>
            <div class="featured-project__content">
              <p class="project-kicker">Featured build</p>
              <h3>{featuredProject.title}</h3>
              <p>{featuredProject.description}</p>
              <ul class="project-tags" aria-label="Featured project details">
                {featuredProject.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </article>

          <div class="project-showcase__side">
            {supportingProjects.map((project) => (
              <article class:list={["project-card", "project-card--compact", project.className]}>
                <figure class="project-card__media">
                  <img
                    src={project.src}
                    alt={project.alt}
                    width={project.width}
                    height={project.height}
                    loading="lazy"
                  />
                </figure>
                <div class="project-card__content">
                  <p class="project-kicker">Recent work</p>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <ul class="project-tags" aria-label={project.title + " details"}>
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="project-grid">
          {additionalProjects.map((project) => (
            <article class:list={["project-card", project.className]}>
              <figure class="project-card__media">
                <img
                  src={project.src}
                  alt={project.alt}
                  width={project.width}
                  height={project.height}
                  loading="lazy"
                />
              </figure>
              <div class="project-card__content">
                <p class="project-kicker">Recent work</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="project-tags" aria-label={project.title + " details"}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted fit-section" aria-labelledby="made-to-fit-heading">
      <div class="shell fit-panel">
        <div>
          <p class="eyebrow">Designed around the site</p>
          <h2 id="made-to-fit-heading">Beyond preset sizes.</h2>
        </div>
        <div class="fit-copy">
          <p>
            A custom sukkah can adapt its size, walls, and details to what is
            practical for your property. We'll come by, look at the space, and
            work out what can fit.
          </p>
          <ul class="use-case-list" aria-label="Suitable project sites">
            {useCases.map((useCase) => <li>{useCase}</li>)}
          </ul>
          <p class="audience-note">
            For families, shuls, businesses, apartment buildings, and schools.
          </p>
        </div>
      </div>
    </section>

    <section class="section customization-section" aria-labelledby="customization-heading">
      <div class="shell">
        <div class="section-heading customization-heading">
          <p class="eyebrow">Customize your build</p>
          <h2 id="customization-heading">Make it yours.</h2>
          <p>
            Choose the walls, schach, and finishing details that work for the
            space. Exact options are confirmed during the quote.
          </p>
        </div>

        <div class="customization-grid">
          {customizationGroups.map((group) => (
            <details class="customization-card">
              <summary aria-controls={"customization-" + group.slug}>
                <span class="customization-card__title">{group.title}</span>
                <span class="customization-card__summary">{group.summary}</span>
                <span class="customization-card__prompt">
                  <span class="prompt-closed">{group.prompt}</span>
                  <span class="prompt-open">Hide options</span>
                </span>
              </summary>
              <div class="customization-card__body" id={"customization-" + group.slug}>
                <ul class="option-list">
                  {group.items.map((item) => (
                    <li>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section planning-section" aria-labelledby="planning-heading">
      <div class="shell planning-panel">
        <div class="planning-intro">
          <p class="eyebrow">A complete project</p>
          <h2 id="planning-heading">From measuring to installation.</h2>
          <p class="site-visit-copy">
            We'll come by, take a look at the space, and figure out what will
            work best.
          </p>
          <p>
            Planning can include measurements, material choices, fabrication,
            delivery, installation, schach installation, and requested
            takedown or storage after Sukkos.
          </p>
        </div>

        <ol class="process-list">
          <li>
            <span>1</span>
            <div>
              <h3>Site visit and measurements</h3>
              <p>Review the size, access, and how the space will be used.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>Plan the build</h3>
              <p>Work through the size, walls, schach, and useful extras.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>Build and installation</h3>
              <p>Coordinate fabrication, delivery, and installation timing.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section service-section" aria-labelledby="service-heading">
      <div class="shell">
        <div class="section-heading service-heading">
          <p class="eyebrow">Service areas</p>
          <h2 id="service-heading">Serving the tri-state area.</h2>
          <p>
            Custom builds are available in New York, New Jersey, and Connecticut.
            Confirm your exact location when requesting a quote.
          </p>
        </div>
        <ul class="service-list">{serviceAreas.map((area) => <li>{area}</li>)}</ul>
      </div>
    </section>

    <section class="section-compact custom-cta" aria-labelledby="quote-heading">
      <div class="shell">
        <div class="cta-panel">
          <div>
            <p class="eyebrow">Custom quote</p>
            <h2 id="quote-heading">Planning a custom sukkah?</h2>
            <p>Tell us about the space, size, materials, and timing you have in mind.</p>
          </div>
          <div class="button-row">
            <a class="button button-light" href="/request/custom-sukkah/">Start a custom sukkah request</a>
            <a class="button custom-cta__phone" href="tel:+13474542282">Call (347) 454-2282</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .custom-page {
    overflow: clip;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .custom-hero {
    padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(3rem, 5vw, 4.25rem);
  }

  .custom-hero__inner {
    position: relative;
    z-index: 1;
  }

  .custom-hero .breadcrumb {
    margin-bottom: 0;
  }

  .custom-hero__copy {
    width: min(100%, 760px);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    text-align: center;
  }

  .custom-hero__copy .eyebrow {
    justify-content: center;
    margin-bottom: 0.8rem;
  }

  .custom-hero h1 {
    max-width: 760px;
    margin: 0 auto 1rem;
    font-size: clamp(3.15rem, 6vw, 5rem);
    line-height: 1;
  }

  .custom-hero .lead {
    max-width: 650px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.5;
  }

  .projects-section {
    background:
      radial-gradient(circle at 100% 0%, rgba(216, 163, 95, 0.08), transparent 28rem),
      var(--cream-50);
  }

  .projects-heading {
    max-width: 48rem;
  }

  .project-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.48fr) minmax(21rem, 0.82fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .featured-project {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    min-height: clamp(42rem, 64vw, 52rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    color: var(--forest-950);
    background: var(--white);
    transition: border-color 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .featured-project:hover {
    border-color: var(--border-strong);
    box-shadow: 0 20px 48px rgba(16, 45, 37, 0.1);
    transform: translateY(-4px);
  }

  .featured-project__media,
  .project-card__media {
    position: relative;
    overflow: hidden;
    min-width: 0;
    margin: 0;
    background: var(--cream-200);
  }

  .featured-project__media {
    min-height: 0;
  }

  .featured-project__media img,
  .project-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-project:hover .featured-project__media img,
  .project-card:hover .project-card__media img {
    transform: scale(1.035);
  }

  .featured-project__media img {
    object-position: center 44%;
  }

  .featured-project__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.6rem, 3vw, 2.35rem);
  }

  .project-kicker {
    margin: 0 0 0.75rem;
    color: var(--wood-600);
    font-family: var(--font-nav);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured-project h3 {
    max-width: 15ch;
    margin-bottom: 0.8rem;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    line-height: 1.04;
  }

  .featured-project__content > p:not(.project-kicker) {
    margin-bottom: 1.4rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.6rem);
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  .project-showcase__side {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .project-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: var(--white);
    color: var(--forest-950);
    transition: border-color 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 20px 48px rgba(16, 45, 37, 0.1);
    transform: translateY(-4px);
  }

  .project-card__media {
    aspect-ratio: 16 / 10;
  }

  .project-card--compact {
    display: grid;
    grid-template-columns: minmax(9.5rem, 0.82fr) minmax(0, 1.18fr);
    min-width: 0;
  }

  .project-card--compact .project-card__media {
    min-height: 100%;
    aspect-ratio: auto;
  }

  .project-card--compact .project-card__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.05rem, 2vw, 1.45rem);
  }

  .project-card--compact .project-kicker {
    margin-bottom: 0.48rem;
    font-size: 0.7rem;
  }

  .project-card--compact h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  .project-card--compact .project-card__content > p:not(.project-kicker) {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.85rem;
    font-size: 0.82rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .project-card--compact .project-tags {
    gap: 0.35rem;
  }

  .project-card--compact .project-tags li {
    min-height: 29px;
    padding: 0.3rem 0.5rem;
    font-size: 0.68rem;
  }

  .project-card--compact .project-tags li:nth-child(n + 3) {
    display: none;
  }

  .project-card--wide .project-card__media img {
    object-position: center 48%;
  }

  .project-card--lattice .project-card__media img {
    object-position: center 46%;
  }

  .project-card--backyard .project-card__media img {
    object-position: center 52%;
  }

  .project-card--plywood .project-card__media img {
    object-position: center 42%;
  }

  .project-card__content {
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .project-card h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.55rem, 2.6vw, 2.05rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .project-card__content > p {
    margin-bottom: 1.1rem;
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .project-tags,
  .use-case-list,
  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-tags li {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.68rem;
    border: 1px solid rgba(23, 63, 52, 0.15);
    border-radius: 999px;
    color: var(--forest-900);
    background: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .fit-panel {
    display: grid;
    grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 5.5rem);
    align-items: start;
  }

  .fit-panel h2 {
    max-width: 10ch;
  }

  .fit-copy > p:first-child {
    max-width: 42rem;
    margin-bottom: 1.5rem;
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .use-case-list li,
  .service-list li {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0.52rem 0.88rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    color: var(--forest-900);
    background: var(--white);
    font-weight: 750;
    line-height: 1.2;
  }

  .audience-note {
    margin: 1.1rem 0 0;
    color: var(--ink-500);
    font-size: 0.92rem;
  }

  .customization-heading {
    max-width: 46rem;
  }

  .customization-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    margin-top: 2rem;
  }

  .customization-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    transition: border-color 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .customization-card:hover,
  .customization-card:focus-within {
    border-color: var(--border-strong);
    box-shadow: 0 20px 48px rgba(16, 45, 37, 0.08);
    transform: translateY(-3px);
  }

  .customization-card[open] {
    border-color: rgba(150, 87, 32, 0.32);
  }

  .customization-card summary {
    position: relative;
    min-height: 13.5rem;
    display: flex;
    flex-direction: column;
    padding: 1.45rem 3.2rem 1.35rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  .customization-card summary::-webkit-details-marker {
    display: none;
  }

  .customization-card summary::after {
    position: absolute;
    top: 1.35rem;
    right: 1.3rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(23, 63, 52, 0.18);
    border-radius: 999px;
    color: var(--forest-900);
    content: "+";
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .customization-card[open] summary::after {
    content: "−";
    background: var(--forest-100);
    transform: rotate(180deg);
  }

  .customization-card summary:hover::after {
    background: var(--forest-100);
  }

  .customization-card__title {
    max-width: 12ch;
    color: var(--forest-950);
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.08;
  }

  .customization-card__summary {
    margin-top: 0.65rem;
    color: var(--ink-500);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .customization-card__prompt {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--wood-600);
    font-size: 0.8rem;
    font-weight: 850;
