---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormHeading from "../../components/FormHeading.astro";
import Field from "../../components/Field.astro";
import Choices from "../../components/Choices.astro";

const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? "";

const services = ["Take out of storage", "Build", "Take down"];
const sukkahTypes = ["Canvas", "Canvas Bingo", "Snap / panel", "Wood boards with bolts", "Schach and beams only"];
const schachTypes = ["Bamboo mat", "Bamboo sticks", "Evergreen or other branches"];
const addOns = ["Put up lights", "Pressure wash the area the day before", "Bamboo mat", "Evergreen"];
---

<BaseLayout title="Sukka Builder — Custom Form Preview" description="A polished custom-form concept for the BKAY Sukka Builder.">
  <section class="preview-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/sukka-builder/">Sukka Builder</a><span aria-hidden="true">/</span>
        <span aria-current="page">Custom preview</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Custom builder concept</p>
          <h1>Your sukkah starts with a good plan.</h1>
          <p class="lead">Share the practical details once, and we’ll have what we need to understand the job and prepare your quote.</p>
          <div class="hero-meta" aria-label="Form details">
            <span><strong>6</strong> short sections</span>
            <span><strong>5–8</strong> minutes</span>
            <span><strong>1</strong> optional photo</span>
          </div>
        </div>

        <aside class="prep-card" aria-labelledby="prep-heading">
          <p class="prep-label">Before you begin</p>
          <h2 id="prep-heading">A few details help us quote accurately.</h2>
          <ul>
            <li><span aria-hidden="true">✓</span> Approximate sukkah size</li>
            <li><span aria-hidden="true">✓</span> Sukkah and schach type</li>
            <li><span aria-hidden="true">✓</span> Preferred dates</li>
            <li><span aria-hidden="true">✓</span> A site photo, if useful</li>
          </ul>
          <p class="preview-badge"><span aria-hidden="true"></span><strong>Design preview:</strong> nothing is sent or saved.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="form-section" aria-labelledby="form-heading">
    <div class="shell form-shell">
      <div class="form-intro">
        <div><p class="eyebrow">Project details</p><h2 id="form-heading">Tell us about your sukkah</h2></div>
        <p>Required fields are clearly labeled. You can review everything before anything is submitted.</p>
      </div>

      <div class="form-layout">
        <aside class="form-rail" aria-label="Form sections">
          <p class="rail-title">Your progress</p>
          <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
          <nav>
            <a href="#contact-details" data-step-link="1"><span>01</span> Contact</a>
            <a href="#service-details" data-step-link="2"><span>02</span> Service</a>
            <a href="#sukkah-details" data-step-link="3"><span>03</span> Sukkah</a>
            <a href="#site-details" data-step-link="4"><span>04</span> Site</a>
            <a href="#timing-details" data-step-link="5"><span>05</span> Timing</a>
            <a href="#final-details" data-step-link="6"><span>06</span> Final details</a>
          </nav>
          <p class="rail-help">Need help?<br /><a href="tel:+13474542282">Call (347) 454-2282</a></p>
        </aside>

        <form class="builder-form" data-preview-form>
          <section id="contact-details" class="form-card form-group" aria-labelledby="contact-heading" data-form-step="1">
            <FormHeading number="1" eyebrow="Contact details" heading="How can we reach you?" id="contact-heading" />
            <p class="section-copy">We’ll only use these details to follow up about your sukkah.</p>
            <div class="form-grid">
              <Field id="name" label="Full name" autocomplete="name" required />
              <Field id="phone" label="Phone number" type="tel" autocomplete="tel" required />
              <Field id="email" label="Email address" type="email" autocomplete="email" required />
            </div>
          </section>

          <section id="service-details" class="form-card form-group" aria-labelledby="service-heading" data-form-step="2">
            <FormHeading number="2" eyebrow="Location and service" heading="Where are you, and what do you need?" id="service-heading" />
            <div class="address-field" data-address-autocomplete data-maps-api-key={mapsApiKey}>
              <label for="project-address">Project address <span class="required-label">Required</span></label>
              <p class="field-hint">Start typing, then select the complete address from the suggestions.</p>
              <input
                id="project-address"
                name="address"
                type="text"
                autocomplete="street-address"
                placeholder="123 Eastern Parkway, Brooklyn, NY 11213"
                data-address-input
                required
              />
              <div class="address-widget" data-address-widget hidden></div>
              <p class="address-status" data-address-status aria-live="polite"></p>
            </div>
            <Choices legend="Requested work" name="service" options={services} type="checkbox" requiredHint otherLabel="Other requested service" />
          </section>

          <section id="sukkah-details" class="form-card form-group" aria-labelledby="details-heading" data-form-step="3">
            <FormHeading number="3" eyebrow="Sukkah details" heading="Tell us what you have" id="details-heading" />
            <div class="field short-field">
              <label for="estimated-size">Estimated size <span class="required-label">Required</span></label>
              <input id="estimated-size" name="estimatedSize" placeholder="For example, 8 × 10 feet" required />
              <p class="field-hint">An estimate is fine if you do not know the exact measurements.</p>
            </div>
            <Choices legend="Sukkah type" name="sukkahType" options={sukkahTypes} type="radio" required otherLabel="Other sukkah type" />
            <Choices legend="Schach type" name="schach" options={schachTypes} type="checkbox" requiredHint otherLabel="Other schach type" />
            <Choices legend="Optional add-ons" name="addOns" options={addOns} type="checkbox" otherLabel="Other add-on" />
          </section>

          <section id="site-details" class="form-card form-group" aria-labelledby="site-heading" data-form-step="4">
            <FormHeading number="4" eyebrow="Site details" heading="Help us understand the space" id="site-heading" />
            <div class="field">
              <label for="site-description">Where will the sukkah be built?</label>
              <textarea id="site-description" name="siteDescription" placeholder="Tell us about stairs, gates, the yard or deck, parking, and anything else that affects access."></textarea>
            </div>
            <div class="upload-field">
              <div class="upload-icon" aria-hidden="true">↑</div>
              <div><label for="site-photo">Add a photo of the area</label><p>Optional · JPG, PNG, or HEIC · Maximum 10 MB</p></div>
              <input id="site-photo" name="sitePhoto" type="file" accept="image/*" />
            </div>
          </section>

          <section id="timing-details" class="form-card form-group" aria-labelledby="timing-heading" data-form-step="5">
            <FormHeading number="5" eyebrow="Timing" heading="When should we come?" id="timing-heading" />
            <p class="section-copy">The Google Form’s choices were dated 2024, so this concept uses flexible date fields instead.</p>
            <div class="date-grid">
              <div class="field"><label for="build-date">Preferred build date <span class="required-label">Required</span></label><input id="build-date" name="buildDate" type="date" required /></div>
              <div class="field"><label for="takedown-date">Preferred takedown date <span class="required-label">Required</span></label><input id="takedown-date" name="takedownDate" type="date" required /></div>
            </div>
            <div class="field"><label for="timing-notes">Timing notes</label><input id="timing-notes" name="timingNotes" placeholder="For example, Motzei Yom Kippur or mornings only" /></div>
          </section>

          <section id="final-details" class="form-card form-group" aria-labelledby="final-heading" data-form-step="6">
            <FormHeading number="6" eyebrow="Final details" heading="Anything else we should know?" id="final-heading" />
            <div class="field"><label for="referral">How did you hear about us? <span class="required-label">Required</span></label><p class="field-hint">This helps us understand which advertising is useful.</p><input id="referral" name="referral" required /></div>
            <div class="field"><label for="comments">Comments or questions</label><textarea id="comments" name="comments" placeholder="Add any details that did not fit above."></textarea></div>
          </section>

          <div class="review-panel">
            <div class="review-copy"><p class="eyebrow">Ready to review?</p><h3>Your details will appear here before a real submission.</h3><p>This prototype lets us compare the design without collecting customer information.</p></div>
            <div class="submit-actions"><button class="button" type="submit">Review preview</button><button class="clear-button" type="reset">Clear form</button></div>
            <p class="form-status" data-preview-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("[data-preview-form]");
  const status = document.querySelector("[data-preview-status]");
  const progressBar = document.querySelector("[data-progress-bar]");
  const stepLinks = Array.from(document.querySelectorAll("[data-step-link]"));
  const steps = Array.from(document.querySelectorAll("[data-form-step]"));
  const addressContainer = document.querySelector("[data-address-autocomplete]");
  const addressInput = document.querySelector("[data-address-input]");
  const addressWidget = document.querySelector("[data-address-widget]");
  const addressStatus = document.querySelector("[data-address-status]");

  const setActiveStep = (stepNumber) => {
    stepLinks.forEach((link) => link.toggleAttribute("data-active", link.getAttribute("data-step-link") === stepNumber));
    if (progressBar instanceof HTMLElement) progressBar.style.width = `${(Number(stepNumber) / steps.length) * 100}%`;
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible instanceof IntersectionObserverEntry && visible.target instanceof HTMLElement) setActiveStep(visible.target.dataset.formStep ?? "1");
    }, { rootMargin: "-18% 0px -60%", threshold: [0.1, 0.35] });
    steps.forEach((step) => observer.observe(step));
  }
  setActiveStep("1");

  const loadGoogleMaps = (apiKey) => new Promise((resolve, reject) => {
    if (window.google?.maps?.importLibrary) { resolve(window.google.maps); return; }
    const callbackName = `initBkayPlaces${Date.now()}`;
    const script = document.createElement("script");
    window[callbackName] = () => {
      resolve(window.google.maps);
      delete window[callbackName];
    };
    script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&v=weekly&loading=async&callback=${callbackName}`;
    script.async = true;
    script.onerror = () => reject(new Error("Google Places could not load."));
    document.head.append(script);
  });

  const enableAddressAutocomplete = async () => {
    if (!(addressContainer instanceof HTMLElement) || !(addressInput instanceof HTMLInputElement) || !(addressWidget instanceof HTMLElement)) return;
    const apiKey = addressContainer.dataset.mapsApiKey;
    if (!apiKey) return;

    try {
      const maps = await loadGoogleMaps(apiKey);
      const { PlaceAutocompleteElement } = await maps.importLibrary("places");
      const autocomplete = new PlaceAutocompleteElement();
      autocomplete.placeholder = "Start typing the project address";
      autocomplete.includedRegionCodes = ["us"];
      autocomplete.className = "google-address-autocomplete";
      autocomplete.addEventListener("gmp-select", async (event) => {
        const { placePrediction } = event;
        const place = placePrediction.toPlace();
        await place.fetchFields({ fields: ["formattedAddress", "location"] });
        if (!place.formattedAddress) return;
        addressInput.value = place.formattedAddress;
        addressContainer.dataset.addressSelected = "true";
        if (addressStatus instanceof HTMLElement) addressStatus.textContent = `Selected address: ${place.formattedAddress}`;
      });
      addressInput.required = false;
      addressInput.hidden = true;
      addressWidget.hidden = false;
      addressWidget.append(autocomplete);
      addressContainer.dataset.enhanced = "true";
    } catch {
      if (addressStatus instanceof HTMLElement) addressStatus.textContent = "Address suggestions are temporarily unavailable. Please enter the full address manually.";
    }
  };
  enableAddressAutocomplete();

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    const serviceCount = form.querySelectorAll('input[name="service"]:checked').length;
    const schachCount = form.querySelectorAll('input[name="schach"]:checked').length;
    const photo = form.querySelector('input[type="file"]');
    if (addressContainer instanceof HTMLElement && addressContainer.dataset.enhanced === "true" && addressContainer.dataset.addressSelected !== "true") {
      status.dataset.state = "error";
      status.textContent = "Please select a complete project address from the suggestions.";
      addressContainer.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    if (!serviceCount || !schachCount) {
      status.dataset.state = "error";
      status.textContent = "Please choose at least one requested service and one schach type.";
      return;
    }
    if (photo instanceof HTMLInputElement && photo.files?.[0] && photo.files[0].size > 10 * 1024 * 1024) {
      status.dataset.state = "error";
      status.textContent = "Please choose a photo smaller than 10 MB.";
      return;
    }
    status.dataset.state = "success";
    status.textContent = "Preview complete — nothing was sent or saved. This design is ready to connect to a real submission system.";
    status.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  form?.addEventListener("reset", () => {
    if (status instanceof HTMLElement) { status.textContent = ""; status.removeAttribute("data-state"); }
  });
</script>

<style is:global>
  .preview-hero{position:relative;overflow:hidden;padding-block:clamp(3rem,7vw,6.5rem);background:linear-gradient(135deg,#f8f4ea 0%,#f3ecdd 55%,#e9efe9 100%)}
  .preview-hero::after{position:absolute;right:-9rem;bottom:-15rem;width:34rem;height:34rem;border:1px solid rgba(23,63,52,.12);border-radius:50%;box-shadow:0 0 0 5rem rgba(255,255,255,.16),0 0 0 10rem rgba(255,255,255,.12);content:"";pointer-events:none}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:clamp(3rem,7vw,7rem);align-items:center;padding-top:clamp(2.5rem,5vw,4.5rem)}
  .hero-copy h1{max-width:800px;font-size:clamp(3.2rem,7vw,6.25rem)}.hero-copy .lead{max-width:680px;font-size:clamp(1.1rem,2vw,1.3rem)}
  .hero-meta{display:flex;flex-wrap:wrap;gap:.7rem 2rem;margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--border-strong);color:var(--ink-700);font-size:.9rem}.hero-meta span{display:flex;gap:.4rem;align-items:baseline}.hero-meta strong{color:var(--forest-900);font-family:var(--font-heading);font-size:1.45rem}
  .prep-card{position:relative;padding:clamp(1.6rem,3vw,2.25rem);border:1px solid rgba(255,255,255,.45);border-radius:var(--radius-large);color:white;background:var(--forest-900);box-shadow:0 28px 70px rgba(16,45,37,.2)}
  .prep-label{margin-bottom:.65rem;color:#e5c28e;font-size:.75rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.prep-card h2{margin-bottom:1.4rem;color:white;font-size:clamp(1.65rem,3vw,2.25rem)}.prep-card ul{display:grid;gap:.75rem;margin:0;padding:0;list-style:none}.prep-card li{display:flex;gap:.7rem;align-items:center;color:rgba(255,255,255,.85)}.prep-card li span{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;color:var(--forest-900);background:#e5c28e;font-size:.8rem;font-weight:900}.preview-badge{display:flex;gap:.6rem;align-items:flex-start;margin:1.5rem 0 0;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.16);color:rgba(255,255,255,.72);font-size:.84rem}.preview-badge>span{flex:0 0 .55rem;width:.55rem;height:.55rem;margin-top:.4rem;border-radius:50%;background:#e5c28e;box-shadow:0 0 0 4px rgba(229,194,142,.12)}
  .form-section{padding-block:clamp(4rem,8vw,7rem);background:#fdfbf6}.form-shell{max-width:1180px}.form-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,420px);gap:2rem;align-items:end;margin-bottom:2.25rem;padding-bottom:1.75rem;border-bottom:1px solid var(--border)}.form-intro h2,.form-intro p:last-child{margin-bottom:0}.form-intro>p{color:var(--ink-700)}
  .form-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:clamp(2rem,5vw,4.5rem);align-items:start}.form-rail{position:sticky;top:6.5rem;padding:1.25rem 0}.rail-title{margin-bottom:.65rem;color:var(--forest-900);font-size:.78rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.progress-track{height:4px;margin-bottom:1.25rem;overflow:hidden;border-radius:99px;background:var(--cream-200)}.progress-track span{display:block;width:16.66%;height:100%;border-radius:inherit;background:var(--wood-500);transition:width 240ms ease}.form-rail nav{display:grid;gap:.15rem}.form-rail nav a{display:flex;gap:.8rem;align-items:center;padding:.55rem 0;color:var(--ink-500);text-decoration:none;transition:color 160ms ease,transform 160ms ease}.form-rail nav a span{color:var(--wood-600);font-size:.72rem;font-weight:850;letter-spacing:.08em}.form-rail nav a[data-active]{color:var(--forest-900);font-weight:800;transform:translateX(4px)}.rail-help{margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border);color:var(--ink-500);font-size:.84rem}.rail-help a{color:var(--forest-800);font-weight:800}
  .builder-form{display:grid;gap:1.25rem;min-width:0}.form-card{scroll-margin-top:7rem;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 10px 35px rgba(16,45,37,.055)}.form-group{display:grid;gap:1.8rem}.form-group-heading{display:grid;grid-template-columns:3rem 1fr;gap:1rem;align-items:center}.form-group-heading h3,.form-group-heading .eyebrow{margin-bottom:0}.form-group-heading h3{font-size:clamp(1.65rem,3vw,2.25rem)}.step-number{display:grid;width:3rem;height:3rem;place-items:center;border:1px solid rgba(200,134,67,.4);border-radius:12px;color:var(--forest-900);background:#fbf2e5;font-family:var(--font-heading);font-size:1.35rem;font-weight:700}.section-copy{margin:-.65rem 0 0 4rem;color:var(--ink-500);font-size:.92rem}
  .builder-form .field{gap:.5rem}.builder-form label,.builder-form legend{font-family:"Segoe UI",Arial,sans-serif;font-size:.94rem;font-weight:700;letter-spacing:0}.builder-form input,.builder-form textarea{min-height:54px;border-color:rgba(29,41,37,.2);border-radius:10px;background:#fff}.builder-form input:not([type="radio"]):not([type="checkbox"]):focus,.builder-form textarea:focus{border-color:var(--forest-700);box-shadow:0 0 0 4px rgba(45,104,85,.1)}.builder-form input::placeholder,.builder-form textarea::placeholder{color:#89938f;font-weight:400}.required-label{display:inline-block;margin-left:.4rem;padding:.15rem .4rem;border-radius:4px;color:var(--wood-600);background:#fbf2e5;font-size:.64rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.required-mark{color:var(--wood-600)}
  .address-field{display:grid;gap:.5rem;max-width:720px;padding:1.15rem;border:1px solid var(--border);border-radius:12px;background:#f9fbf9}.address-field>label{font-size:1rem}.address-field>.field-hint{margin-bottom:.2rem}.address-widget,.google-address-autocomplete{width:100%}.address-status{min-height:1.25rem;margin:0;color:var(--forest-700);font-size:.82rem;font-weight:700}.address-status:empty{display:none}
  .form-grid,.date-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem}.short-field{max-width:520px}.builder-form fieldset{display:grid;gap:.8rem;min-width:0;margin:0;padding:0;border:0}.builder-form legend{margin-bottom:.25rem;font-size:1rem}.choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.choice-stack{display:grid;gap:.65rem}.choice-card{display:flex;gap:.65rem;align-items:center;min-height:52px;padding:.7rem .8rem;border:1px solid rgba(29,41,37,.16);border-radius:10px;background:#fff;cursor:pointer;transition:border-color 160ms ease,background 160ms ease,box-shadow 160ms ease}.choice-card:hover{border-color:rgba(45,104,85,.45);background:#fbfdfb}.choice-card:has(input:checked){border-color:var(--forest-700);background:var(--forest-100);box-shadow:inset 0 0 0 1px var(--forest-700)}.choice-card:has(input[type="radio"]:checked){background:#fff}.choice-card input[type="radio"],.choice-card input[type="checkbox"]{flex:0 0 auto;width:1.05rem;min-height:1.05rem;height:1.05rem;margin:0;accent-color:var(--forest-700)}.choice-card span{line-height:1.3}.choice-other{flex-wrap:wrap}.choice-other>input:last-child{flex:1 1 135px;min-height:38px;padding:.5rem .65rem;background:white}.field-hint{font-size:.82rem}
  .upload-field{display:grid;grid-template-columns:auto 1fr minmax(190px,auto);gap:1rem;align-items:center;padding:1.15rem;border:1px dashed rgba(45,104,85,.38);border-radius:12px;background:#f7faf7}.upload-icon{display:grid;width:2.65rem;height:2.65rem;place-items:center;border-radius:10px;color:var(--forest-800);background:var(--forest-100);font-size:1.25rem;font-weight:900}.upload-field label{display:block;margin-bottom:.15rem}.upload-field p{margin:0;color:var(--ink-500);font-size:.8rem}.upload-field input{min-height:auto;padding:.45rem;font-size:.82rem;background:white}
  .review-panel{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem 2rem;align-items:center;padding:clamp(1.6rem,4vw,2.4rem);border-radius:20px;color:white;background:linear-gradient(135deg,var(--forest-950),var(--forest-800));box-shadow:0 22px 55px rgba(16,45,37,.18)}.review-copy h3{margin-bottom:.5rem;color:white;font-size:clamp(1.6rem,3vw,2.1rem)}.review-copy p{max-width:620px;margin-bottom:0;color:rgba(255,255,255,.72)}.review-copy .eyebrow{margin-bottom:.45rem;color:#e5c28e}.submit-actions{display:flex;flex-wrap:wrap;gap:.75rem}.clear-button{min-height:48px;padding:.7rem 1rem;border:0;color:rgba(255,255,255,.75);background:transparent;font-weight:750;text-decoration:underline;text-underline-offset:4px}.review-panel .form-status{grid-column:1/-1;margin:0;color:#fff0bf}.review-panel .form-status[data-state="error"]{color:#ffd1cc}
  @media(max-width:950px){.hero-grid{grid-template-columns:1fr;gap:2.5rem}.prep-card{max-width:620px}.form-layout{grid-template-columns:1fr}.form-rail{position:static;display:none}.choice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.preview-hero{padding-block:2.5rem 4rem}.hero-meta{gap:.7rem 1.2rem}.form-intro,.form-grid,.date-grid,.review-panel{grid-template-columns:1fr}.form-intro{gap:.6rem}.choice-grid{grid-template-columns:1fr}.section-copy{margin-left:0}.upload-field{grid-template-columns:auto 1fr}.upload-field input{grid-column:1/-1;width:100%}.submit-actions{align-items:stretch;flex-direction:column}.submit-actions .button{width:100%}}
  @media(prefers-reduced-motion:reduce){.progress-track span,.form-rail nav a,.choice-card{transition:none}}
</style>
