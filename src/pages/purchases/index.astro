---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormPageActions from "../../components/FormPageActions.astro";
import RentalOverview from "../../components/RentalOverview.astro";

const buyFormHref = "/request/?form=purchases#request-form";
---

<BaseLayout
  title="Buy a Sukkah"
  description="Explore the BK Sukkah purchase package and available tarp directions before starting a request."
  bodyClass="purchases-page"
>
  <section class="request-hero sukkah-hero-background">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Buy</span>
      </nav>
      <div class="request-hero-copy">
        <p class="eyebrow">BUY</p>
        <h1>Find a sukkah to keep.</h1>
        <p class="lead">Explore the package, browse tarp directions, and then share your space when you are ready.</p>
        <FormPageActions
          primaryLabel="Start a buy request"
          primaryHref={buyFormHref}
          secondaryLabel="See sukkah options"
          secondaryHref="#buy-overview"
          ariaLabel="Buy request actions"
        />
      </div>
    </div>
  </section>

  <RentalOverview variant="buy" formHref={buyFormHref} />
</BaseLayout>

<style>
  .request-hero { padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); }
  .request-hero-copy { width: min(100%, 880px); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: center; }
  .request-hero-copy .eyebrow { justify-content: center; margin-bottom: .8rem; }
  .request-hero h1 { max-width: 850px; margin: 0 auto 1rem; font-size: clamp(3.15rem, 6vw, 5rem); line-height: 1; }
  .request-hero .lead { max-width: 700px; margin: 0 auto; }
  @media (max-width: 700px) {
    .request-hero { padding-block: 1.35rem 2.5rem; }
    .request-hero-copy { margin-top: 2rem; }
    .request-hero h1 { font-size: clamp(2.55rem, 12vw, 3.7rem); }
  }
</style>
