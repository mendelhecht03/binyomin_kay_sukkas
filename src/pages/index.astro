  .testimonial-story-card {
    width: 100%;
    min-width: 0;
    display: grid;
    align-content: start;
    padding: clamp(1.45rem, 3.3vw, 2.4rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-large);
    background: var(--forest-100);
    box-shadow: 0 18px 42px rgba(16, 45, 37, 0.08);
  }

  .testimonial-story-card-preview {
    border-style: dashed;
    background: var(--cream-50);
    box-shadow: none;
  }

  .testimonial-preview-label {
    display: inline-flex;
    margin-bottom: 1.2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(200, 134, 67, 0.45);
    border-radius: 999px;
    color: var(--wood-700);
    background: #fffaf2;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .testimonial-preview-copy {
    max-width: 25ch;
    margin: 0;
    color: var(--forest-900);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2.7vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.28;
  }

  .testimonial-story-card blockquote {
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .testimonial-story-card-approved {
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
  }

  .testimonial-story-card-approved > blockquote,
  .testimonial-story-card-approved > footer {
    min-width: 0;
    max-width: none;
  }

  .testimonial-story > summary {
    display: grid;
    gap: 0.9rem;
    cursor: pointer;
    list-style: none;
  }

  .testimonial-story > summary::before,
  .testimonial-story-full::before {
    display: block;
    height: 1.2rem;
    content: "“";
    color: var(--wood-500);
    font-family: var(--font-heading);
    font-size: 3.4rem;
    line-height: 0.75;
  }

  .testimonial-story-preview {
    max-width: 28ch;
    color: var(--forest-950);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2.7vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.28;
  }

