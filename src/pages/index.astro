---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="BK Sukkah"
  description="Plan a new sukkah, arrange seasonal service, or request a rental from BK Sukkah."
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-heading">
      <img
        class="home-hero-image"
        src="/assets/images/home-hero-decorated-sukkah.jpg"
        alt="A finished sukkah prepared with schach, greenery, lighting and a set table"
        width="1800"
        height="1350"
        loading="eager"
        fetchpriority="high"
      />
      <div class="home-hero-shade" aria-hidden="true"></div>
      <div class="home-hero-inner shell">
        <div class="home-hero-copy">
          <p class="home-kicker">Sukkah season, made simpler</p>
          <h1 id="home-hero-heading">
            <span>Enjoy your Sukkos,</span>
            <strong>hassle free.</strong>
          </h1>
          <p class="home-hero-lead">
            BK Sukkah works with your space, your sukkah, and the practical details needed to get it ready for Yom Tov.
          </p>
          <div class="home-hero-actions">
            <a class="button hero-primary-action" href="#services">Choose a service</a>
            <a class="hero-call-action" href="tel:+13474542282">
              <span>Call BK Sukkah</span>
              <strong>(347) 454-2282</strong>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="home-section home-services" aria-labelledby="services-heading">
      <div class="shell">
        <div class="home-heading" data-reveal>
          <h2 id="services-heading">How can we help?</h2>
          <p>Choose the option below that matches your sukkah needs</p>
        </div>

        <nav class="service-choices" aria-label="Choose a sukkah service">
          <a class="service-choice service-choice-service" href="/sukka-builder/" data-reveal>
            <figure class="service-choice-media">
              <img
                src="/assets/images/home-schach-preparation.jpg"
                alt="A team member preparing bamboo schach for a sukkah"
                width="1200"
                height="2133"
                loading="lazy"
              />
            </figure>
            <div class="service-choice-copy">
              <span class="service-choice-type">Build</span>
              <h3>Need a hand building your sukkah?</h3>
              <p>Get help with setup, assembly, takedown, and more.</p>
              <span class="service-choice-link">Open Builds</span>
            </div>
          </a>

          <a class="service-choice service-choice-rent" href="/sukkah-rentals/" data-reveal>
            <figure class="service-choice-media">
              <img src="/assets/images/home-rental-schach.jpg" alt="Bamboo schach covering the roof of a sukkah" width="1200" height="1598" loading="lazy" />
            </figure>
            <div class="service-choice-copy">
              <span class="service-choice-type">Rent</span>
              <h3>Reserve your sukkah today</h3>
              <p>Tell us when and where, and we’ll help with the rest.</p>
              <span class="service-choice-link">View rentals</span>
            </div>
          </a>

          <a class="service-choice service-choice-purchase" href="/purchases/" data-reveal>
            <figure class="service-choice-media">
              <img src="/assets/images/custom-white-tarp-enhanced.jpg" alt="Standard sukkah with clean white tarp walls" width="1086" height="1448" loading="lazy" />
            </figure>
            <div class="service-choice-copy">
              <span class="service-choice-type">Buy</span>
              <h3>Find a sukkah to buy</h3>
              <p>Choose a practical sukkah with standard tarp walls and a straightforward setup.</p>
              <span class="service-choice-link">Explore Buy</span>
            </div>
          </a>

          <a class="service-choice service-choice-custom" href="/custom-sukkahs/" data-reveal>
            <figure class="service-choice-media">
              <img src="/assets/images/home-craftsmanship.jpg" alt="A team member cutting lumber for a custom sukkah build" width="1200" height="2133" loading="lazy" />
            </figure>
            <div class="service-choice-copy">
              <span class="service-choice-type">Custom</span>
              <h3>Design a new sukkah</h3>
              <p>Explore a sukkah designed around your space, materials and needs.</p>
              <span class="service-choice-link">Explore custom sukkahs</span>
            </div>
          </a>

          <a class="service-choice service-choice-pergola" href="/pergolas/" data-reveal>
            <figure class="service-choice-media">
              <img src="/assets/images/custom-soft-fabric.jpg" alt="Cloth-screen outdoor structure in a front yard" width="1600" height="900" loading="lazy" />
            </figure>
            <div class="service-choice-copy">
              <span class="service-choice-type">Pergolas</span>
              <h3>Create an outdoor space</h3>
              <p>Plan a freestanding or attached pergola around the way you use your yard.</p>
              <span class="service-choice-link">Explore pergolas</span>
            </div>
          </a>
        </nav>
      </div>
    </section>

    <section class="home-section home-process" aria-labelledby="process-heading">
      <div class="shell">
        <div class="home-heading home-heading-wide" data-reveal>
          <h2 id="process-heading">From start to finish.</h2>
          <p>BK Sukkah will handle every step of the building process</p>
        </div>

        <p class="process-swipe-hint" aria-hidden="true">Swipe to see more <span>→</span></p>

        <div class="process-gallery">
          <figure class="process-moment process-moment-plan" data-reveal>
            <img
              src="/assets/images/home-process-planning.jpg"
              alt="A team member assessing a sukkah space before setup"
              width="1200"
              height="2133"
              loading="lazy"
            />
            <figcaption>
              <h3>Plan for the space</h3>
              <p>We’ll come by, take a look at the area, and figure out what will work best.</p>
            </figcaption>
          </figure>

          <figure class="process-moment process-moment-build" data-reveal>
            <img
              src="/assets/images/home-craftsmanship.jpg"
              alt="Lumber being cut carefully during a sukkah build"
              width="1200"
              height="2133"
              loading="lazy"
            />
            <figcaption>
              <h3>Build with care</h3>
              <p>Materials are prepared and fitted to the practical needs of the site.</p>
            </figcaption>
          </figure>

          <figure class="process-moment process-moment-finish" data-reveal>
            <img
              src="/assets/images/home-process-finished.jpg"
              alt="A finished sukkah interior with schach and string lights"
              width="1024"
              height="576"
              loading="lazy"
            />
            <figcaption>
              <h3>Finish the details</h3>
              <p>Setup, schach and takedown are coordinated so you know what to expect.</p>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="home-section home-owner" aria-labelledby="owner-heading">
      <div class="owner-layout shell">
        <figure class="owner-photo" data-reveal>
          <img
            src="/assets/images/profile-photo1.jpg"
            alt="Benyamin smiling while running in a community race"
            width="1448"
            height="1086"
            loading="lazy"
          />
        </figure>

        <div class="owner-copy" data-reveal>
          <span class="owner-label">Meet your builder</span>
          <h2 id="owner-heading">Personal service, clear communication.</h2>
          <p>
            Benyamin works directly with families and pays attention to the practical details of each space. The goal is to make the sukkah part of Yom Tov preparation straightforward.
          </p>
          <p>
            From the first conversation through the final takedown, you will know what is happening and what comes next.
          </p>
          <a class="home-text-link" href="/about/">More about Benyamin</a>
        </div>
      </div>
    </section>

    <section class="home-section home-testimonials" aria-labelledby="testimonials-heading">
      <div class="testimonial-layout shell">
        <div class="testimonial-heading" data-reveal>
          <span class="testimonial-label">Testimonials</span>
          <h2 id="testimonials-heading">What customers say.</h2>
          <p>Read a customer story or share your own experience for possible publication.</p>

          <details class="testimonial-submit" data-testimonial-disclosure>
            <summary>
              <span>
                <strong>Share your experience</strong>
                <small>It takes about two minutes.</small>
              </span>
            </summary>

            <form
              class="testimonial-form"
              action="/api/testimonial-submissions"
              method="post"
              data-testimonial-form
            >
              <div class="testimonial-honeypot" aria-hidden="true">
                <label for="testimonial-website">Website</label>
                <input id="testimonial-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="testimonial-form-fields">
                <p class="testimonial-form-note">
                  Submissions go to a private review queue. They are never published automatically.
                </p>

                <div class="testimonial-field-grid">
                  <div class="testimonial-field">
                    <label for="testimonial-name">
                      Your name <span class="testimonial-required" aria-hidden="true">*</span>
                    </label>
                    <input id="testimonial-name" name="reviewerName" type="text" autocomplete="name" required />
                  </div>

                  <div class="testimonial-field">
                    <label for="testimonial-organization">Organization <span>(optional)</span></label>
                    <input id="testimonial-organization" name="reviewerOrganization" type="text" autocomplete="organization" />
                  </div>
                </div>

                <div class="testimonial-field">
                  <label for="testimonial-contact">
                    Email or phone for verification <span class="testimonial-required" aria-hidden="true">*</span>
                  </label>
                  <input id="testimonial-contact" name="reviewerContact" type="text" autocomplete="email" required />
                </div>

                <div class="testimonial-field">
                  <label for="testimonial-message">
                    Your testimonial <span class="testimonial-required" aria-hidden="true">*</span>
                  </label>
                  <textarea id="testimonial-message" name="testimonial" rows="4" minlength="20" required></textarea>
                </div>

                <label class="testimonial-consent" for="testimonial-consent">
                  <input id="testimonial-consent" name="publicationConsent" type="checkbox" value="yes" required />
                  <span>
                    I consent to being contacted to verify this testimonial and to its publication with my name and organization after review. I understand that submission does not guarantee publication.
                  </span>
                </label>

                <button class="button testimonial-submit-button" type="submit">Send testimonial</button>
                <p class="testimonial-form-status" data-testimonial-status role="status" aria-live="polite"></p>
              </div>

              <div class="testimonial-form-success" data-testimonial-success role="status" tabindex="-1" hidden>
                <strong>Thank you for sharing.</strong>
                <p>Your testimonial was sent for review. It will not appear on the website automatically.</p>
              </div>
            </form>
          </details>
        </div>

        <div class="testimonial-stories">
          <div class="testimonial-scroller-toolbar">
            <span>Customer stories</span>
            <span class="testimonial-scroller-hint" aria-hidden="true">
              <span class="testimonial-hint-arrow">→</span>
              <span>More stories</span>
            </span>
            <div class="testimonial-scroller-controls" aria-label="Testimonial controls">
              <span class="testimonial-slide-position" data-testimonial-position aria-live="polite">1 of 1</span>
              <button class="testimonial-scroll-button" type="button" data-testimonial-scroll="prev" aria-label="Previous testimonial" disabled>←</button>
              <button class="testimonial-scroll-button" type="button" data-testimonial-scroll="next" aria-label="Next testimonial" disabled>→</button>
            </div>
          </div>

          <div
            class="testimonial-carousel"
            data-testimonial-carousel
            role="region"
            aria-roledescription="carousel"
            aria-label="Customer testimonials"
            tabindex="0"
          >
            <div class="testimonial-carousel-viewport">
              <div class="testimonial-story-track" data-testimonial-track>
              <article class="testimonial-story-card" data-testimonial-slide data-reveal aria-roledescription="slide" aria-label="1 of 1">
            <blockquote>
              <details class="testimonial-story">
                <summary>
                  <span class="testimonial-story-preview">
                    “Without hesitation, Binyamin came out literally in the middle of the night to rebuild it.”
                  </span>
                  <span class="testimonial-story-toggle testimonial-story-toggle-closed">Read the full testimonial</span>
                  <span class="testimonial-story-toggle testimonial-story-toggle-open">Close the full testimonial</span>
                </summary>

                <div class="testimonial-story-full">
                  <p>
                    I’ve known Binyamin for years, but seeing the way he takes care of his customers gave me an even greater appreciation for who he is.
                  </p>
                  <p>
                    In the middle of Sukkos, our entire sukkah unexpectedly came crashing down. We were devastated, thinking our Yom Tov was ruined. Without hesitation, Binyamin came out literally in the middle of the night to rebuild it. Then, just half an hour before Shemini Atzeres, he came back again to make sure everything was secure so our family could enjoy Yom Tov in our sukkah.
                  </p>
                  <p>
                    That level of dedication, responsibility, and genuine care is incredibly rare. He doesn’t just build sukkahs—he stands behind his work and truly cares about the families he serves. His professionalism, efficiency, and exceptional customer service turned a stressful situation into one we’ll always remember with gratitude.
                  </p>
                  <p>
                    We’re incredibly thankful and recommend Binyamin and his team wholeheartedly. If you’re looking for someone you can trust completely, you won’t find anyone better.”
                  </p>
                </div>
              </details>
            </blockquote>
            <footer>
              <cite>Friendship Circle Brooklyn, Berel Majesky</cite>
              </footer>
              </article>

              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-cta" aria-labelledby="home-cta-heading">
      <div class="home-cta-layout shell" data-reveal>
        <div>
          <h2 id="home-cta-heading">Tell us what you are planning.</h2>
          <p>Share your space, timing and service needs. We will help you choose the right next step.</p>
        </div>
        <div class="home-cta-actions">
          <a class="button" href="/contact/">Request a Quote</a>
          <a class="home-cta-phone" href="tel:+13474542282">
            <span>Or call directly</span>
            <strong>(347) 454-2282</strong>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.documentElement.classList.add("motion-ready");

  const revealItems = document.querySelectorAll("[data-reveal]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reducedMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -10%", threshold: 0.12 },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  }

  const testimonialForm = document.querySelector("[data-testimonial-form]");

  const testimonialCarousel = document.querySelector("[data-testimonial-carousel]");
  const testimonialViewport = testimonialCarousel?.querySelector(".testimonial-carousel-viewport");
  const testimonialTrack = document.querySelector("[data-testimonial-track]");
  const testimonialScrollButtons = document.querySelectorAll("[data-testimonial-scroll]");
  const testimonialPosition = document.querySelector("[data-testimonial-position]");

  async function addApprovedTestimonials() {
    if (!(testimonialTrack instanceof HTMLElement)) return;
    try {
      const response = await fetch("/api/testimonials", { headers: { Accept: "application/json" } });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true || !Array.isArray(result.testimonials)) return;
      result.testimonials.forEach((testimonial) => {
        if (!testimonial?.testimonial || !testimonial?.name) return;
        const article = document.createElement("article");
        article.className = "testimonial-story-card testimonial-story-card-approved";
        article.dataset.testimonialSlide = "";
        article.setAttribute("aria-roledescription", "slide");

        const blockquote = document.createElement("blockquote");
        const copy = document.createElement("p");
        copy.className = "testimonial-approved-copy";
        copy.textContent = `“${testimonial.testimonial}”`;
        blockquote.append(copy);

        const footer = document.createElement("footer");
        const citation = document.createElement("cite");
        citation.textContent = [testimonial.organization, testimonial.name].filter(Boolean).join(", ");
        footer.append(citation);
        article.append(blockquote, footer);
        testimonialTrack.append(article);
      });
    } catch {
      // The approved customer story already in the page remains available.
    }
  }

  async function initializeTestimonialCarousel() {
    await addApprovedTestimonials();
    const testimonialSlides = Array.from(document.querySelectorAll("[data-testimonial-slide]"));
    if (!(testimonialCarousel instanceof HTMLElement) || !(testimonialTrack instanceof HTMLElement) || testimonialSlides.length === 0) return;
    testimonialSlides.forEach((slide, index) => slide.setAttribute("aria-label", `${index + 1} of ${testimonialSlides.length}`));
    const scrollerHint = document.querySelector(".testimonial-scroller-hint");
    const getVisibleCount = () => Math.min(window.matchMedia("(min-width: 761px)").matches ? 2 : 1, testimonialSlides.length);
    let visibleCount = getVisibleCount();
    let activeTestimonial = 0;
    testimonialCarousel.dataset.visibleCount = String(visibleCount);

    const maxStartIndex = () => Math.max(0, testimonialSlides.length - visibleCount);

    const sizeTestimonialViewport = () => {
      const visibleSlides = testimonialSlides.slice(activeTestimonial, activeTestimonial + visibleCount);
      const tallestSlide = visibleSlides.reduce((height, slide) => {
        return slide instanceof HTMLElement ? Math.max(height, slide.offsetHeight) : height;
      }, 0);
      if (testimonialViewport instanceof HTMLElement && tallestSlide > 0) {
        testimonialViewport.style.height = `${tallestSlide}px`;
      }
    };

    const updateTrackPosition = () => {
      const firstSlide = testimonialSlides[0];
      if (!(firstSlide instanceof HTMLElement)) return;
      const trackStyles = getComputedStyle(testimonialTrack);
      const gap = parseFloat(trackStyles.columnGap || trackStyles.gap || "0") || 0;
      const distance = firstSlide.getBoundingClientRect().width + gap;
      testimonialTrack.style.transform = `translate3d(-${activeTestimonial * distance}px, 0, 0)`;
    };

    if ("ResizeObserver" in window) {
      const slideSizeObserver = new ResizeObserver(sizeTestimonialViewport);
      testimonialSlides.forEach((slide) => slideSizeObserver.observe(slide));
    }

    const showTestimonial = (nextIndex, shouldFocus = false) => {
      activeTestimonial = Math.max(0, Math.min(nextIndex, maxStartIndex()));
      updateTrackPosition();

      testimonialSlides.forEach((slide, index) => {
        const isActive = index >= activeTestimonial && index < activeTestimonial + visibleCount;
        slide.toggleAttribute("aria-hidden", !isActive);
        slide.toggleAttribute("inert", !isActive);
        slide.toggleAttribute("data-active", isActive);
        if (!isActive) slide.querySelector("details")?.removeAttribute("open");
      });

      testimonialScrollButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.disabled = button.dataset.testimonialScroll === "prev"
          ? activeTestimonial === 0
          : activeTestimonial === maxStartIndex();
      });

      if (testimonialPosition instanceof HTMLElement) {
        const lastVisible = Math.min(activeTestimonial + visibleCount, testimonialSlides.length);
        testimonialPosition.textContent = visibleCount > 1
          ? `${activeTestimonial + 1}–${lastVisible} of ${testimonialSlides.length}`
          : `${activeTestimonial + 1} of ${testimonialSlides.length}`;
      }

      requestAnimationFrame(sizeTestimonialViewport);

      if (shouldFocus) testimonialCarousel.focus({ preventScroll: true });
    };

    testimonialScrollButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement)) return;
        const direction = button.dataset.testimonialScroll === "prev" ? -1 : 1;
        showTestimonial(activeTestimonial + direction);
      });
    });

    testimonialCarousel.addEventListener("keydown", (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      const keyTargets = {
        ArrowLeft: activeTestimonial - 1,
        ArrowRight: activeTestimonial + 1,
        Home: 0,
        End: maxStartIndex(),
      };
      if (!(event.key in keyTargets)) return;
      event.preventDefault();
      showTestimonial(keyTargets[event.key], true);
    });

    window.addEventListener("resize", () => {
      const nextVisibleCount = getVisibleCount();
      if (nextVisibleCount !== visibleCount) {
        visibleCount = nextVisibleCount;
        testimonialCarousel.dataset.visibleCount = String(visibleCount);
        activeTestimonial = Math.min(activeTestimonial, maxStartIndex());
        showTestimonial(activeTestimonial);
      } else {
        updateTrackPosition();
        sizeTestimonialViewport();
      }
      if (scrollerHint instanceof HTMLElement) scrollerHint.hidden = testimonialSlides.length <= visibleCount;
    });

    if (scrollerHint instanceof HTMLElement) scrollerHint.hidden = testimonialSlides.length <= visibleCount;
    showTestimonial(0);
  }
  initializeTestimonialCarousel();

  testimonialForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!(testimonialForm instanceof HTMLFormElement) || !testimonialForm.reportValidity()) return;

    const submitButton = testimonialForm.querySelector("button[type='submit']");
    const submitStatus = testimonialForm.querySelector("[data-testimonial-status]");
    const successMessage = testimonialForm.querySelector("[data-testimonial-success]");

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
      submitButton.textContent = "Sending...";
    }
    if (submitStatus instanceof HTMLElement) {
      submitStatus.dataset.state = "working";
      submitStatus.textContent = "Sending your testimonial for review...";
    }

    try {
      const response = await fetch(testimonialForm.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(testimonialForm),
      });
      const result = await response.json().catch(() => null);

      if (!response.ok || result?.ok !== true) {
        throw new Error(result?.message || "We could not send your testimonial.");
      }

      testimonialForm.reset();
      testimonialForm.dataset.state = "success";
      if (submitStatus instanceof HTMLElement) submitStatus.textContent = "";
      if (successMessage instanceof HTMLElement) {
        successMessage.hidden = false;
        successMessage.focus({ preventScroll: true });
      }
    } catch (error) {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        submitButton.textContent = "Try again";
      }
      if (submitStatus instanceof HTMLElement) {
        submitStatus.dataset.state = "error";
        submitStatus.textContent = error instanceof Error
          ? error.message
          : "We could not send your testimonial. Please try again or call (347) 454-2282.";
      }
    }
  });
</script>

<style>
  .home-page {
    overflow: clip;
    background: var(--cream-50);
  }

  .home-page h1,
  .home-page h2,
  .home-page h3 {
    font-family: var(--font-heading);
  }

  .home-hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    isolation: isolate;
    overflow: hidden;
    color: var(--cream-50);
    background: var(--forest-950);
  }

  .home-hero-image,
  .home-hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero-image {
    z-index: -2;
    object-fit: cover;
    object-position: 58% center;
    animation: hero-image-enter 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .home-hero-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 31, 25, 0.92) 0%, rgba(10, 31, 25, 0.78) 38%, rgba(10, 31, 25, 0.24) 72%, rgba(10, 31, 25, 0.2) 100%),
      linear-gradient(0deg, rgba(10, 31, 25, 0.35), transparent 50%);
  }

  .home-hero-inner {
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding-block: 6rem 3.5rem;
  }

  .home-hero-copy {
    max-width: 640px;
    animation: hero-copy-enter 900ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .home-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.82);
