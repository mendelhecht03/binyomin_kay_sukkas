    width: 38px;
    height: 2px;
    content: "";
    background: #e4ad72;
  }

  .home-hero h1 {
    max-width: 12ch;
    margin-bottom: 1.35rem;
    color: var(--cream-50);
    font-size: clamp(3.3rem, 6.6vw, 6.35rem);
    font-weight: 700;
    letter-spacing: -0.052em;
    line-height: 0.96;
    text-shadow: 0 2px 28px rgba(5, 22, 17, 0.28);
  }

  .home-hero h1 span,
  .home-hero h1 strong {
    display: block;
  }

  .home-hero h1 strong {
    color: #f0c38f;
    font: inherit;
  }

  .home-hero-lead {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.08rem, 1.7vw, 1.24rem);
    line-height: 1.55;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.4rem;
    align-items: center;
  }

  .hero-primary-action {
    min-width: 170px;
    border-color: var(--cream-50);
    color: var(--forest-950);
    background: var(--cream-50);
    box-shadow: 0 14px 38px rgba(7, 27, 21, 0.22);
  }

  .hero-primary-action:hover {
    border-color: white;
    color: var(--forest-950);
    background: white;
  }

  .hero-call-action {
    min-height: 50px;
    display: grid;
    align-content: center;
    padding: 0.3rem 0;
    color: white;
    line-height: 1.25;
    text-decoration: none;
  }

  .hero-call-action span {
    color: rgba(255, 255, 255, 0.67);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-call-action strong {
    color: white;
    font-size: 1.03rem;
    letter-spacing: 0.015em;
  }

  .hero-call-action strong::after {
    display: inline-block;
    margin-left: 0.45rem;
    content: "↗";
    color: #f0c38f;
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-call-action:hover strong::after,
  .hero-call-action:focus-visible strong::after {
    transform: translate(2px, -2px);
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-image-enter {
    from {
      opacity: 0.72;
      transform: scale(1.035);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .home-section {
    padding-block: clamp(5.5rem, 10vw, 9rem);
  }

  .home-heading {
    max-width: 700px;
    margin-bottom: clamp(2.5rem, 5vw, 4.25rem);
  }

  .home-heading h2,
  .owner-copy h2,
  .home-cta h2 {
    margin-bottom: 1rem;
    font-size: clamp(2.35rem, 4.8vw, 4.35rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .home-heading p,
  .home-cta p {
    max-width: 58ch;
    margin-bottom: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.14rem);
    line-height: 1.65;
  }

  .home-services {
    background: var(--cream-50);
  }

  .service-choices {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    grid-template-areas:
      "build custom"
      "rent custom"
      "buy pergola";
    grid-template-rows: repeat(3, minmax(300px, auto));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .service-choice {
    min-width: 0;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    color: var(--forest-950);
    background: var(--white);
    text-decoration: none;
    transition: border-color 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms ease;
  }

  .service-choice:hover,
  .service-choice:focus-visible {
    border-color: var(--border-strong);
    box-shadow: 0 20px 48px rgba(16, 45, 37, 0.1);
    transform: translateY(-4px);
  }

  .service-choice-service {
    grid-area: build;
  }

  .service-choice-rent {
    grid-area: rent;
  }

  .service-choice-purchase {
    grid-area: buy;
  }

  .service-choice-custom {
    grid-area: custom;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .service-choice-pergola {
    grid-area: pergola;
  }

  .service-choice-rent,
  .service-choice-service,
  .service-choice-purchase,
  .service-choice-pergola {
    grid-template-columns: minmax(170px, 0.8fr) minmax(0, 1.2fr);
  }

  .service-choice-media {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: var(--forest-100);
  }

  .service-choice-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-choice-custom .service-choice-media {
    min-height: 440px;
  }

  .service-choice-custom .service-choice-media img {
    object-position: center 54%;
  }

  .service-choice-rent .service-choice-media img {
    object-position: 44% center;
  }

  .service-choice-service .service-choice-media img {
    object-position: center 48%;
  }

  .service-choice-purchase .service-choice-media img {
    object-position: center 52%;
  }

  .service-choice-pergola .service-choice-media img {
    object-position: center 48%;
  }

  .service-choice:hover .service-choice-media img,
  .service-choice:focus-visible .service-choice-media img {
    transform: scale(1.035);
  }

  .service-choice-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 3vw, 2.35rem);
  }

  .service-choice-type {
    margin-bottom: 0.65rem;
    color: var(--wood-600);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .service-choice h3 {
    margin-bottom: 0.7rem;
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .service-choice p {
    max-width: 34ch;
    margin-bottom: 1.25rem;
    line-height: 1.55;
  }

  .service-choice-link,
  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--forest-800);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
  }

  .service-choice-link::after,
  .home-text-link::after {
    display: inline-block;
    content: "→";
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-choice:hover .service-choice-link,
  .service-choice:focus-visible .service-choice-link,
  .home-text-link:hover,
  .home-text-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .service-choice:hover .service-choice-link::after,
  .service-choice:focus-visible .service-choice-link::after,
  .home-text-link:hover::after,
  .home-text-link:focus-visible::after {
    transform: translateX(4px);
  }

  .home-process {
    border-block: 1px solid var(--border);
    background: var(--cream-100);
  }

  .home-heading-wide {
    max-width: 780px;
  }

  .process-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.72fr) minmax(0, 0.9fr);
    gap: clamp(1rem, 2.4vw, 2rem);
    align-items: start;
  }

  .process-swipe-hint {
    display: none;
  }

  .process-moment {
    min-width: 0;
    margin: 0;
  }

  .process-moment img {
    width: 100%;
    border-radius: var(--radius-large);
    background: var(--forest-100);
    object-fit: cover;
  }

  .process-moment-plan img {
    aspect-ratio: 1.18 / 1;
    object-position: center 46%;
  }

  .process-moment-build {
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .process-moment-build img {
    aspect-ratio: 4 / 5;
    object-position: center 45%;
  }

  .process-moment-finish {
    padding-top: clamp(1rem, 3vw, 2.4rem);
  }

  .process-moment-finish img {
    aspect-ratio: 5 / 6;
    object-position: center;
  }

  .process-moment figcaption {
    padding: 1.25rem 0.25rem 0;
  }

  .process-moment h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }

  .process-moment p {
    max-width: 34ch;
    margin-bottom: 0;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .home-owner {
    background: var(--cream-50);
  }

  .owner-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .owner-photo {
    position: relative;
    margin: 0;
  }

  .owner-photo::after {
    position: absolute;
    right: -1.2rem;
    bottom: -1.2rem;
    width: 38%;
    height: 42%;
    z-index: -1;
    border-radius: var(--radius-large);
    content: "";
    background: var(--forest-100);
  }

  .owner-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-large);
    box-shadow: 0 24px 54px rgba(16, 45, 37, 0.12);
    object-fit: cover;
    object-position: center 48%;
  }

  .owner-copy {
    max-width: 540px;
  }

  .owner-label {
    display: block;
    margin-bottom: 1rem;
    color: var(--wood-600);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .owner-copy h2 {
    font-size: clamp(2.35rem, 4.5vw, 4rem);
  }

  .owner-copy p {
    max-width: 51ch;
    margin-bottom: 1rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .owner-copy .home-text-link {
    margin-top: 0.5rem;
  }

  .home-testimonials {
    border-top: 1px solid var(--border);
    background: var(--cream-100);
  }

  .testimonial-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .testimonial-heading {
    max-width: 430px;
  }

  .testimonial-label {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--wood-600);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .testimonial-heading h2 {
    margin-bottom: 1rem;
    font-size: clamp(2.35rem, 4.6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .testimonial-heading p {
    max-width: 38ch;
    margin-bottom: 0;
    line-height: 1.65;
  }

  .testimonial-submit {
    margin-top: 1.6rem;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-large);
    background: rgba(255, 255, 255, 0.62);
  }

  .testimonial-submit > summary {
    min-height: 72px;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    color: var(--forest-950);
    cursor: pointer;
    list-style: none;
    transition: background-color 180ms ease;
  }

  .testimonial-submit > summary::-webkit-details-marker,
  .testimonial-story > summary::-webkit-details-marker {
    display: none;
  }

  .testimonial-submit > summary:hover,
  .testimonial-submit > summary:focus-visible {
    background: var(--forest-100);
  }

  .testimonial-submit > summary > span:first-child {
    display: grid;
    gap: 0.12rem;
  }

  .testimonial-submit > summary strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .testimonial-submit > summary small {
    color: var(--ink-500);
    font-size: 0.78rem;
  }

  .testimonial-submit > summary::after {
    width: 1.9rem;
    height: 1.9rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    content: "+";
    color: var(--forest-900);
    background: var(--forest-100);
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .testimonial-submit[open] > summary::after {
    transform: rotate(45deg);
  }

  .testimonial-form {
    position: relative;
    padding: 0 1rem 1rem;
  }

  .testimonial-honeypot {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }

  .testimonial-form-fields {
    display: grid;
    gap: 0.9rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    animation: testimonial-form-enter 280ms ease both;
  }

  .testimonial-form-note {
    margin: 0;
    color: var(--ink-700);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .testimonial-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .testimonial-field {
    min-width: 0;
    display: grid;
    gap: 0.3rem;
  }

  .testimonial-field label {
    color: var(--forest-950);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .testimonial-field label > span:not(.testimonial-required) {
    color: var(--ink-500);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .testimonial-required {
    color: #a72f22;
  }

  .testimonial-field input,
  .testimonial-field textarea {
    width: 100%;
    min-height: 42px;
    padding: 0.62rem 0.7rem;
    border: 1px solid rgba(29, 41, 37, 0.28);
    border-radius: var(--radius-small);
    color: var(--ink-800);
    background: rgba(255, 255, 255, 0.9);
    font: inherit;
    font-size: 0.9rem;
  }

  .testimonial-field textarea {
    min-height: 100px;
    resize: vertical;
    line-height: 1.5;
  }

  .testimonial-field input:focus,
  .testimonial-field textarea:focus {
    border-color: var(--forest-700);
    outline: 0;
    box-shadow: 0 0 0 4px rgba(45, 104, 85, 0.12);
  }

  .testimonial-consent {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
    color: var(--ink-700);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .testimonial-consent input {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    min-height: 1.05rem;
    margin: 0.12rem 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    accent-color: var(--forest-700);
  }

  .testimonial-submit-button {
    width: 100%;
    margin-top: 0.1rem;
  }

  .testimonial-submit-button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .testimonial-form-status {
    min-height: 1.25rem;
    margin: 0;
    color: var(--ink-500);
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
  }

  .testimonial-form-status[data-state="error"] {
    color: #982a20;
  }

  .testimonial-form[data-state="success"] .testimonial-form-fields {
    display: none;
  }

  .testimonial-form-success {
    margin-top: 1rem;
    padding: 1.2rem;
    border: 1px solid rgba(45, 104, 85, 0.28);
    border-radius: var(--radius-small);
    color: var(--forest-950);
    background: var(--forest-100);
    animation: testimonial-success-enter 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .testimonial-form-success[hidden] {
    display: none;
  }

  .testimonial-form-success strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
  }

  .testimonial-form-success p {
    margin: 0;
    color: var(--ink-700);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .testimonial-stories {
    min-width: 0;
  }

  .testimonial-scroller-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 0.95rem;
    color: var(--ink-500);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .testimonial-scroller-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline: auto 0;
    color: var(--ink-500);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
  }

  .testimonial-hint-arrow {
    display: inline-block;
    color: var(--wood-600);
    font-size: 1rem;
    line-height: 1;
  }

  .testimonial-scroller-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .testimonial-slide-position {
    min-width: 2.5rem;
    color: var(--ink-500);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-align: right;
  }

  .testimonial-scroll-button {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--forest-950);
    background: var(--cream-50);
    cursor: pointer;
    font-size: 1.15rem;
    line-height: 1;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .testimonial-scroll-button:hover:not(:disabled),
  .testimonial-scroll-button:focus-visible {
    border-color: var(--forest-700);
    color: var(--cream-50);
    background: var(--forest-800);
    transform: translateY(-1px);
  }

  .testimonial-scroll-button:disabled {
    cursor: default;
    opacity: 0.42;
  }

  .testimonial-carousel {
    min-width: 0;
    outline: 0;
  }

  .testimonial-carousel-viewport {
    overflow: hidden;
    border-radius: var(--radius-large);
    transition: height 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .testimonial-story-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    column-gap: 0;
    align-items: start;
    width: 100%;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 761px) {
    .testimonial-carousel[data-visible-count="2"] .testimonial-story-track {
      grid-auto-columns: calc((100% - 0.9rem) / 2);
      column-gap: 0.9rem;
    }
