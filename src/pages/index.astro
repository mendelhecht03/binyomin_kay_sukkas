---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Benyamin Kay Sukkas"
  description="Plan a new sukkah, arrange seasonal service, or request a rental from Benyamin Kay Sukkas."
>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-hero-grid shell">
        <div class="home-hero-copy">
          <h1>Your sukkah, handled.</h1>
          <p>Buying, renting, or preparing the sukkah you already own starts here.</p>
          <div class="home-hero-actions">
            <a class="button home-primary-action" href="#services">Choose a service</a>
            <a class="home-phone-link" href="tel:+13474542282">Call (347) 454-2282</a>
          </div>
        </div>

        <figure class="home-hero-photo">
          <img
            src="/assets/images/sukka-background.jpg"
            alt="Illustrative wooden sukkah with a schach roof beneath a blue sky"
          />
          <figcaption>Example sukkah style</figcaption>
        </figure>
      </div>
    </section>

    <section id="services" class="home-section home-services" aria-labelledby="services-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="services-heading">What do you need help with?</h2>
        </div>

        <nav class="service-paths" aria-label="Sukkah services">
          <a class="service-path" href="/sukka-builder/">
            <h3>Buy a sukkah</h3>
            <p>Plan a new sukkah and its installation around your space.</p>
            <span>Start planning</span>
          </a>
          <a class="service-path" href="/sukka-builder/">
            <h3>I already have a sukkah</h3>
            <p>Arrange storage, setup, takedown, or other seasonal work.</p>
            <span>Request service</span>
          </a>
          <a class="service-path" href="/sukkah-rentals/">
            <h3>Rent a sukkah</h3>
            <p>Share your dates, location, and the size you need.</p>
            <span>View rentals</span>
          </a>
        </nav>
      </div>
    </section>

    <section class="home-section testimonials-section" aria-labelledby="testimonials-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="testimonials-heading">What customers say</h2>
        </div>

        <div class="testimonial-grid">
          <article class="testimonial-card">
            <div class="testimonial-photo-placeholder" role="img" aria-label="Customer photo placeholder">
              <span>Customer photo</span>
            </div>
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will go here.</p>
              </blockquote>
              <p class="testimonial-name">Customer name</p>
            </div>
          </article>

          <article class="testimonial-card">
            <div class="testimonial-photo-placeholder" role="img" aria-label="Customer photo placeholder">
              <span>Customer photo</span>
            </div>
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will go here.</p>
              </blockquote>
              <p class="testimonial-name">Customer name</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section about-owner" aria-labelledby="owner-heading">
      <div class="about-owner-grid shell">
        <figure class="owner-photo">
          <img src="/assets/images/profile-photo1.jpg" alt="Benyamin Kay, owner of Benyamin Kay Sukkas" />
        </figure>
        <div class="owner-copy">
          <h2 id="owner-heading">Meet Benyamin</h2>
          <p>
            Benyamin Kay is the owner of Benyamin Kay Sukkas. His hands-on approach grew from helping families prepare their spaces for Sukkos.
          </p>
          <a class="owner-link" href="/about/">Read more about Benyamin</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    background: var(--cream-50);
  }

  .home-page h1,
  .home-page h2,
  .home-page h3 {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  }

  .home-hero {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(420px, 1.15fr);
    gap: clamp(3rem, 7vw, 6.5rem);
    align-items: center;
  }

  .home-hero-copy {
    max-width: 560px;
  }

  .home-hero-copy h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 6vw, 4.8rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .home-hero-copy > p {
    max-width: 35rem;
    margin-bottom: 2rem;
    color: var(--ink-700);
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    line-height: 1.6;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    align-items: center;
  }

  .home-primary-action {
    min-width: 156px;
    font-weight: 650;
    box-shadow: none;
  }

  .home-primary-action:hover {
    box-shadow: none;
    transform: translateY(-1px);
  }

  .home-primary-action:active {
    transform: translateY(1px);
  }

  .home-phone-link {
    color: var(--forest-900);
    font-size: 0.96rem;
    font-weight: 650;
    text-decoration-color: rgba(23, 63, 52, 0.32);
    text-underline-offset: 0.3em;
  }

  .home-phone-link:hover {
    text-decoration-color: currentColor;
  }

  .home-hero-photo {
    margin: 0;
  }

  .home-hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    object-fit: cover;
  }

  .home-hero-photo figcaption {
    margin-top: 0.65rem;
    color: var(--ink-500);
    font-size: 0.78rem;
    text-align: right;
  }

  .home-section {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--border);
  }

  .home-section-heading {
    max-width: 700px;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .home-section-heading h2,
  .owner-copy h2 {
    margin: 0;
    font-size: clamp(2.15rem, 4.5vw, 3.6rem);
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .service-paths {
    display: grid;
    border-bottom: 1px solid var(--border-strong);
  }

  .service-path {
    display: grid;
    grid-template-columns: minmax(210px, 0.8fr) minmax(280px, 1.2fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(1.6rem, 3vw, 2.3rem);
    border-top: 1px solid var(--border-strong);
    text-decoration: none;
  }

  .service-path h3,
  .service-path p {
    margin: 0;
  }

  .service-path h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 620;
    transition: color 150ms ease;
  }

  .service-path p {
    max-width: 42ch;
    color: var(--ink-700);
    font-size: 0.98rem;
  }

  .service-path span {
    color: var(--forest-800);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    white-space: nowrap;
    transition: text-decoration-color 150ms ease, transform 150ms ease;
  }

  .service-path:hover h3 {
    color: var(--forest-700);
  }

  .service-path:hover span {
    text-decoration-color: currentColor;
    transform: translateX(2px);
  }

  .service-path:active span {
    transform: translateX(0);
  }

  .testimonials-section {
    background: rgba(229, 238, 232, 0.34);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .testimonial-card {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 1.35rem;
    align-items: center;
    min-height: 184px;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
  }

  .testimonial-photo-placeholder {
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 12px;
    color: var(--forest-800);
    background: var(--forest-100);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .testimonial-copy blockquote {
    margin: 0;
  }

  .testimonial-copy blockquote p {
    margin-bottom: 1rem;
    color: var(--ink-900);
    font-size: 1rem;
    line-height: 1.55;
  }

  .testimonial-name {
    margin: 0;
    color: var(--forest-800);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .about-owner {
    padding-block: clamp(4.5rem, 8vw, 6.5rem);
  }

  .about-owner-grid {
    display: grid;
    grid-template-columns: minmax(190px, 260px) minmax(0, 560px);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    justify-content: center;
  }

  .owner-photo {
    margin: 0;
  }

  .owner-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    object-fit: cover;
  }

  .owner-copy h2 {
    margin-bottom: 1.25rem;
  }

  .owner-copy p {
    max-width: 52ch;
    margin-bottom: 1.35rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .owner-link {
    color: var(--forest-800);
    font-size: 0.92rem;
    font-weight: 700;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 900px) {
    .home-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }

    .home-hero-copy {
      max-width: 670px;
    }

    .home-hero-copy h1 {
      max-width: 12ch;
    }

    .home-hero-photo {
      max-width: 760px;
    }

    .service-path {
      grid-template-columns: minmax(200px, 0.8fr) minmax(0, 1.2fr);
    }

    .service-path span {
      grid-column: 2;
    }

    .testimonial-card {
      grid-template-columns: 108px minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      padding-block: 3.25rem 4.5rem;
    }

    .home-hero-copy h1 {
      max-width: 11ch;
      font-size: clamp(2.75rem, 13vw, 4rem);
      line-height: 1;
    }

    .home-hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-primary-action {
      width: 100%;
    }

    .home-section {
      padding-block: 4.75rem;
    }

    .service-path {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding-block: 1.6rem;
    }

    .service-path span {
      grid-column: 1;
      margin-top: 0.25rem;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card {
      grid-template-columns: 88px minmax(0, 1fr);
      min-height: 0;
      padding: 1rem;
    }

    .about-owner-grid {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    .owner-copy h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 460px) {
    .testimonial-card {
      grid-template-columns: 74px minmax(0, 1fr);
      gap: 1rem;
    }

    .testimonial-photo-placeholder {
      font-size: 0.62rem;
    }

    .about-owner-grid {
      grid-template-columns: 1fr;
    }

    .owner-photo {
      width: 128px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-primary-action,
    .service-path h3,
    .service-path span {
      transition: none;
    }
  }
</style>
