---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Benyamin Kay Sukkas"
  description="Plan a new sukkah, arrange seasonal service, or request a rental from Benyamin Kay Sukkas."
>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-hero-grid shell">
        <div class="home-hero-copy">
          <h1><span>Enjoy your Sukkos,</span> <strong>hassle free.</strong></h1>
          <p>From the first measurement to the final takedown, we make getting your sukkah ready feel simple.</p>
          <div class="home-hero-actions">
            <a class="button home-primary-action" href="#services">Choose a service</a>
            <a class="home-phone-link" href="tel:+13474542282">
              <span aria-hidden="true">Call</span>
              <strong>(347) 454-2282</strong>
              <small>Questions are welcome</small>
            </a>
          </div>
        </div>

        <figure class="home-hero-photo">
          <img
            src="/assets/images/home-hero-decorated-sukkah.jpg"
            alt="Decorated sukkah interior with a long set table beneath a schach roof"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section id="services" class="home-section home-services" aria-labelledby="services-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="services-heading">How can we help?</h2>
        </div>

        <nav class="service-paths" aria-label="Sukkah services">
          <a class="service-path" href="/sukka-builder/">
            <h3>Buy</h3>
            <p>Plan your new sukkah and its installation around your space.</p>
            <span>Start planning</span>
          </a>
          <a class="service-path" href="/sukkah-rentals/">
            <h3>Rent</h3>
            <p>Arrange initial setup, takedown, storage and other optional services.</p>
            <span>View rentals</span>
          </a>
          <a class="service-path" href="/sukka-builder/">
            <h3>Service</h3>
            <p>Share your dates, location, and the size you need.</p>
            <span>Request service</span>
          </a>
        </nav>
      </div>
    </section>

    <section class="home-section testimonials-section" aria-labelledby="testimonials-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="testimonials-heading">What customers say</h2>
        </div>

        <div class="testimonial-layout">
          <article class="testimonial-card testimonial-card-featured">
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will appear here.</p>
              </blockquote>
              <div class="testimonial-meta">
                <img src="/assets/images/sample-sukka1.jpg" alt="Completed sukkah prepared for a customer" loading="lazy" />
                <p class="testimonial-name">Customer name pending approval</p>
              </div>
            </div>
          </article>

          <article class="testimonial-card">
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will appear here.</p>
              </blockquote>
              <div class="testimonial-meta">
                <img src="/assets/images/sample-sukka2.jpg" alt="Sukkah installation completed at a family home" loading="lazy" />
                <p class="testimonial-name">Customer name pending approval</p>
              </div>
            </div>
          </article>

          <article class="testimonial-card">
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will appear here.</p>
              </blockquote>
              <div class="testimonial-meta">
                <img src="/assets/images/sample-sukka3.jpg" alt="Finished sukkah service project" loading="lazy" />
                <p class="testimonial-name">Customer name pending approval</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section about-owner" aria-labelledby="owner-heading">
      <div class="about-owner-grid shell">
        <figure class="owner-photo">
          <img src="/assets/images/profile-photo1.jpg" alt="Benyamin Kay, owner of Benyamin Kay Sukkas" />
        </figure>
        <div class="owner-copy">
          <h2 id="owner-heading">Meet Benyamin</h2>
          <p>
            Benyamin Kay is the owner of B.Kay Sukkahs. He knows that getting ready for Yom Tov already comes with a long list, so he tries to make the sukkah part straightforward. Benyamin works directly with each family, pays attention to the details of their space, and makes sure they know what to expect from setup through takedown.
          </p>
          <a class="owner-link" href="/about/">Read more about Benyamin</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    overflow: clip;
    background: var(--cream-50);
  }

  .home-page h1,
  .home-page h2,
  .home-page h3 {
    font-family: var(--font-heading);
  }

  .home-hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    background: var(--cream-100);
  }

  .home-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    gap: clamp(3.25rem, 7vw, 6.75rem);
    align-items: center;
  }

  .home-hero-copy {
    max-width: 560px;
    animation: hero-copy-enter 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .home-hero-copy::before {
    width: 54px;
    height: 4px;
    display: block;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    content: "";
    background: var(--wood-500);
  }

  .home-hero-copy h1 {
    max-width: 13ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 6vw, 5.3rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .home-hero-copy h1 span,
  .home-hero-copy h1 strong {
    display: block;
  }

  .home-hero-copy h1 strong {
    width: fit-content;
    padding-bottom: 0.08em;
    border-bottom: 0.1em solid rgba(200, 134, 67, 0.62);
    color: var(--forest-800);
    font: inherit;
  }

  .home-hero-copy > p {
    max-width: 35rem;
    margin-bottom: 2rem;
    color: var(--ink-700);
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    line-height: 1.6;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    align-items: center;
  }

  .home-primary-action {
    min-width: 148px;
    min-height: 40px;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 800;
    box-shadow: var(--shadow-small);
  }

  .home-primary-action:hover {
    box-shadow: var(--shadow-medium);
    transform: translateY(-1px);
  }

  .home-primary-action:active {
    transform: translateY(1px);
  }

  .home-phone-link {
    width: fit-content;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.6rem;
    color: var(--forest-900);
    text-decoration: none;
  }

  .home-phone-link > span {
    grid-row: 1 / 3;
    align-self: center;
    padding: 0.35rem 0.55rem;
    border-radius: 6px;
    color: var(--white);
    background: var(--wood-600);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-phone-link strong {
    color: var(--forest-900);
    line-height: 1.2;
  }

  .home-phone-link small {
    color: var(--ink-500);
    font-size: 0.78rem;
  }

  .home-hero-photo {
    position: relative;
    z-index: 0;
    margin: 0;
    padding: 0 0 1.15rem 1.15rem;
    animation: hero-photo-enter 900ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .home-hero-photo::before {
    position: absolute;
    z-index: -1;
    inset: 1.35rem -1.35rem 0 0;
    border-radius: var(--radius-large);
    content: "";
    background: var(--forest-900);
  }

  .home-hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(16, 45, 37, 0.12);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-medium);
    object-fit: cover;
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(28px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-photo-enter {
    from {
      opacity: 0;
      transform: translateX(34px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .home-section {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--border);
  }

  .home-section-heading {
    max-width: 700px;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .home-section-heading h2,
  .owner-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .home-services {
    background: var(--cream-50);
  }

  .home-services > .shell {
    display: grid;
    grid-template-columns: minmax(230px, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-services .home-section-heading {
    position: sticky;
    top: 7.5rem;
    margin: 0;
    padding-left: 1.5rem;
    border-left: 4px solid var(--wood-500);
  }

  .service-paths {
    display: grid;
    border-top: 1px solid var(--border-strong);
  }

  .service-path {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.82fr) minmax(230px, 1.18fr);
    gap: clamp(1.25rem, 3vw, 2.75rem);
    align-items: center;
    padding: clamp(1.65rem, 3vw, 2.2rem) 1.25rem;
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .service-path h3,
  .service-path p {
    margin: 0;
  }

  .service-path h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 700;
    transition: color 150ms ease;
  }

  .service-path p {
    max-width: 42ch;
    color: var(--ink-700);
    font-size: 0.98rem;
  }

  .service-path span {
    grid-column: 2;
    color: var(--forest-800);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    white-space: nowrap;
    transition: text-decoration-color 150ms ease, transform 150ms ease;
  }

  .service-path span::after {
    display: inline-block;
    margin-left: 0.4rem;
    content: "→";
    transition: transform 180ms ease;
  }

  .service-path:hover,
  .service-path:focus-visible {
    background: var(--forest-100);
    box-shadow: inset 4px 0 0 var(--wood-500);
    transform: translateX(4px);
  }

  .service-path:hover h3 {
    color: var(--forest-700);
  }

  .service-path:hover span,
  .service-path:focus-visible span {
    text-decoration-color: currentColor;
  }

  .service-path:hover span::after,
  .service-path:focus-visible span::after {
    transform: translateX(3px);
  }

  .service-path:active {
    transform: translateX(2px);
  }

  .testimonials-section {
    position: relative;
    background: var(--cream-100);
  }

  .testimonials-section::before {
    position: absolute;
    top: 0;
    left: 0;
    width: min(18vw, 220px);
    height: 8px;
    content: "";
    background: var(--wood-500);
  }

  .testimonial-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .testimonial-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-small);
  }

  .testimonial-card-featured {
    grid-column: 1 / -1;
    background: var(--forest-100);
  }

  .testimonial-card::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 5px;
    content: "";
    background: var(--wood-500);
  }

  .testimonial-copy {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .testimonial-copy blockquote {
    margin: 0;
  }

  .testimonial-copy blockquote::before {
    display: block;
    margin-bottom: 0.35rem;
    content: "“";
    color: var(--wood-500);
    font-family: Georgia, serif;
    font-size: 2.6rem;
    line-height: 0.8;
  }

  .testimonial-copy blockquote p {
    max-width: 34ch;
    margin: 0;
    color: var(--ink-900);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.55;
  }

  .testimonial-card-featured .testimonial-copy blockquote p {
    max-width: 29ch;
    font-size: clamp(1.22rem, 2.3vw, 1.6rem);
    line-height: 1.45;
  }

  .testimonial-card-featured .testimonial-copy {
    grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);
    grid-template-rows: auto;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }

  .testimonial-meta {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    margin-top: 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .testimonial-card-featured .testimonial-meta {
    margin-top: 0;
    padding: 0 0 0 clamp(1.5rem, 3vw, 2.5rem);
    border-top: 0;
    border-left: 1px solid var(--border);
  }

  .testimonial-meta img {
    width: 78px;
    height: 58px;
    flex: 0 0 auto;
    border-radius: var(--radius-small);
    object-fit: cover;
  }

  .testimonial-card-featured .testimonial-meta img {
    width: 110px;
    height: 82px;
  }

  .testimonial-name {
    margin: 0;
    color: var(--forest-800);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .about-owner {
    padding-block: clamp(4.5rem, 8vw, 6.5rem);
    background: var(--cream-50);
  }

  .about-owner-grid {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(200px, 280px) minmax(0, 560px);
    gap: clamp(2.75rem, 7vw, 6rem);
    align-items: center;
    justify-content: center;
    max-width: 980px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: var(--white);
    box-shadow: var(--shadow-medium);
  }

  .about-owner-grid::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 8px;
    height: 100%;
    content: "";
    background: var(--wood-500);
  }

  .owner-photo {
    position: relative;
    z-index: 0;
    margin: 0;
    padding: 0 0.75rem 0.75rem 0;
  }

  .owner-photo::before {
    position: absolute;
    z-index: -1;
    inset: 0.75rem 0 0 0.75rem;
    border-radius: var(--radius-large);
    content: "";
    background: var(--forest-100);
  }

  .owner-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(16, 45, 37, 0.12);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-small);
    object-fit: cover;
    object-position: 45% center;
  }

  .owner-copy h2 {
    margin-bottom: 1.25rem;
  }

  .owner-copy p {
    max-width: 52ch;
    margin-bottom: 1.35rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .owner-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--forest-800);
    font-size: 0.92rem;
    font-weight: 700;
    text-underline-offset: 0.3em;
  }

  .owner-link::after {
    display: inline-block;
    content: "→";
    transition: transform 180ms ease;
  }

  .owner-link:hover::after,
  .owner-link:focus-visible::after {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .home-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }

    .home-hero-copy {
      max-width: 670px;
    }

    .home-hero-copy h1 {
      max-width: 13ch;
    }

    .home-hero-photo {
      max-width: 760px;
    }

    .home-services > .shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .home-services .home-section-heading {
      position: static;
      max-width: 620px;
    }

    .service-path {
      grid-template-columns: minmax(190px, 0.78fr) minmax(0, 1.22fr);
    }

    .testimonial-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .testimonial-card-featured {
      grid-column: auto;
      grid-row: auto;
      min-height: 0;
    }

    .testimonial-card-featured .testimonial-copy {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      gap: 0;
    }

    .testimonial-card-featured .testimonial-meta {
      margin-top: 1.35rem;
      padding: 1rem 0 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

  }

  @media (max-width: 700px) {
    .home-hero {
      padding-block: 3.25rem 4.5rem;
    }

    .home-hero-copy::before {
      margin-bottom: 1.25rem;
    }

    .home-hero-copy h1 {
      max-width: 12ch;
      font-size: clamp(2.75rem, 13vw, 4rem);
      line-height: 1.04;
    }

    .home-hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-primary-action {
      width: 100%;
    }

    .home-section {
      padding-block: 4.75rem;
    }

    .service-path {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 1.6rem 1rem;
    }

    .service-path span {
      grid-column: 1;
      margin-top: 0.25rem;
    }

    .testimonial-copy {
      padding: 1.35rem;
    }

    .testimonial-card-featured .testimonial-copy blockquote p {
      font-size: 1.18rem;
    }

    .testimonial-meta img,
    .testimonial-card-featured .testimonial-meta img {
      width: 76px;
      height: 58px;
    }

    .about-owner-grid {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
      padding: 1.25rem;
    }

    .owner-copy h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 460px) {
    .about-owner-grid {
      grid-template-columns: 1fr;
    }

    .owner-photo {
      width: 128px;
    }

    .about-owner-grid::after {
      width: 100%;
      height: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-copy,
    .home-hero-photo {
      animation: none;
    }

    .home-primary-action,
    .service-path,
    .service-path h3,
    .service-path span,
    .service-path span::after,
    .owner-link::after {
      transition: none;
    }
  }
</style>
