---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Benyamin Kay Sukkas"
  description="Plan a new sukkah, arrange seasonal service, or request a rental from Benyamin Kay Sukkas."
>
  <div class="home-page">
    <section class="home-hero">
      <div class="home-hero-grid shell">
        <div class="home-hero-copy">
          <h1><span>Your sukkah,</span> <strong>handled.</strong></h1>
          <p>Buying, renting, or preparing the sukkah you already own starts here.</p>
          <div class="home-hero-actions">
            <a class="button home-primary-action" href="#services">Choose a service</a>
            <a class="home-phone-link" href="tel:+13474542282">Call (347) 454-2282</a>
          </div>
        </div>

        <figure class="home-hero-photo">
          <img
            src="/assets/images/home-hero-decorated-sukkah.jpg"
            alt="Decorated sukkah interior with a long set table beneath a schach roof"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Decorated sukkah interior</figcaption>
        </figure>
      </div>
    </section>

    <section id="services" class="home-section home-services" aria-labelledby="services-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="services-heading">What do you need help with?</h2>
        </div>

        <nav class="service-paths" aria-label="Sukkah services">
          <a class="service-path" href="/sukka-builder/">
            <h3>Buy a sukkah</h3>
            <p>Plan a new sukkah and its installation around your space.</p>
            <span>Start planning</span>
          </a>
          <a class="service-path" href="/sukka-builder/">
            <h3>I already have a sukkah</h3>
            <p>Arrange storage, setup, takedown, or other seasonal work.</p>
            <span>Request service</span>
          </a>
          <a class="service-path" href="/sukkah-rentals/">
            <h3>Rent a sukkah</h3>
            <p>Share your dates, location, and the size you need.</p>
            <span>View rentals</span>
          </a>
        </nav>
      </div>
    </section>

    <section class="home-section testimonials-section" aria-labelledby="testimonials-heading">
      <div class="shell">
        <div class="home-section-heading">
          <h2 id="testimonials-heading">What customers say</h2>
        </div>

        <div class="testimonial-grid">
          <article class="testimonial-card">
            <div class="testimonial-photo-placeholder" role="img" aria-label="Customer photo placeholder">
              <span>Customer photo</span>
            </div>
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will go here.</p>
              </blockquote>
              <p class="testimonial-name">Customer name</p>
            </div>
          </article>

          <article class="testimonial-card">
            <div class="testimonial-photo-placeholder" role="img" aria-label="Customer photo placeholder">
              <span>Customer photo</span>
            </div>
            <div class="testimonial-copy">
              <blockquote>
                <p>Approved customer testimonial will go here.</p>
              </blockquote>
              <p class="testimonial-name">Customer name</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section about-owner" aria-labelledby="owner-heading">
      <div class="about-owner-grid shell">
        <figure class="owner-photo">
          <img src="/assets/images/profile-photo1.jpg" alt="Benyamin Kay, owner of Benyamin Kay Sukkas" />
        </figure>
        <div class="owner-copy">
          <h2 id="owner-heading">Meet Benyamin</h2>
          <p>
            Benyamin Kay is the owner of Benyamin Kay Sukkas. His hands-on approach grew from helping families prepare their spaces for Sukkos.
          </p>
          <a class="owner-link" href="/about/">Read more about Benyamin</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    overflow: clip;
    background: var(--cream-50);
  }

  .home-page h1,
  .home-page h2,
  .home-page h3 {
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  }

  .home-hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    background:
      linear-gradient(
        104deg,
        var(--cream-50) 0%,
        var(--cream-50) 59%,
        rgba(229, 238, 232, 0.72) 59%,
        rgba(229, 238, 232, 0.72) 100%
      );
  }

  .home-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    gap: clamp(3.25rem, 7vw, 6.75rem);
    align-items: center;
  }

  .home-hero-copy {
    max-width: 560px;
  }

  .home-hero-copy::before {
    width: 54px;
    height: 4px;
    display: block;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    content: "";
    background: var(--wood-500);
  }

  .home-hero-copy h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3.2rem, 6vw, 5rem);
    font-weight: 620;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .home-hero-copy h1 span,
  .home-hero-copy h1 strong {
    display: block;
  }

  .home-hero-copy h1 strong {
    width: fit-content;
    padding-bottom: 0.08em;
    border-bottom: 0.1em solid rgba(200, 134, 67, 0.62);
    color: var(--forest-800);
    font: inherit;
  }

  .home-hero-copy > p {
    max-width: 35rem;
    margin-bottom: 2rem;
    color: var(--ink-700);
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    line-height: 1.6;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    align-items: center;
  }

  .home-primary-action {
    min-width: 156px;
    border-radius: 12px;
    font-weight: 640;
    box-shadow: 0 10px 24px rgba(16, 45, 37, 0.14);
  }

  .home-primary-action:hover {
    box-shadow: 0 14px 30px rgba(16, 45, 37, 0.18);
    transform: translateY(-1px);
  }

  .home-primary-action:active {
    transform: translateY(1px);
  }

  .home-phone-link {
    color: var(--forest-900);
    font-size: 0.96rem;
    font-weight: 650;
    text-decoration-color: rgba(23, 63, 52, 0.32);
    text-underline-offset: 0.3em;
  }

  .home-phone-link:hover {
    text-decoration-color: currentColor;
  }

  .home-hero-photo {
    position: relative;
    z-index: 0;
    margin: 0;
    padding: 0 0 1.15rem 1.15rem;
  }

  .home-hero-photo::before {
    position: absolute;
    z-index: -1;
    inset: 1.35rem -1.35rem 0 0;
    border-radius: 16px;
    content: "";
    background: var(--forest-900);
  }

  .home-hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(16, 45, 37, 0.12);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(16, 45, 37, 0.17);
    object-fit: cover;
  }

  .home-hero-photo figcaption {
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.78rem;
    text-align: right;
  }

  .home-section {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--border);
  }

  .home-section-heading {
    max-width: 700px;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .home-section-heading h2,
  .owner-copy h2 {
    margin: 0;
    font-size: clamp(2.15rem, 4.5vw, 3.6rem);
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .home-services {
    background: var(--white);
  }

  .home-services > .shell {
    display: grid;
    grid-template-columns: minmax(230px, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .home-services .home-section-heading {
    position: sticky;
    top: 7.5rem;
    margin: 0;
    padding-left: 1.5rem;
    border-left: 4px solid var(--wood-500);
  }

  .service-paths {
    display: grid;
    border-top: 1px solid var(--border-strong);
  }

  .service-path {
    position: relative;
    display: grid;
    grid-template-columns: minmax(190px, 0.82fr) minmax(230px, 1.18fr);
    gap: clamp(1.25rem, 3vw, 2.75rem);
    align-items: center;
    padding: clamp(1.65rem, 3vw, 2.2rem) 1.25rem;
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .service-path h3,
  .service-path p {
    margin: 0;
  }

  .service-path h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 620;
    transition: color 150ms ease;
  }

  .service-path p {
    max-width: 42ch;
    color: var(--ink-700);
    font-size: 0.98rem;
  }

  .service-path span {
    grid-column: 2;
    color: var(--forest-800);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    white-space: nowrap;
    transition: text-decoration-color 150ms ease, transform 150ms ease;
  }

  .service-path span::after {
    display: inline-block;
    margin-left: 0.4rem;
    content: "→";
    transition: transform 180ms ease;
  }

  .service-path:hover,
  .service-path:focus-visible {
    background: rgba(229, 238, 232, 0.52);
    box-shadow: inset 4px 0 0 var(--wood-500);
    transform: translateX(4px);
  }

  .service-path:hover h3 {
    color: var(--forest-700);
  }

  .service-path:hover span,
  .service-path:focus-visible span {
    text-decoration-color: currentColor;
  }

  .service-path:hover span::after,
  .service-path:focus-visible span::after {
    transform: translateX(3px);
  }

  .service-path:active {
    transform: translateX(2px);
  }

  .testimonials-section {
    position: relative;
    background:
      linear-gradient(135deg, rgba(229, 238, 232, 0.72), rgba(248, 244, 234, 0.7));
  }

  .testimonials-section::before {
    position: absolute;
    top: 0;
    left: 0;
    width: min(18vw, 220px);
    height: 8px;
    content: "";
    background: var(--wood-500);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }

  .testimonial-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 142px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    min-height: 210px;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 42px rgba(16, 45, 37, 0.08);
  }

  .testimonial-card::after {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    content: "";
    background: var(--wood-500);
  }

  .testimonial-card:nth-child(2) {
    grid-template-columns: 112px minmax(0, 1fr);
    background: rgba(255, 253, 248, 0.92);
  }

  .testimonial-photo-placeholder {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
    padding: 0.75rem;
    border: 1px solid rgba(23, 63, 52, 0.18);
    border-radius: 12px;
    color: var(--forest-800);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.55), transparent 48%),
      var(--forest-100);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .testimonial-copy blockquote {
    margin: 0;
  }

  .testimonial-copy blockquote p {
    margin-bottom: 1.15rem;
    color: var(--ink-900);
    font-size: clamp(1rem, 1.7vw, 1.1rem);
    line-height: 1.55;
  }

  .testimonial-name {
    margin: 0;
    color: var(--forest-800);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .about-owner {
    padding-block: clamp(4.5rem, 8vw, 6.5rem);
    background: var(--cream-50);
  }

  .about-owner-grid {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(200px, 280px) minmax(0, 560px);
    gap: clamp(2.75rem, 7vw, 6rem);
    align-items: center;
    justify-content: center;
    max-width: 980px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
    box-shadow: 0 20px 50px rgba(16, 45, 37, 0.08);
  }

  .about-owner-grid::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 8px;
    height: 100%;
    content: "";
    background: var(--wood-500);
  }

  .owner-photo {
    position: relative;
    z-index: 0;
    margin: 0;
    padding: 0 0.75rem 0.75rem 0;
  }

  .owner-photo::before {
    position: absolute;
    z-index: -1;
    inset: 0.75rem 0 0 0.75rem;
    border-radius: 16px;
    content: "";
    background: var(--forest-100);
  }

  .owner-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(16, 45, 37, 0.12);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(16, 45, 37, 0.12);
    object-fit: cover;
    object-position: 45% center;
  }

  .owner-copy h2 {
    margin-bottom: 1.25rem;
  }

  .owner-copy p {
    max-width: 52ch;
    margin-bottom: 1.35rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .owner-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--forest-800);
    font-size: 0.92rem;
    font-weight: 700;
    text-underline-offset: 0.3em;
  }

  .owner-link::after {
    display: inline-block;
    content: "→";
    transition: transform 180ms ease;
  }

  .owner-link:hover::after,
  .owner-link:focus-visible::after {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .home-hero {
      background:
        linear-gradient(
          180deg,
          var(--cream-50) 0%,
          var(--cream-50) 57%,
          rgba(229, 238, 232, 0.72) 57%,
          rgba(229, 238, 232, 0.72) 100%
        );
    }

    .home-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }

    .home-hero-copy {
      max-width: 670px;
    }

    .home-hero-copy h1 {
      max-width: 12ch;
    }

    .home-hero-photo {
      max-width: 760px;
    }

    .home-services > .shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .home-services .home-section-heading {
      position: static;
      max-width: 620px;
    }

    .service-path {
      grid-template-columns: minmax(190px, 0.78fr) minmax(0, 1.22fr);
    }

    .testimonial-card {
      grid-template-columns: 108px minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      padding-block: 3.25rem 4.5rem;
    }

    .home-hero-copy::before {
      margin-bottom: 1.25rem;
    }

    .home-hero-copy h1 {
      max-width: 11ch;
      font-size: clamp(2.75rem, 13vw, 4rem);
      line-height: 1;
    }

    .home-hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-primary-action {
      width: 100%;
    }

    .home-section {
      padding-block: 4.75rem;
    }

    .service-path {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 1.6rem 1rem;
    }

    .service-path span {
      grid-column: 1;
      margin-top: 0.25rem;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card {
      grid-template-columns: 88px minmax(0, 1fr);
      min-height: 0;
      padding: 1rem;
    }

    .testimonial-card:nth-child(2) {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    .about-owner-grid {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
      padding: 1.25rem;
    }

    .owner-copy h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 460px) {
    .testimonial-card {
      grid-template-columns: 74px minmax(0, 1fr);
      gap: 1rem;
    }

    .testimonial-photo-placeholder {
      font-size: 0.62rem;
    }

    .about-owner-grid {
      grid-template-columns: 1fr;
    }

    .owner-photo {
      width: 128px;
    }

    .about-owner-grid::after {
      width: 100%;
      height: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-primary-action,
    .service-path,
    .service-path h3,
    .service-path span,
    .service-path span::after,
    .owner-link::after {
      transition: none;
    }
  }
</style>
