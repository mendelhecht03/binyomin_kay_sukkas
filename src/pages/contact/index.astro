---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Call, email, WhatsApp, or send Benyamin Kay the details of your sukkah or outdoor project."
>
  <section class="page-hero">
    <div class="page-hero-inner shell">
      <p class="eyebrow">Contact</p>
      <h1>Tell us what you need help with.</h1>
      <p class="lead">Share the service, location, timing, and any useful measurements. A few clear details make the next conversation easier.</p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="contact-layout shell">
      <div class="contact-options">
        <p class="eyebrow">Choose what works for you</p>
        <h2>Reach Benyamin directly.</h2>
        <p>For a site photo or a quick question, WhatsApp may be the simplest option.</p>

        <ul class="contact-methods">
          <li>
            <a href="tel:+13474542282">
              <span class="contact-icon" aria-hidden="true">☎</span>
              <span><small>Phone</small><strong>(347) 454-2282</strong></span>
              <b aria-hidden="true">→</b>
            </a>
          </li>
          <li>
            <a href="https://wa.me/13474542282" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">✦</span>
              <span><small>WhatsApp</small><strong>+1 (347) 454-2282</strong></span>
              <b aria-hidden="true">→</b>
            </a>
          </li>
          <li>
            <a href="mailto:bkaysukkahbuilders@gmail.com">
              <span class="contact-icon" aria-hidden="true">@</span>
              <span><small>Email</small><strong>bkaysukkahbuilders@gmail.com</strong></span>
              <b aria-hidden="true">→</b>
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/bkaysukkahbuilders/" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">◎</span>
              <span><small>Instagram</small><strong>@bkaysukkahbuilders</strong></span>
              <b aria-hidden="true">→</b>
            </a>
          </li>
        </ul>
      </div>

      <div class="form-card">
        <h2>Prepare an email</h2>
        <p>Fill this out and your email app will open with the message ready to send.</p>

        <form data-contact-form>
          <div class="form-grid">
            <div class="field">
              <label for="contact-name">Name <span class="required-mark" aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="contact-reply">Email or phone</label>
              <input id="contact-reply" name="reply" type="text" autocomplete="email" />
            </div>
            <div class="field field-full">
              <label for="contact-service">What can we help with?</label>
              <select id="contact-service" name="service">
                <option value="Builds request">Builds request</option>
                <option value="Sukkah rental">Sukkah rental</option>
                <option value="Custom sukkah">Custom sukkah</option>
                <option value="Pergola">Pergola</option>
                <option value="Tree trimming">Tree trimming</option>
                <option value="Eruv work">Eruv work</option>
                <option value="Other project">Other project</option>
              </select>
            </div>
            <div class="field field-full">
              <label for="contact-message">Project details <span class="required-mark" aria-hidden="true">*</span></label>
              <textarea id="contact-message" name="message" placeholder="Location, timing, approximate size, and anything else we should know." required></textarea>
            </div>
          </div>
          <button class="button submit-button" type="submit">Open Email Message</button>
          <p class="form-status" data-contact-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <script>
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-contact-status]");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const reply = String(data.get("reply") || "").trim();
    const service = String(data.get("service") || "Project").trim();
    const message = String(data.get("message") || "").trim();

    if (!name || !message) {
      status.dataset.state = "error";
      status.textContent = "Please add your name and project details.";
      return;
    }

    const subject = encodeURIComponent(`Website request: ${service}`);
    const body = encodeURIComponent(
      `Name: ${name}\nReply by email or phone: ${reply || "Not provided"}\nService: ${service}\n\nProject details:\n${message}`,
    );

    status.dataset.state = "success";
    status.textContent = "Your email app should open now. Review the message, then press Send.";
    window.location.href = `mailto:bkaysukkahbuilders@gmail.com?subject=${subject}&body=${body}`;
  });
  </script>
</BaseLayout>

<style>
  .contact-section {
    background: linear-gradient(180deg, var(--cream-50), var(--cream-100));
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(420px, 1.15fr);
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: start;
  }

  .contact-options h2 {
    max-width: 520px;
  }

  .contact-methods {
    display: grid;
    gap: 0.7rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-methods a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: white;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .contact-methods a:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-small);
    transform: translateY(-2px);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    color: white;
    background: var(--forest-900);
    font-weight: 850;
  }

  .contact-methods a > span:nth-child(2) {
    min-width: 0;
    display: grid;
    gap: 0.05rem;
  }

  .contact-methods small {
    color: var(--ink-500);
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .contact-methods strong {
    overflow-wrap: anywhere;
    font-size: 0.92rem;
  }

  .contact-methods b {
    color: var(--wood-600);
  }

  .form-card h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .submit-button {
    width: 100%;
    margin-top: 1.2rem;
  }

  @media (max-width: 840px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
