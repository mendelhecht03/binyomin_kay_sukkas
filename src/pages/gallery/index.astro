---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gallery — Coming Soon"
  description="The Benyamin Kay Sukkas project gallery is being prepared and will be available soon."
>
  <div class="construction-page">
    <section class="construction-card shell" aria-labelledby="gallery-heading">
      <div class="construction-copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Gallery</span>
        </nav>

        <p class="eyebrow">Gallery</p>
        <p class="status"><span aria-hidden="true"></span> Under construction</p>
        <h1 id="gallery-heading">Our gallery is taking shape.</h1>
        <p class="lead">
          We’re selecting and organizing real project photos now. Check back soon
          for completed sukkahs, rentals, and outdoor work.
        </p>
        <div class="action-row">
          <a class="button" href="/">Return home</a>
          <a class="text-link" href="/contact/">Request a quote <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="photo-board" aria-hidden="true">
        <div class="construction-tape">Coming soon</div>
        <div class="photo-card photo-card--one">
          <span class="photo-shape"></span>
          <span class="caption-line"></span>
        </div>
        <div class="photo-card photo-card--two">
          <span class="photo-shape"></span>
          <span class="caption-line"></span>
        </div>
        <div class="photo-card photo-card--three">
          <span class="photo-shape"></span>
          <span class="caption-line"></span>
        </div>
        <span class="board-note">Real project photos are on the way.</span>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .construction-page {
    min-height: 70vh;
    display: grid;
    align-items: center;
    padding-block: clamp(2rem, 7vw, 5.5rem);
    background:
      radial-gradient(circle at 15% 20%, rgba(200, 134, 67, 0.1), transparent 28rem),
      linear-gradient(135deg, var(--cream-50), var(--cream-100));
  }

  .construction-card {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(20rem, 0.78fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: rgba(255, 253, 248, 0.84);
    box-shadow: var(--shadow-medium);
  }

  .construction-copy {
    min-width: 0;
  }

  .breadcrumb {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin-bottom: 0.65rem;
  }

  .status {
    width: fit-content;
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin: 0 0 1rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(200, 134, 67, 0.28);
    border-radius: 999px;
    color: var(--forest-800);
    background: #fbf2e5;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status span {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: var(--wood-500);
    box-shadow: 0 0 0 4px rgba(200, 134, 67, 0.14);
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.2rem;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.98;
  }

  .lead {
    max-width: 38rem;
    margin-bottom: 1.75rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    align-items: center;
  }

  .text-link {
    color: var(--forest-800);
    font-weight: 800;
    text-underline-offset: 0.25em;
  }

  .text-link span {
    display: inline-block;
    margin-left: 0.25rem;
    transition: transform 160ms ease;
  }

  .text-link:hover span {
    transform: translateX(3px);
  }

  .photo-board {
    position: relative;
    min-height: clamp(22rem, 42vw, 31rem);
    overflow: hidden;
    border: 1px dashed rgba(29, 74, 61, 0.28);
    border-radius: 1.25rem;
    background:
      linear-gradient(45deg, rgba(29, 74, 61, 0.035) 25%, transparent 25%) 0 0 / 32px 32px,
      linear-gradient(-45deg, rgba(29, 74, 61, 0.035) 25%, transparent 25%) 0 0 / 32px 32px,
      var(--cream-100);
  }

  .construction-tape {
    position: absolute;
    z-index: 4;
    top: 1.75rem;
    right: -2.8rem;
    width: 13rem;
    padding: 0.55rem 1rem;
    transform: rotate(8deg);
    color: var(--forest-950);
    background: #e7bf79;
    box-shadow: 0 0.5rem 1.5rem rgba(64, 45, 22, 0.15);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-align: center;
    text-transform: uppercase;
  }

  .photo-card {
    position: absolute;
    width: 48%;
    padding: 0.7rem 0.7rem 1rem;
    border: 1px solid rgba(29, 74, 61, 0.1);
    border-radius: 0.45rem;
    background: #fffdf8;
    box-shadow: 0 1rem 2rem rgba(35, 46, 40, 0.13);
  }

  .photo-card--one {
    top: 16%;
    left: 9%;
    transform: rotate(-5deg);
  }

  .photo-card--two {
    top: 27%;
    right: 7%;
    transform: rotate(5deg);
  }

  .photo-card--three {
    bottom: 10%;
    left: 25%;
    transform: rotate(-1.5deg);
  }

  .photo-shape {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(160deg, #d9e1d6 0 48%, #c8d4c8 48% 100%);
  }

  .photo-shape::before {
    content: "";
    position: absolute;
    right: 12%;
    bottom: 0;
    left: 12%;
    height: 58%;
    border: 0.3rem solid var(--forest-700);
    border-bottom: 0;
    background: rgba(255, 253, 248, 0.72);
    clip-path: polygon(50% 0, 100% 28%, 100% 100%, 0 100%, 0 28%);
  }

  .caption-line {
    width: 64%;
    height: 0.4rem;
    display: block;
    margin: 0.85rem auto 0;
    border-radius: 999px;
    background: var(--cream-300);
  }

  .board-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    color: var(--forest-800);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 54rem) {
    .construction-card {
      grid-template-columns: 1fr;
    }

    .photo-board {
      width: min(100%, 35rem);
      min-height: 26rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 36rem) {
    .construction-page {
      padding-block: 1rem 2.5rem;
    }

    .construction-card {
      width: min(100% - 1rem, 74rem);
      gap: 2rem;
      border-radius: 1rem;
    }

    .breadcrumb {
      margin-bottom: 2rem;
    }

    .action-row {
      align-items: stretch;
      flex-direction: column;
    }

    .action-row .button {
      width: 100%;
    }

    .text-link {
      padding: 0.35rem 0;
      text-align: center;
    }

    .photo-board {
      min-height: 21rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link span {
      transition: none;
    }
  }
</style>
