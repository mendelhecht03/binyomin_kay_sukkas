---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormHeading from "../../components/FormHeading.astro";
import "../../styles/guided-request-form.css";

const services = ["Bring out of storage", "Build", "Take down", "Bring to storage"];
const neighborhoods = [
  "Crown Heights",
  "East Flatbush",
  "Remsen Village",
  "Flatbush",
  "Boro Park",
  "Williamsburg",
  "Park Slope",
  "Manhattan",
  "Queens",
  "Monsey",
  "New Haven",
  "South Florida",
  "Los Angeles",
];
const states = [
  ["AL", "Alabama"], ["AK", "Alaska"], ["AZ", "Arizona"], ["AR", "Arkansas"],
  ["CA", "California"], ["CO", "Colorado"], ["CT", "Connecticut"], ["DE", "Delaware"],
  ["DC", "District of Columbia"], ["FL", "Florida"], ["GA", "Georgia"], ["HI", "Hawaii"],
  ["ID", "Idaho"], ["IL", "Illinois"], ["IN", "Indiana"], ["IA", "Iowa"],
  ["KS", "Kansas"], ["KY", "Kentucky"], ["LA", "Louisiana"], ["ME", "Maine"],
  ["MD", "Maryland"], ["MA", "Massachusetts"], ["MI", "Michigan"], ["MN", "Minnesota"],
  ["MS", "Mississippi"], ["MO", "Missouri"], ["MT", "Montana"], ["NE", "Nebraska"],
  ["NV", "Nevada"], ["NH", "New Hampshire"], ["NJ", "New Jersey"], ["NM", "New Mexico"],
  ["NY", "New York"], ["NC", "North Carolina"], ["ND", "North Dakota"], ["OH", "Ohio"],
  ["OK", "Oklahoma"], ["OR", "Oregon"], ["PA", "Pennsylvania"], ["RI", "Rhode Island"],
  ["SC", "South Carolina"], ["SD", "South Dakota"], ["TN", "Tennessee"], ["TX", "Texas"],
  ["UT", "Utah"], ["VT", "Vermont"], ["VA", "Virginia"], ["WA", "Washington"],
  ["WV", "West Virginia"], ["WI", "Wisconsin"], ["WY", "Wyoming"],
];
const sukkahTypes = ["Canvas", "Canvas Bingo", "Snap / panel", "Wood boards with bolts", "Schach and beams only"];
const schachTypes = ["Bamboo mat", "Bamboo sticks", "Evergreen"];
const addOns = ["Put up lights", "Pressure wash area day before", "Bamboo mat", "Evergreen"];
---

<BaseLayout
  title="Builds"
  description="Share your sukkah setup, location, timing, and site details with Benyamin Kay Sukkas."
  bodyClass="builds-page request-form-page"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.2.3/public/assets/styles/choices.min.css" />
  </Fragment>

  <section class="builder-hero sukkah-hero-background">
    <div class="shell builder-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Builds</span>
      </nav>
      <div class="builder-hero-copy">
        <p class="eyebrow">BUILDS</p>
        <h1>Your sukkah starts with a good plan.</h1>
        <p class="lead">Share a few details and we’ll follow up with a custom quote.</p>
      </div>
    </div>
  </section>

  <section class="form-section" aria-labelledby="build-request-heading">
    <div class="shell form-shell">
      <h2 id="build-request-heading" class="sr-only">Build request</h2>

      <form class="builder-wizard guided-request-form" data-builder-form enctype="multipart/form-data" novalidate>
        <div class="form-honeypot" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input name="sukkahPlan" type="hidden" value="I already have a sukkah" />

        <div class="wizard-progress" data-progress-region aria-live="polite">
          <p>
            <span>Step <strong data-current-step>1</strong> of 6</span>
            <span class="progress-separator" aria-hidden="true">·</span>
            <strong data-current-label>Contact</strong>
          </p>
          <div class="progress-track" role="progressbar" aria-label="Build request progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1" aria-valuetext="Step 1 of 6: Contact">
            <span data-progress-bar></span>
          </div>
        </div>

        <div class="wizard-card">
          <section id="contact-details" class="form-step" aria-labelledby="contact-heading" data-form-step="1">
            <FormHeading icon="contact" eyebrow="Contact" heading="How can we reach you?" id="contact-heading" />
            <div class="form-grid contact-grid">
              <div class="field">
                <label for="firstName">First name <span class="required-mark">*</span></label>
                <input id="firstName" name="firstName" autocomplete="given-name" maxlength="200" required />
                <p class="field-error" id="firstName-error" data-error-for="firstName"></p>
              </div>
              <div class="field">
                <label for="lastName">Last name <span class="required-mark">*</span></label>
                <input id="lastName" name="lastName" autocomplete="family-name" maxlength="200" required />
                <p class="field-error" id="lastName-error" data-error-for="lastName"></p>
              </div>
              <div class="field">
                <label for="phone">Phone number <span class="required-mark">*</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="100" required />
                <p class="field-error" id="phone-error" data-error-for="phone"></p>
              </div>
              <div class="field">
                <label for="email">Email address <span class="required-mark">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" required />
                <p class="field-error" id="email-error" data-error-for="email"></p>
              </div>
            </div>
          </section>

          <section id="service-details" class="form-step" aria-labelledby="service-heading" data-form-step="2" hidden>
            <FormHeading icon="location" eyebrow="Location" heading="Where will the project be?" id="service-heading" />
            <p class="step-intro">Enter the address where the sukkah will be used.</p>
            <div class="address-grid">
              <div class="field address-street">
                <label for="address-line-1">Street address <span class="required-mark">*</span></label>
                <input id="address-line-1" name="addressLine1" autocomplete="address-line1" maxlength="1000" required />
                <p class="field-error" id="address-line-1-error" data-error-for="address-line-1"></p>
              </div>
              <div class="field">
                <label for="address-city">City <span class="required-mark">*</span></label>
                <input id="address-city" name="city" autocomplete="address-level2" maxlength="200" required />
                <p class="field-error" id="address-city-error" data-error-for="address-city"></p>
              </div>
              <div class="field">
                <label for="address-state">State <span class="required-mark">*</span></label>
                <select id="address-state" name="state" autocomplete="address-level1" required>
                  <option value="">Select state</option>
                  {states.map(([code, name]) => <option value={code}>{name}</option>)}
                </select>
                <p class="field-error" id="address-state-error" data-error-for="address-state"></p>
              </div>
              <div class="field address-postal">
                <label for="address-postal">ZIP code <span class="required-mark">*</span></label>
                <input id="address-postal" name="postalCode" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required />
                <p class="field-error" id="address-postal-error" data-error-for="address-postal"></p>
              </div>
            </div>
            <div class="field">
              <label for="neighborhood">Neighborhood <span class="required-mark">*</span></label>
              <select id="neighborhood" name="neighborhood" aria-controls="neighborhood-other-field" aria-expanded="false" required data-neighborhood-select>
                <option value="">Choose a neighborhood</option>
                {neighborhoods.map((neighborhood) => <option value={neighborhood}>{neighborhood}</option>)}
                <option value="Other">Other</option>
              </select>
              <p class="field-error" id="neighborhood-error" data-error-for="neighborhood"></p>
            </div>
            <div id="neighborhood-other-field" class="field conditional-field" data-neighborhood-other hidden>
              <label for="neighborhoodOther">Other neighborhood <span class="required-mark">*</span></label>
              <input id="neighborhoodOther" name="neighborhoodOther" maxlength="200" disabled />
              <p class="field-error" id="neighborhoodOther-error" data-error-for="neighborhoodOther"></p>
            </div>
            <fieldset data-required-group="service">
              <legend>What do you need help with? <span class="required-mark">*</span></legend>
              <p class="field-hint">Select everything that applies.</p>
              <div class="choice-grid service-grid">
                {services.map((service) => (
                  <label class="choice-card">
                    <input type="checkbox" name="service" value={service} />
                    <span>{service}</span>
                  </label>
                ))}
                <label class="choice-card">
                  <input type="checkbox" name="service" value="Other" aria-controls="service-other-field" aria-expanded="false" data-service-other-toggle />
                  <span>Other</span>
                </label>
              </div>
              <p class="group-error" id="service-group-error" data-group-error-for="service"></p>
            </fieldset>
            <div id="service-other-field" class="field conditional-field" data-service-other hidden>
              <label for="serviceOther">Other requested work <span class="required-mark">*</span></label>
              <input id="serviceOther" name="serviceOther" maxlength="500" disabled />
              <p class="field-error" id="serviceOther-error" data-error-for="serviceOther"></p>
            </div>
          </section>

          <section id="sukkah-details" class="form-step" aria-labelledby="details-heading" data-form-step="3" hidden>
            <FormHeading icon="sukkah" eyebrow="Your sukkah" heading="Tell us about your sukkah" id="details-heading" />
            <fieldset class="size-field">
              <legend>Approximate size <span class="required-mark">*</span></legend>
              <p class="field-hint">An estimate is fine. Adjust each measurement from 0 to 30 feet.</p>
              <div class="size-grid">
                <div class="size-control">
                  <div class="size-label-row"><label for="estimated-width">Width</label></div>
                  <input id="estimated-width" name="estimatedWidth" type="range" min="0" max="30" step="1" value="10" data-size-slider />
                  <output for="estimated-width" aria-label="10 feet" data-size-output="estimated-width"><span data-size-number>10</span><span class="size-unit">ft</span></output>
                </div>
                <div class="size-control">
                  <div class="size-label-row"><label for="estimated-length">Length</label></div>
                  <input id="estimated-length" name="estimatedLength" type="range" min="0" max="30" step="1" value="10" data-size-slider />
                  <output for="estimated-length" aria-label="10 feet" data-size-output="estimated-length"><span data-size-number>10</span><span class="size-unit">ft</span></output>
                </div>
              </div>
            </fieldset>

            <fieldset data-required-group="sukkahType">
              <legend>Sukkah type <span class="required-mark">*</span></legend>
              <div class="choice-grid configuration-grid">
                {sukkahTypes.map((type) => (
                  <label class="choice-card"><input type="radio" name="sukkahType" value={type} /><span>{type}</span></label>
                ))}
                <label class="choice-card">
                  <input type="radio" name="sukkahType" value="Other" aria-controls="sukkah-type-other-field" aria-expanded="false" />
                  <span>Other</span>
                </label>
              </div>
              <p class="group-error" id="sukkahType-group-error" data-group-error-for="sukkahType"></p>
            </fieldset>
            <div id="sukkah-type-other-field" class="field conditional-field" data-radio-other-field="sukkahType" hidden>
              <label for="sukkahTypeOther">Other sukkah type <span class="required-mark">*</span></label>
              <input id="sukkahTypeOther" name="sukkahTypeOther" maxlength="500" disabled />
              <p class="field-error" id="sukkahTypeOther-error" data-error-for="sukkahTypeOther"></p>
            </div>

            <fieldset data-required-group="schach">
              <legend>Schach type <span class="required-mark">*</span></legend>
              <div class="choice-grid configuration-grid">
                {schachTypes.map((type) => (
                  <label class="choice-card"><input type="radio" name="schach" value={type} /><span>{type}</span></label>
                ))}
                <label class="choice-card">
                  <input type="radio" name="schach" value="Other" aria-controls="schach-other-field" aria-expanded="false" />
                  <span>Other</span>
                </label>
              </div>
              <p class="group-error" id="schach-group-error" data-group-error-for="schach"></p>
            </fieldset>
            <div id="schach-other-field" class="field conditional-field" data-radio-other-field="schach" hidden>
              <label for="schachOther">Other schach type <span class="required-mark">*</span></label>
              <input id="schachOther" name="schachOther" maxlength="500" disabled />
              <p class="field-error" id="schachOther-error" data-error-for="schachOther"></p>
            </div>

            <fieldset>
              <legend>Optional add-ons</legend>
              <p class="field-hint">Choose anything else you’d like help with.</p>
              <div class="choice-grid add-on-grid">
                {addOns.map((addOn) => (
                  <label class="choice-card"><input type="checkbox" name="addOns" value={addOn} /><span>{addOn}</span></label>
                ))}
                <label class="choice-card">
                  <input type="checkbox" name="addOns" value="Other" aria-controls="add-ons-other-field" aria-expanded="false" data-addon-other-toggle />
                  <span>Other</span>
                </label>
              </div>
            </fieldset>
            <div id="add-ons-other-field" class="field conditional-field" data-addon-other hidden>
              <label for="addOnsOther">Other add-on <span class="required-mark">*</span></label>
              <input id="addOnsOther" name="addOnsOther" maxlength="500" disabled />
              <p class="field-error" id="addOnsOther-error" data-error-for="addOnsOther"></p>
            </div>

            <div class="extra-labor-group">
              <input type="hidden" name="extraServiceRequired" value="No" data-extra-service-required />
              <label class="choice-card extra-service-check">
                <input type="checkbox" aria-controls="extra-service-details-field" aria-expanded="false" data-extra-service-toggle />
                <span>
                  <strong>Special access or extra labor</strong>
                  <small>For example, a rooftop sukkah or unusual access.</small>
                </span>
              </label>
              <div id="extra-service-details-field" class="field conditional-field" data-extra-service-details hidden>
                <label for="extra-service-details">What extra help is needed? <span class="required-mark">*</span></label>
                <textarea id="extra-service-details" name="extraServiceDetails" rows="3" maxlength="2000" disabled></textarea>
                <p class="field-error" id="extra-service-details-error" data-error-for="extra-service-details"></p>
              </div>
            </div>
          </section>

          <section id="site-details" class="form-step" aria-labelledby="site-heading" data-form-step="4" hidden>
            <FormHeading icon="site" eyebrow="The site" heading="Help us understand the space" id="site-heading" />
            <div class="field">
              <label for="site-description">Where will the sukkah be built?</label>
              <textarea id="site-description" name="siteDescription" rows="4" maxlength="4000" placeholder="Backyard, patio, driveway, rooftop, balcony, etc."></textarea>
              <p class="field-error" id="site-description-error" data-error-for="site-description"></p>
            </div>
            <div class="photo-upload-card">
              <div class="upload-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="14" rx="2"></rect><circle cx="9" cy="10" r="1.5"></circle><path d="m5.5 17 4-4 3 3 2-2 4 3"></path></svg>
              </div>
              <div class="upload-copy">
                <strong>Add photos of the space</strong>
                <p>Photos help Benyamin understand the area before following up. Up to 3 JPG, PNG, or HEIC files, 10 MB each.</p>
              </div>
              <label class="upload-button" for="site-photos">Choose photos</label>
              <input class="sr-only-file" id="site-photos" name="sitePhotos" type="file" accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif" multiple />
              <div class="selected-photos" data-selected-photos aria-live="polite"></div>
              <p class="field-error" id="site-photos-error" data-error-for="site-photos"></p>
            </div>
          </section>

          <section id="timing-details" class="form-step" aria-labelledby="timing-heading" data-form-step="5" hidden>
            <FormHeading icon="timing" eyebrow="Timing" heading="When would you like it installed?" id="timing-heading" />
            <p class="step-intro">Choose your preferred installation date. We’ll confirm availability when we follow up.</p>
            <div class="field">
              <label for="build-date">Preferred installation date <span class="required-mark">*</span></label>
              <div class="date-control"><input id="build-date" name="buildDate" type="date" required /></div>
              <p class="field-error" id="build-date-error" data-error-for="build-date"></p>
            </div>
            <div class="conditional-schedule" data-reverse-sukkos-schedule hidden>
              <p class="step-intro">Choose the service dates that apply to your request.</p>
              <div class="schedule-grid">
                <div class="service-schedule" data-service-schedule="Take down" hidden>
                  <div class="field">
                    <label for="take-down-date">Take-down day <span class="required-mark">*</span></label>
                    <select id="take-down-date" name="takeDownDate" data-holiday-date-select data-date-order="reverse">
                      <option value="">Choose a date</option>
                      <option value="other" data-other-date-option>Other date</option>
                    </select>
                    <p class="field-error" id="take-down-date-error" data-error-for="take-down-date"></p>
                  </div>
                  <div class="field conditional-field" data-other-date-field hidden>
                    <label for="custom-take-down-date">Choose another take-down date <span class="required-mark">*</span></label>
                    <p class="field-hint" data-custom-date-range>Choose a date within the 30 days before Sukkos.</p>
                    <div class="date-control"><input id="custom-take-down-date" name="customTakeDownDate" type="date" /></div>
                    <p class="field-error" id="custom-take-down-date-error" data-error-for="custom-take-down-date"></p>
                  </div>
                </div>
                <div class="service-schedule" data-service-schedule="Bring to storage" hidden>
                  <div class="field">
                    <label for="bring-to-storage-date">Bring-to-storage day <span class="required-mark">*</span></label>
                    <select id="bring-to-storage-date" name="bringToStorageDate" data-holiday-date-select data-date-order="reverse">
                      <option value="">Choose a date</option>
                      <option value="other" data-other-date-option>Other date</option>
                    </select>
                    <p class="field-error" id="bring-to-storage-date-error" data-error-for="bring-to-storage-date"></p>
                  </div>
                  <div class="field conditional-field" data-other-date-field hidden>
                    <label for="custom-storage-date">Choose another storage date <span class="required-mark">*</span></label>
                    <p class="field-hint" data-custom-date-range>Choose a date within the 30 days before Sukkos.</p>
                    <div class="date-control"><input id="custom-storage-date" name="customStorageDate" type="date" /></div>
                    <p class="field-error" id="custom-storage-date-error" data-error-for="custom-storage-date"></p>
                  </div>
                </div>
              </div>
            </div>
            <div class="field">
              <label for="timing-notes">Timing notes <span class="optional-text">Optional</span></label>
              <input id="timing-notes" name="timingNotes" maxlength="1000" placeholder="Any timing preferences or scheduling details" />
              <p class="field-error" id="timing-notes-error" data-error-for="timing-notes"></p>
            </div>
          </section>

          <section id="final-details" class="form-step" aria-labelledby="final-heading" data-form-step="6" hidden>
            <FormHeading icon="final" eyebrow="Review" heading="Review and send" id="final-heading" />
            <div class="request-review" aria-labelledby="request-review-heading">
              <div class="review-heading">
                <h4 id="request-review-heading">Your request</h4>
                <p>Check the key details before sending.</p>
              </div>
              <dl class="review-list">
                <div><dt>Contact</dt><dd data-review-contact>Not added yet</dd><button type="button" data-edit-step="1">Edit<span class="sr-only"> contact details</span></button></div>
                <div><dt>Location</dt><dd data-review-location>Not added yet</dd><button type="button" data-edit-step="2">Edit<span class="sr-only"> location and requested work</span></button></div>
                <div><dt>Your sukkah</dt><dd data-review-sukkah>Not added yet</dd><button type="button" data-edit-step="3">Edit<span class="sr-only"> sukkah details</span></button></div>
                <div><dt>The site</dt><dd data-review-site>Not added yet</dd><button type="button" data-edit-step="4">Edit<span class="sr-only"> site details</span></button></div>
                <div><dt>Timing</dt><dd data-review-timing>Not added yet</dd><button type="button" data-edit-step="5">Edit<span class="sr-only"> timing details</span></button></div>
              </dl>
            </div>
            <div class="field">
              <label for="referral">How did you hear about us? <span class="required-mark">*</span></label>
              <input id="referral" name="referral" maxlength="1000" required />
              <p class="field-error" id="referral-error" data-error-for="referral"></p>
            </div>
            <div class="field">
              <label for="comments">Comments or questions <span class="optional-text">Optional</span></label>
              <textarea id="comments" name="comments" rows="3" maxlength="4000" placeholder="Add any details that did not fit above."></textarea>
              <p class="field-error" id="comments-error" data-error-for="comments"></p>
            </div>
          </section>

          <div class="wizard-actions">
            <button class="wizard-back" type="button" data-step-back hidden>Back</button>
            <button class="button wizard-continue" type="button" data-step-next>Continue</button>
            <button class="button form-submit-button" type="submit" data-submit-button hidden>
              <span data-submit-label>Request a quote</span>
            </button>
          </div>
          <p class="submit-reassurance" data-submit-status role="status" aria-live="polite" hidden>No payment required. Benyamin will review the details and follow up with you.</p>
        </div>

        <div class="request-success" data-success-panel hidden tabindex="-1">
          <p class="eyebrow">Request sent</p>
          <h3>Thank you.</h3>
          <p data-success-message>Benyamin received your build request and will follow up with you.</p>
          <a class="button" href="/">Return home</a>
        </div>
      </form>
      <noscript>
        <p class="noscript-note">JavaScript is needed to use this guided form. Please call <a href="tel:+13474542282">(347) 454-2282</a> or email <a href="mailto:bkaysukkahbuilders@gmail.com">bkaysukkahbuilders@gmail.com</a>.</p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/choices.js@11.2.3/public/assets/scripts/choices.min.js"></script>

<script is:inline>
  const builderForm = document.querySelector("[data-builder-form]");
  const steps = Array.from(document.querySelectorAll("[data-form-step]"));
  const progressRegion = document.querySelector("[data-progress-region]");
  const progressBar = document.querySelector("[data-progress-bar]");
  const progressTrack = progressBar?.parentElement;
  const currentStep = document.querySelector("[data-current-step]");
  const currentLabel = document.querySelector("[data-current-label]");
  const backButton = document.querySelector("[data-step-back]");
  const nextButton = document.querySelector("[data-step-next]");
  const submitButton = document.querySelector("[data-submit-button]");
  const submitLabel = document.querySelector("[data-submit-label]");
  const submitStatus = document.querySelector("[data-submit-status]");
  const wizardCard = document.querySelector(".wizard-card");
  const successPanel = document.querySelector("[data-success-panel]");
  const successMessage = document.querySelector("[data-success-message]");
  const editButtons = Array.from(document.querySelectorAll("[data-edit-step]"));
  const sizeSliders = Array.from(document.querySelectorAll("[data-size-slider]"));
  const serviceInputs = Array.from(document.querySelectorAll('input[name="service"]'));
  const neighborhoodSelect = document.querySelector("[data-neighborhood-select]");
  const neighborhoodOther = document.querySelector("[data-neighborhood-other]");
  const neighborhoodOtherInput = document.querySelector("#neighborhoodOther");
  const serviceOtherToggle = document.querySelector("[data-service-other-toggle]");
  const serviceOtherField = document.querySelector("[data-service-other]");
  const serviceOtherInput = document.querySelector("#serviceOther");
  const addOnOtherToggle = document.querySelector("[data-addon-other-toggle]");
  const addOnOtherField = document.querySelector("[data-addon-other]");
  const addOnOtherInput = document.querySelector("#addOnsOther");
  const extraServiceToggle = document.querySelector("[data-extra-service-toggle]");
  const extraServiceRequired = document.querySelector("[data-extra-service-required]");
  const extraServiceDetails = document.querySelector("[data-extra-service-details]");
  const extraServiceDetailsInput = document.querySelector("#extra-service-details");
  const reverseSukkosSchedule = document.querySelector("[data-reverse-sukkos-schedule]");
  const sitePhotos = document.querySelector("#site-photos");
  const selectedPhotos = document.querySelector("[data-selected-photos]");
  const buildDateInput = document.querySelector("#build-date");
  const stepNames = ["Contact", "Location", "Your sukkah", "The site", "Timing", "Review and send"];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const enhancedSelects = new WeakMap();
  let activeStep = 1;

  const scheduleConfigs = Array.from(document.querySelectorAll("[data-service-schedule]")).map((container) => ({
    service: container.getAttribute("data-service-schedule") || "",
    container,
    select: container.querySelector("[data-holiday-date-select]"),
    otherDateField: container.querySelector("[data-other-date-field]"),
    customDateInput: container.querySelector('input[type="date"]'),
    customDateRange: container.querySelector("[data-custom-date-range]"),
  }));

  function setContainerVisible(container, visible) {
    if (!(container instanceof HTMLElement)) return;
    container.hidden = !visible;
    container.querySelectorAll("input, select, textarea").forEach((control) => {
      if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) {
        control.disabled = !visible;
      }
    });
  }

  function fieldErrorElement(field) {
    return builderForm?.querySelector(`[data-error-for="${field.id}"]`);
  }

  function clearFieldError(field) {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
    field.removeAttribute("aria-invalid");
    field.removeAttribute("aria-describedby");
    const error = fieldErrorElement(field);
    if (error instanceof HTMLElement) error.textContent = "";
  }

  function fieldErrorMessage(field) {
    if (field.validity.valueMissing) return "Please complete this field.";
    if (field.validity.typeMismatch && field.type === "email") return "Enter a valid email address.";
    if (field.validity.patternMismatch) return "Enter a valid ZIP code.";
    return "Check this field and try again.";
  }

  function showFieldError(field, message = "") {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
    const error = fieldErrorElement(field);
    field.setAttribute("aria-invalid", "true");
    if (error instanceof HTMLElement) {
      error.textContent = message || fieldErrorMessage(field);
      if (error.id) field.setAttribute("aria-describedby", error.id);
    }
  }

  function setGroupError(name, message = "") {
    const fieldset = builderForm?.querySelector(`[data-required-group="${name}"]`);
    const error = builderForm?.querySelector(`[data-group-error-for="${name}"]`);
    fieldset?.toggleAttribute("aria-invalid", Boolean(message));
    if (error instanceof HTMLElement) error.textContent = message;
  }

  function checkedValues(name) {
    if (!(builderForm instanceof HTMLFormElement)) return [];
    return Array.from(builderForm.querySelectorAll(`input[name="${name}"]:checked`))
      .filter((input) => input instanceof HTMLInputElement)
      .map((input) => input.value);
  }

  function displayValue(name, fallback = "Not added yet") {
    if (!(builderForm instanceof HTMLFormElement)) return fallback;
    const field = builderForm.elements.namedItem(name);
    if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
      return field.value.trim() || fallback;
    }
    if (field instanceof RadioNodeList) {
      return String(field.value || "").trim() || fallback;
    }
    return fallback;
  }

  function selectedOrOther(name) {
    const value = displayValue(name, "");
    return value === "Other" ? displayValue(`${name}Other`) : value;
  }

  function formatDate(value) {
    if (!value) return "";
    const parsed = new Date(`${value}T12:00:00`);
    return Number.isNaN(parsed.getTime())
      ? value
      : new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(parsed);
  }

  function selectedScheduleDate(name, customName) {
    const value = displayValue(name, "");
    const chosen = value === "other" ? displayValue(customName, "") : value;
    return formatDate(chosen) || chosen;
  }

  function updateReview() {
    const contact = document.querySelector("[data-review-contact]");
    const location = document.querySelector("[data-review-location]");
    const sukkah = document.querySelector("[data-review-sukkah]");
    const site = document.querySelector("[data-review-site]");
    const timing = document.querySelector("[data-review-timing]");
    if (contact instanceof HTMLElement) {
      contact.textContent = [`${displayValue("firstName", "")} ${displayValue("lastName", "")}`.trim(), displayValue("phone", ""), displayValue("email", "")].filter(Boolean).join(" · ");
    }
    if (location instanceof HTMLElement) {
      const address = [displayValue("addressLine1", ""), displayValue("city", ""), displayValue("state", ""), displayValue("postalCode", "")].filter(Boolean).join(", ");
      const work = checkedValues("service").map((value) => value === "Other" ? displayValue("serviceOther", "Other") : value).join(", ");
      location.textContent = [address, selectedOrOther("neighborhood"), work ? `Work: ${work}` : ""].filter(Boolean).join(" · ");
    }
    if (sukkah instanceof HTMLElement) {
      const addOns = checkedValues("addOns").map((value) => value === "Other" ? displayValue("addOnsOther", "Other") : value);
      const parts = [
        `${displayValue("estimatedWidth", "10")} × ${displayValue("estimatedLength", "10")} ft`,
        selectedOrOther("sukkahType"),
        `Schach: ${selectedOrOther("schach")}`,
        addOns.length ? `Add-ons: ${addOns.join(", ")}` : "",
      ];
      if (extraServiceToggle instanceof HTMLInputElement && extraServiceToggle.checked) parts.push("Special access or extra labor");
      sukkah.textContent = parts.filter(Boolean).join(" · ");
    }
    if (site instanceof HTMLElement) {
      const photoCount = sitePhotos instanceof HTMLInputElement && sitePhotos.files ? sitePhotos.files.length : 0;
      site.textContent = [displayValue("siteDescription", "No site description"), photoCount ? `${photoCount} photo${photoCount === 1 ? "" : "s"} selected` : "No photos selected"].join(" · ");
    }
    if (timing instanceof HTMLElement) {
      const parts = [`Install: ${formatDate(displayValue("buildDate", "")) || "Not selected"}`];
      if (checkedValues("service").includes("Take down")) parts.push(`Take down: ${selectedScheduleDate("takeDownDate", "customTakeDownDate")}`);
      if (checkedValues("service").includes("Bring to storage")) parts.push(`Storage: ${selectedScheduleDate("bringToStorageDate", "customStorageDate")}`);
      timing.textContent = parts.join(" · ");
    }
  }

  function updateConditionalField(trigger, field, input) {
    const show = trigger instanceof HTMLInputElement && trigger.checked;
    if (trigger instanceof HTMLInputElement) trigger.setAttribute("aria-expanded", String(show));
    if (field instanceof HTMLElement) field.hidden = !show;
    if (input instanceof HTMLInputElement) {
      input.disabled = !show;
      input.required = show;
      if (!show) clearFieldError(input);
    }
  }

  function updateNeighborhoodOther() {
    const show = neighborhoodSelect instanceof HTMLSelectElement && neighborhoodSelect.value === "Other";
    if (neighborhoodSelect instanceof HTMLSelectElement) neighborhoodSelect.setAttribute("aria-expanded", String(show));
    if (neighborhoodOther instanceof HTMLElement) neighborhoodOther.hidden = !show;
    if (neighborhoodOtherInput instanceof HTMLInputElement) {
      neighborhoodOtherInput.disabled = !show;
      neighborhoodOtherInput.required = show;
      if (!show) clearFieldError(neighborhoodOtherInput);
    }
  }

  function updateRadioOther(name) {
    const selected = builderForm?.querySelector(`input[name="${name}"]:checked`);
    const field = builderForm?.querySelector(`[data-radio-other-field="${name}"]`);
    const input = builderForm?.querySelector(`#${name}Other`);
    const show = selected instanceof HTMLInputElement && selected.value === "Other";
    builderForm?.querySelectorAll(`input[name="${name}"]`).forEach((radio) => {
      if (radio instanceof HTMLInputElement && radio.value === "Other") radio.setAttribute("aria-expanded", String(show));
    });
    if (field instanceof HTMLElement) field.hidden = !show;
    if (input instanceof HTMLInputElement) {
      input.disabled = !show;
      input.required = show;
      if (!show) clearFieldError(input);
    }
  }

  function updateExtraService() {
    const show = extraServiceToggle instanceof HTMLInputElement && extraServiceToggle.checked;
    if (extraServiceToggle instanceof HTMLInputElement) extraServiceToggle.setAttribute("aria-expanded", String(show));
    if (extraServiceRequired instanceof HTMLInputElement) extraServiceRequired.value = show ? "Yes" : "No";
    if (extraServiceDetails instanceof HTMLElement) extraServiceDetails.hidden = !show;
    if (extraServiceDetailsInput instanceof HTMLTextAreaElement) {
      extraServiceDetailsInput.disabled = !show;
      extraServiceDetailsInput.required = show;
      if (!show) clearFieldError(extraServiceDetailsInput);
    }
  }

  function syncEnhancedSelect(select) {
    if (!(select instanceof HTMLSelectElement)) return;
    const enhanced = enhancedSelects.get(select);
    if (!enhanced) return;
    if (select.disabled) enhanced.disable();
    else enhanced.enable();
  }

  function updateOtherDateField(config) {
    const show = config.container instanceof HTMLElement && !config.container.hidden && config.select instanceof HTMLSelectElement && config.select.value === "other";
    setContainerVisible(config.otherDateField, show);
    if (config.customDateInput instanceof HTMLInputElement) config.customDateInput.required = show;
  }

  function updateTimingSchedule() {
    const selectedServices = new Set(checkedValues("service"));
    const activeSchedules = scheduleConfigs.filter((config) => selectedServices.has(config.service));
    if (reverseSukkosSchedule instanceof HTMLElement) reverseSukkosSchedule.hidden = activeSchedules.length === 0;
    scheduleConfigs.forEach((config) => {
      const visible = activeSchedules.includes(config);
      setContainerVisible(config.container, visible);
      if (config.select instanceof HTMLSelectElement) {
        config.select.required = visible;
        syncEnhancedSelect(config.select);
      }
      updateOtherDateField(config);
    });
  }

  function renderSelectedPhotos() {
    if (!(selectedPhotos instanceof HTMLElement) || !(sitePhotos instanceof HTMLInputElement)) return;
    selectedPhotos.replaceChildren();
    const files = sitePhotos.files ? Array.from(sitePhotos.files) : [];
    files.forEach((file, index) => {
      const row = document.createElement("div");
      row.className = "selected-photo";
      const name = document.createElement("span");
      name.textContent = file.name;
      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Remove";
      remove.setAttribute("aria-label", `Remove ${file.name}`);
      remove.addEventListener("click", () => {
        const transfer = new DataTransfer();
        files.forEach((item, itemIndex) => {
          if (itemIndex !== index) transfer.items.add(item);
        });
        sitePhotos.files = transfer.files;
        renderSelectedPhotos();
      });
      row.append(name, remove);
      selectedPhotos.append(row);
    });
  }

  function validatePhotos() {
    if (!(sitePhotos instanceof HTMLInputElement)) return true;
    clearFieldError(sitePhotos);
    const photos = sitePhotos.files ? Array.from(sitePhotos.files) : [];
    if (photos.length > 3) {
      showFieldError(sitePhotos, "Choose no more than three photos.");
      return false;
    }
    if (photos.some((photo) => photo.size > 10 * 1024 * 1024)) {
      showFieldError(sitePhotos, "Each photo must be no larger than 10 MB.");
      return false;
    }
    return true;
  }

  function controlsForStep(stepNumber) {
    const step = steps[stepNumber - 1];
    if (!(step instanceof HTMLElement)) return [];
    return Array.from(step.querySelectorAll("input, select, textarea")).filter(
      (control) => control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement,
    );
  }

  function validateStep(stepNumber, focusFirst = true) {
    const invalid = [];
    controlsForStep(stepNumber).forEach((control) => {
      if (control.disabled || control.type === "hidden" || control.type === "radio" || control.type === "checkbox" || control.type === "file") return;
      clearFieldError(control);
      if (!control.checkValidity()) {
        showFieldError(control);
        invalid.push(control);
      }
    });

    ["service", "sukkahType", "schach"].forEach((name) => {
      const fieldset = steps[stepNumber - 1]?.querySelector(`[data-required-group="${name}"]`);
      if (!fieldset) return;
      const missing = checkedValues(name).length === 0;
      setGroupError(name, missing ? (name === "service" ? "Select at least one service." : "Choose one option.") : "");
      if (missing) {
        const first = fieldset.querySelector("input");
        if (first instanceof HTMLInputElement) invalid.push(first);
      }
    });

    if (stepNumber === 4 && !validatePhotos() && sitePhotos instanceof HTMLInputElement) invalid.push(sitePhotos);
    if (stepNumber === 5 && buildDateInput instanceof HTMLInputElement && !buildDateInput.value) {
      showFieldError(buildDateInput, "Choose an installation date.");
      invalid.push(buildDateInput._flatpickr?.altInput || buildDateInput);
    }

    if (invalid.length > 0 && focusFirst) {
      const first = invalid[0];
      if (first instanceof HTMLElement) {
        first.focus({ preventScroll: true });
        first.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "center" });
      }
    }
    return invalid.length === 0;
  }

  function setActiveStep(stepNumber, options = {}) {
    activeStep = Math.min(Math.max(Number(stepNumber) || 1, 1), steps.length);
    steps.forEach((step, index) => {
      if (step instanceof HTMLElement) {
        step.hidden = index + 1 !== activeStep;
        step.toggleAttribute("aria-current", index + 1 === activeStep);
      }
    });
    const step = steps[activeStep - 1];
    if (activeStep === steps.length) updateReview();
    if (progressBar instanceof HTMLElement) progressBar.style.width = `${(activeStep / steps.length) * 100}%`;
    if (progressTrack instanceof HTMLElement) {
      progressTrack.setAttribute("aria-valuenow", String(activeStep));
      progressTrack.setAttribute("aria-valuetext", `Step ${activeStep} of 6: ${stepNames[activeStep - 1]}`);
    }
    if (currentStep instanceof HTMLElement) currentStep.textContent = String(activeStep);
    if (currentLabel instanceof HTMLElement) currentLabel.textContent = stepNames[activeStep - 1];
    if (backButton instanceof HTMLButtonElement) backButton.hidden = activeStep === 1;
    if (nextButton instanceof HTMLButtonElement) nextButton.hidden = activeStep === steps.length;
    if (submitButton instanceof HTMLButtonElement) submitButton.hidden = activeStep !== steps.length;
    if (submitStatus instanceof HTMLElement && !["success", "error"].includes(submitStatus.dataset.state || "")) {
      submitStatus.hidden = activeStep !== steps.length;
    }
    if (options.scroll) step?.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "start" });
    if (options.focusHeading) {
      const heading = step?.querySelector("h3");
      if (heading instanceof HTMLElement) {
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      }
    }
  }

  const atLocalNoon = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate(), 12);
  const addCalendarDays = (date, days) => {
    const result = atLocalNoon(date);
    result.setDate(result.getDate() + days);
    return result;
  };
  const toIsoDate = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  const hebrewDateFormatter = new Intl.DateTimeFormat("en-US-u-ca-hebrew", { day: "numeric", month: "long", year: "numeric" });
  const fullDateFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
  const shortDateFormatter = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" });

  function findNextSukkos() {
    const today = atLocalNoon(new Date());
    for (let offset = 0; offset <= 500; offset += 1) {
      const candidate = addCalendarDays(today, offset);
      const parts = hebrewDateFormatter.formatToParts(candidate);
      const day = Number(parts.find((part) => part.type === "day")?.value || 0);
      const month = parts.find((part) => part.type === "month")?.value || "";
      if (day === 15 && /^Tishr/i.test(month)) return candidate;
    }
    return null;
  }

  function initializeHolidayDates() {
    const sukkosDate = findNextSukkos();
    if (!(sukkosDate instanceof Date)) return;
    const motzeiYomKippur = addCalendarDays(sukkosDate, -5);
    const erevSukkos = addCalendarDays(sukkosDate, -1);
    const customMinimum = addCalendarDays(sukkosDate, -30);
    const availableDates = [];
    for (let date = motzeiYomKippur; date <= erevSukkos; date = addCalendarDays(date, 1)) availableDates.push(date);

    scheduleConfigs.forEach((config) => {
      if (!(config.select instanceof HTMLSelectElement) || !(config.customDateInput instanceof HTMLInputElement)) return;
      const otherOption = config.select.querySelector("[data-other-date-option]");
      [...availableDates].reverse().forEach((date) => {
        const option = document.createElement("option");
        option.value = toIsoDate(date);
        option.textContent = date.getTime() === erevSukkos.getTime()
          ? `Erev Sukkos - ${fullDateFormatter.format(date)}`
          : date.getTime() === motzeiYomKippur.getTime()
            ? `Motzei Yom Kippur - ${fullDateFormatter.format(date).replace(",", " evening,")}`
            : fullDateFormatter.format(date);
        config.select.insertBefore(option, otherOption);
      });
      config.customDateInput.min = toIsoDate(customMinimum);
      config.customDateInput.max = toIsoDate(erevSukkos);
      if (config.customDateRange instanceof HTMLElement) {
        config.customDateRange.textContent = `Choose a date from ${shortDateFormatter.format(customMinimum)} through ${shortDateFormatter.format(erevSukkos)}.`;
      }
      if (typeof window.flatpickr === "function") {
        window.flatpickr(config.customDateInput, {
          altInput: true,
          altInputClass: "builder-date-input",
          altFormat: "F j, Y",
          dateFormat: "Y-m-d",
          minDate: config.customDateInput.min,
          maxDate: config.customDateInput.max,
          disableMobile: false,
          monthSelectorType: "static",
          position: "below left",
        });
      }
      if (typeof window.Choices === "function") {
        enhancedSelects.set(config.select, new window.Choices(config.select, {
          allowHTML: false,
          itemSelectText: "",
          searchEnabled: false,
          shouldSort: false,
        }));
      }
    });
  }

  if (typeof window.flatpickr === "function" && buildDateInput instanceof HTMLInputElement) {
    const picker = window.flatpickr(buildDateInput, {
      altInput: true,
      altInputClass: "builder-date-input",
      altFormat: "F j, Y",
      dateFormat: "Y-m-d",
      minDate: "today",
      disableMobile: false,
      monthSelectorType: "static",
      position: "below left",
    });
    picker.altInput?.setAttribute("aria-label", "Preferred installation date");
    picker.altInput?.setAttribute("placeholder", "Select a date");
  }

  initializeHolidayDates();

  sizeSliders.forEach((slider) => {
    const update = () => {
      if (!(slider instanceof HTMLInputElement)) return;
      const output = document.querySelector(`[data-size-output="${slider.id}"]`);
      const number = output?.querySelector("[data-size-number]");
      if (number instanceof HTMLElement) number.textContent = slider.value;
      if (output instanceof HTMLOutputElement) output.setAttribute("aria-label", `${slider.value} feet`);
      const progress = ((Number(slider.value) - Number(slider.min)) / (Number(slider.max) - Number(slider.min))) * 100;
      slider.style.setProperty("--slider-progress", `${progress}%`);
    };
    slider.addEventListener("input", update);
    update();
  });

  neighborhoodSelect?.addEventListener("change", updateNeighborhoodOther);
  serviceOtherToggle?.addEventListener("change", () => updateConditionalField(serviceOtherToggle, serviceOtherField, serviceOtherInput));
  addOnOtherToggle?.addEventListener("change", () => updateConditionalField(addOnOtherToggle, addOnOtherField, addOnOtherInput));
  ["sukkahType", "schach"].forEach((name) => {
    builderForm?.querySelectorAll(`input[name="${name}"]`).forEach((input) => input.addEventListener("change", () => updateRadioOther(name)));
    updateRadioOther(name);
  });
  extraServiceToggle?.addEventListener("change", updateExtraService);
  serviceInputs.forEach((input) => input.addEventListener("change", updateTimingSchedule));
  scheduleConfigs.forEach((config) => config.select?.addEventListener("change", () => updateOtherDateField(config)));
  sitePhotos?.addEventListener("change", () => {
    validatePhotos();
    renderSelectedPhotos();
  });

  updateNeighborhoodOther();
  updateConditionalField(serviceOtherToggle, serviceOtherField, serviceOtherInput);
  updateConditionalField(addOnOtherToggle, addOnOtherField, addOnOtherInput);
  updateExtraService();
  updateTimingSchedule();
  renderSelectedPhotos();

  builderForm?.querySelectorAll("input, select, textarea").forEach((field) => {
    field.addEventListener("input", () => clearFieldError(field));
    field.addEventListener("change", () => {
      clearFieldError(field);
      if (field instanceof HTMLInputElement && ["service", "sukkahType", "schach"].includes(field.name)) setGroupError(field.name, "");
    });
  });

  nextButton?.addEventListener("click", () => {
    if (!validateStep(activeStep)) return;
    setActiveStep(activeStep + 1, { scroll: true, focusHeading: true });
  });
  backButton?.addEventListener("click", () => setActiveStep(activeStep - 1, { scroll: true, focusHeading: true }));
  editButtons.forEach((button) => button.addEventListener("click", () => {
    if (button instanceof HTMLButtonElement) setActiveStep(Number(button.dataset.editStep), { scroll: true, focusHeading: true });
  }));
  setActiveStep(1);

  builderForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(builderForm instanceof HTMLFormElement)) return;
    const invalidStep = steps.findIndex((_, index) => !validateStep(index + 1, false));
    if (invalidStep >= 0) {
      setActiveStep(invalidStep + 1, { scroll: true });
      validateStep(invalidStep + 1);
      return;
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
    }
    if (submitLabel instanceof HTMLElement) submitLabel.textContent = "Sending request...";
    builderForm.setAttribute("aria-busy", "true");
    if (submitStatus instanceof HTMLElement) {
      submitStatus.hidden = false;
      submitStatus.textContent = sitePhotos instanceof HTMLInputElement && sitePhotos.files?.length
        ? "Uploading your photos and sending your request..."
        : "Sending your request...";
      submitStatus.dataset.state = "working";
    }

    try {
      const response = await fetch("/api/sukkah-submissions", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(builderForm),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) throw new Error(result?.message || "We could not send your request.");

      builderForm.removeAttribute("aria-busy");
      if (progressRegion instanceof HTMLElement) progressRegion.hidden = true;
      if (wizardCard instanceof HTMLElement) wizardCard.hidden = true;
      if (successMessage instanceof HTMLElement && result?.message) successMessage.textContent = result.message;
      if (successPanel instanceof HTMLElement) {
        successPanel.hidden = false;
        successPanel.focus({ preventScroll: true });
        successPanel.scrollIntoView({ behavior: reducedMotion.matches ? "auto" : "smooth", block: "center" });
      }
    } catch (error) {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
      }
      if (submitLabel instanceof HTMLElement) submitLabel.textContent = "Try again";
      builderForm.removeAttribute("aria-busy");
      if (submitStatus instanceof HTMLElement) {
        submitStatus.hidden = false;
        submitStatus.textContent = error instanceof Error ? error.message : "We could not send your request. Please try again or call (347) 454-2282.";
        submitStatus.dataset.state = "error";
      }
    }
  });
</script>

