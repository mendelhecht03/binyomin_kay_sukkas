---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormHeading from "../../components/FormHeading.astro";
import Field from "../../components/Field.astro";
import Choices from "../../components/Choices.astro";

const services = ["Bring out of storage", "Build", "Take down"];
const neighborhoods = [
  "Crown Heights",
  "East Flatbush",
  "Remsen Village",
  "Flatbush",
  "Boro Park",
  "Williamsburg",
  "Park Slope",
  "Manhattan",
  "Queens",
  "Monsey",
  "New Haven",
  "South Florida",
];
const sukkahTypes = ["Canvas", "Canvas Bingo", "Snap / panel", "Wood boards with bolts", "Schach and beams only"];
const schachTypes = ["Bamboo mat", "Bamboo sticks", "Evergreen or other branches"];
const addOns = ["Put up lights", "Pressure wash the area the day before", "Bamboo mat", "Evergreen"];
---

<BaseLayout title="Sukka Builder" description="Share your sukkah setup, location, timing, and site details with Benyamin Kay Sukkas.">
  <section class="builder-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Sukka Builder</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Sukka Builder</p>
          <h1>Your sukkah starts with a good plan.</h1>
          <p class="lead">Please fill out the form below and we will get back to you with a custom quote</p>
          <p class="builder-notice"><span aria-hidden="true"></span>Online submission is not connected yet.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="form-section" aria-labelledby="form-heading">
    <div class="shell form-shell">
      <div class="form-intro">
        <div><p class="eyebrow">Project details</p><h2 id="form-heading">Tell us about your sukkah</h2></div>
      </div>

      <div class="form-layout">
        <aside class="form-rail" aria-label="Form sections">
          <p class="rail-title">Your progress</p>
          <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
          <nav>
            <a href="#contact-details" data-step-link="1"><span>1</span> Contact</a>
            <a href="#service-details" data-step-link="2"><span>2</span> Service</a>
            <a href="#sukkah-details" data-step-link="3"><span>3</span> Sukkah</a>
            <a href="#site-details" data-step-link="4"><span>4</span> Site</a>
            <a href="#timing-details" data-step-link="5"><span>5</span> Timing</a>
            <a href="#final-details" data-step-link="6"><span>6</span> Final details</a>
          </nav>
          <p class="rail-help">Need help?<br /><a href="tel:+13474542282">Call (347) 454-2282</a></p>
        </aside>

        <form class="builder-form" data-builder-form>
          <section id="contact-details" class="form-card form-group" aria-labelledby="contact-heading" data-form-step="1">
            <FormHeading icon="contact" eyebrow="Contact details" heading="How can we reach you?" id="contact-heading" />
            <p class="section-copy">We’ll only use these details to follow up about your sukkah.</p>
            <div class="form-grid">
              <Field id="firstName" label="First name" autocomplete="given-name" required />
              <Field id="lastName" label="Last name" autocomplete="family-name" required />
              <Field id="phone" label="Phone number" type="tel" autocomplete="tel" required />
              <Field id="email" label="Email address" type="email" autocomplete="email" required />
            </div>
          </section>

          <section id="service-details" class="form-card form-group" aria-labelledby="service-heading" data-form-step="2">
            <FormHeading icon="location" eyebrow="Location and service" heading="Where are you, and what do you need?" id="service-heading" />
            <div class="address-field">
              <label for="project-address">Project address <span class="required-mark">*</span></label>
              <input
                id="project-address"
                name="address"
                type="text"
                autocomplete="street-address"
                required
              />
            </div>
            <Choices legend="Neighborhood" name="neighborhood" options={neighborhoods} type="radio" required requiredHint otherLabel="Other neighborhood" />
            <Choices legend="Requested work" name="service" options={services} type="checkbox" required requiredHint otherLabel="Other requested service" />
          </section>

          <section id="sukkah-details" class="form-card form-group" aria-labelledby="details-heading" data-form-step="3">
            <FormHeading icon="sukkah" eyebrow="Sukkah details" heading="Tell us what you have" id="details-heading" />
            <fieldset class="size-field">
              <legend>Estimated size <span class="required-mark">*</span></legend>
              <p id="size-hint" class="field-hint">An estimate is fine. Adjust both sliders from 0 to 30 feet.</p>
              <div class="size-grid">
                <div class="size-control">
                  <div class="size-label-row">
                    <label for="estimated-width">Width</label>
                    <output for="estimated-width" data-size-output="estimated-width">10 ft</output>
                  </div>
                  <input id="estimated-width" name="estimatedWidth" type="range" min="0" max="30" step="1" value="10" aria-describedby="size-hint" data-size-slider />
                </div>
                <div class="size-control">
                  <div class="size-label-row">
                    <label for="estimated-length">Length</label>
                    <output for="estimated-length" data-size-output="estimated-length">10 ft</output>
                  </div>
                  <input id="estimated-length" name="estimatedLength" type="range" min="0" max="30" step="1" value="10" aria-describedby="size-hint" data-size-slider />
                </div>
              </div>
            </fieldset>
            <Choices legend="Sukkah type" name="sukkahType" options={sukkahTypes} type="radio" required requiredHint otherLabel="Other sukkah type" />
            <Choices legend="Schach type" name="schach" options={schachTypes} type="radio" required requiredHint otherLabel="Other schach type" />
            <Choices legend="Add-ons" name="addOns" options={addOns} type="checkbox" otherLabel="Other add-on" />
          </section>

          <section id="site-details" class="form-card form-group" aria-labelledby="site-heading" data-form-step="4">
            <FormHeading icon="site" eyebrow="Site details" heading="Help us understand the space" id="site-heading" />
            <div class="field">
              <label for="site-description">Where will the sukkah be built?</label>
              <textarea id="site-description" name="siteDescription"></textarea>
            </div>
            <div class="upload-field">
              <div class="upload-icon" aria-hidden="true">↑</div>
              <div><label for="site-photo">Add a photo of the area</label><p>Optional · JPG, PNG, or HEIC · Maximum 10 MB</p></div>
              <input id="site-photo" name="sitePhoto" type="file" accept="image/*" />
            </div>
          </section>

          <section id="timing-details" class="form-card form-group" aria-labelledby="timing-heading" data-form-step="5">
            <FormHeading icon="timing" eyebrow="Timing" heading="When should we come?" id="timing-heading" />
            <p class="section-copy">Choose your preferred dates. We’ll confirm availability when we follow up.</p>
            <div class="date-grid">
              <div class="field"><label for="build-date">Preferred build date <span class="required-mark">*</span></label><input id="build-date" name="buildDate" type="date" required /></div>
              <div class="field"><label for="takedown-date">Preferred takedown date <span class="required-mark">*</span></label><input id="takedown-date" name="takedownDate" type="date" required /></div>
            </div>
            <div class="field"><label for="timing-notes">Timing notes</label><input id="timing-notes" name="timingNotes" placeholder="For example, Motzei Yom Kippur or mornings only" /></div>
          </section>

          <section id="final-details" class="form-card form-group" aria-labelledby="final-heading" data-form-step="6">
            <FormHeading icon="final" eyebrow="Final details" heading="Anything else we should know?" id="final-heading" />
            <div class="field"><label for="referral">How did you hear about us? <span class="required-mark">*</span></label><p class="field-hint">This helps us understand which advertising is useful.</p><input id="referral" name="referral" required /></div>
            <div class="field"><label for="comments">Comments or questions</label><textarea id="comments" name="comments" placeholder="Add any details that did not fit above."></textarea></div>
          </section>

          <div class="review-panel">
            <div class="review-copy"><p class="eyebrow">Ready to review?</p><h3>Check that every required detail is complete.</h3><p>This page currently checks the form without sending or saving customer information.</p></div>
            <div class="submit-actions"><button class="button" type="submit">Check details</button><button class="clear-button" type="reset">Clear form</button></div>
            <p class="form-status" data-builder-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("[data-builder-form]");
  const status = document.querySelector("[data-builder-status]");
  const progressBar = document.querySelector("[data-progress-bar]");
  const stepLinks = Array.from(document.querySelectorAll("[data-step-link]"));
  const steps = Array.from(document.querySelectorAll("[data-form-step]"));
  const sizeSliders = Array.from(document.querySelectorAll("[data-size-slider]"));

  const updateSizeValue = (slider) => {
    if (!(slider instanceof HTMLInputElement)) return;
    const output = document.querySelector(`[data-size-output="${slider.id}"]`);
    if (output instanceof HTMLOutputElement) output.textContent = `${slider.value} ft`;
  };

  sizeSliders.forEach((slider) => {
    updateSizeValue(slider);
    slider.addEventListener("input", () => updateSizeValue(slider));
  });

  const setActiveStep = (stepNumber) => {
    stepLinks.forEach((link) => link.toggleAttribute("data-active", link.getAttribute("data-step-link") === stepNumber));
    if (progressBar instanceof HTMLElement) progressBar.style.width = `${(Number(stepNumber) / steps.length) * 100}%`;
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible instanceof IntersectionObserverEntry && visible.target instanceof HTMLElement) setActiveStep(visible.target.dataset.formStep ?? "1");
    }, { rootMargin: "-18% 0px -60%", threshold: [0.1, 0.35] });
    steps.forEach((step) => observer.observe(step));
  }
  setActiveStep("1");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
    const serviceCount = form.querySelectorAll('input[name="service"]:checked').length;
    const sukkahTypeCount = form.querySelectorAll('input[name="sukkahType"]:checked').length;
    const schachCount = form.querySelectorAll('input[name="schach"]:checked').length;
    const photo = form.querySelector('input[type="file"]');
    if (!serviceCount || !sukkahTypeCount || !schachCount) {
      status.dataset.state = "error";
      status.textContent = "Please choose at least one requested service, one sukkah type, and one schach type.";
      return;
    }
    if (photo instanceof HTMLInputElement && photo.files?.[0] && photo.files[0].size > 10 * 1024 * 1024) {
      status.dataset.state = "error";
      status.textContent = "Please choose a photo smaller than 10 MB.";
      return;
    }
    status.dataset.state = "success";
    status.textContent = "All required details look complete. Online submission is not connected yet, so nothing was sent or saved.";
    status.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  form?.addEventListener("reset", () => {
    if (status instanceof HTMLElement) { status.textContent = ""; status.removeAttribute("data-state"); }
    requestAnimationFrame(() => sizeSliders.forEach(updateSizeValue));
  });
</script>

<style is:global>
  @font-face{font-family:"Inter Variable";src:url("/assets/fonts/inter-variable.woff2") format("woff2");font-style:normal;font-weight:100 900;font-display:swap}
  .builder-hero{position:relative;overflow:hidden;padding-block:clamp(3rem,7vw,6.5rem);background:linear-gradient(135deg,#f8f4ea 0%,#f3ecdd 55%,#e9efe9 100%)}
  .builder-hero::after{position:absolute;right:-9rem;bottom:-15rem;width:34rem;height:34rem;border:1px solid rgba(23,63,52,.12);border-radius:50%;box-shadow:0 0 0 5rem rgba(255,255,255,.16),0 0 0 10rem rgba(255,255,255,.12);content:"";pointer-events:none}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,900px);padding-top:clamp(2.5rem,5vw,4.5rem)}
  .hero-copy h1{max-width:900px;font-size:clamp(3.2rem,7vw,6.25rem)}.hero-copy .lead{max-width:700px;font-size:clamp(1.1rem,2vw,1.3rem)}
  .builder-notice{display:inline-flex;gap:.6rem;align-items:center;margin:1.75rem 0 0;color:var(--ink-500);font-size:.82rem}.builder-notice span{flex:0 0 .45rem;width:.45rem;height:.45rem;border-radius:50%;background:var(--wood-500);box-shadow:0 0 0 4px rgba(200,134,67,.12)}
  .form-section{padding-block:clamp(4rem,8vw,7rem);background:#fdfbf6}.form-shell{max-width:1180px}.form-intro{display:grid;grid-template-columns:1fr;margin-bottom:2.25rem;padding-bottom:1.75rem;border-bottom:1px solid var(--border)}.form-intro h2{margin-bottom:0}
  .form-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:clamp(2rem,5vw,4.5rem);align-items:start}.form-rail{position:sticky;top:6.5rem;padding:1.25rem 0}.rail-title{margin-bottom:.65rem;color:var(--forest-900);font-size:.78rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.progress-track{height:4px;margin-bottom:1.25rem;overflow:hidden;border-radius:99px;background:var(--cream-200)}.progress-track span{display:block;width:16.66%;height:100%;border-radius:inherit;background:var(--wood-500);transition:width 240ms ease}.form-rail nav{display:grid;gap:.15rem}.form-rail nav a{display:flex;gap:.8rem;align-items:center;padding:.55rem 0;color:var(--ink-500);text-decoration:none;transition:color 160ms ease,transform 160ms ease}.form-rail nav a span{color:var(--wood-600);font-size:.72rem;font-weight:850;letter-spacing:.08em}.form-rail nav a[data-active]{color:var(--forest-900);font-weight:800;transform:translateX(4px)}.rail-help{margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border);color:var(--ink-500);font-size:.84rem}.rail-help a{color:var(--forest-800);font-weight:800}
  .builder-form{display:grid;gap:1.25rem;min-width:0}.form-card{scroll-margin-top:7rem;padding:clamp(1.5rem,4vw,2.6rem);border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 10px 35px rgba(16,45,37,.055)}.form-group{display:grid;gap:1.8rem}.form-group-heading{display:grid;grid-template-columns:3rem 1fr;gap:1rem;align-items:center}.form-group-heading h3,.form-group-heading .eyebrow{margin-bottom:0}.form-group-heading h3{font-size:clamp(1.65rem,3vw,2.25rem)}.step-icon{display:grid;width:3rem;height:3rem;place-items:center;border:1px solid rgba(200,134,67,.4);border-radius:12px;color:var(--forest-900);background:#fbf2e5}.step-icon svg{width:1.6rem;height:1.6rem}.section-copy{margin:-.65rem 0 0 4rem;color:var(--ink-500);font-size:.92rem}
  .builder-form .field{gap:.5rem}.builder-form label,.builder-form legend{font-family:"Inter Variable",Inter,Arial,sans-serif;font-size:.94rem;font-weight:600;letter-spacing:-.005em}.builder-form input,.builder-form textarea{min-height:54px;border-color:rgba(29,41,37,.2);border-radius:10px;background:#fff}.builder-form input:not([type="radio"]):not([type="checkbox"]):focus,.builder-form textarea:focus{border-color:var(--forest-700);box-shadow:0 0 0 4px rgba(45,104,85,.1)}.builder-form input::placeholder,.builder-form textarea::placeholder{color:#89938f;font-weight:400}.required-mark{color:#b23a2b;font-weight:700}
  .address-field{display:grid;gap:.5rem;max-width:720px;padding:1.15rem;border:1px solid var(--border);border-radius:12px;background:#f9fbf9}.address-field>label{font-size:1rem}
  .form-grid,.date-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem}.short-field{max-width:520px}.builder-form fieldset{display:grid;gap:.8rem;min-width:0;margin:0;padding:0;border:0}.builder-form legend{margin-bottom:.25rem;font-size:1rem}.choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.choice-stack{display:grid;gap:.65rem}.builder-form .choice-card{display:flex;gap:.65rem;align-items:center;min-height:52px;padding:.7rem .8rem;border:1px solid rgba(29,41,37,.16);border-radius:10px;background:#fff;cursor:pointer;font-family:"Inter Variable",Inter,Arial,sans-serif;font-weight:400;letter-spacing:-.01em;transition:border-color 160ms ease,background 160ms ease,box-shadow 160ms ease}.choice-card:hover{border-color:rgba(45,104,85,.45);background:#fbfdfb}.choice-card:has(input:checked){border-color:var(--forest-700);background:var(--forest-100);box-shadow:inset 0 0 0 1px var(--forest-700)}.choice-card:has(input[type="radio"]:checked){background:#fff}.choice-card input[type="radio"],.choice-card input[type="checkbox"]{flex:0 0 auto;width:1.05rem;min-height:1.05rem;height:1.05rem;margin:0;accent-color:var(--forest-700)}.choice-card span{line-height:1.35}.choice-other{flex-wrap:wrap}.choice-other>input:last-child{flex:1 1 135px;min-height:38px;padding:.5rem .65rem;background:white;font-family:"Inter Variable",Inter,Arial,sans-serif;font-weight:400}.field-hint{font-size:.82rem}
  .size-field{max-width:760px}.size-field>.field-hint{margin:-.2rem 0 .35rem}.size-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.5rem,4vw,3rem)}.size-control{display:grid;gap:.45rem;padding:.15rem 0 .25rem}.size-label-row{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}.size-label-row output{color:var(--forest-800);font-size:.9rem;font-weight:850;font-variant-numeric:tabular-nums;text-align:right}.builder-form .size-control input[type="range"]{width:100%;min-height:28px;height:28px;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;accent-color:var(--forest-700)}.builder-form .size-control input[type="range"]:focus{border:0;box-shadow:none}
  .upload-field{display:grid;grid-template-columns:auto 1fr minmax(190px,auto);gap:1rem;align-items:center;padding:1.15rem;border:1px dashed rgba(45,104,85,.38);border-radius:12px;background:#f7faf7}.upload-icon{display:grid;width:2.65rem;height:2.65rem;place-items:center;border-radius:10px;color:var(--forest-800);background:var(--forest-100);font-size:1.25rem;font-weight:900}.upload-field label{display:block;margin-bottom:.15rem}.upload-field p{margin:0;color:var(--ink-500);font-size:.8rem}.upload-field input{min-height:auto;padding:.45rem;font-size:.82rem;background:white}
  .review-panel{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem 2rem;align-items:center;padding:clamp(1.6rem,4vw,2.4rem);border-radius:20px;color:white;background:linear-gradient(135deg,var(--forest-950),var(--forest-800));box-shadow:0 22px 55px rgba(16,45,37,.18)}.review-copy h3{margin-bottom:.5rem;color:white;font-size:clamp(1.6rem,3vw,2.1rem)}.review-copy p{max-width:620px;margin-bottom:0;color:rgba(255,255,255,.72)}.review-copy .eyebrow{margin-bottom:.45rem;color:#e5c28e}.submit-actions{display:flex;flex-wrap:wrap;gap:.75rem}.clear-button{min-height:48px;padding:.7rem 1rem;border:0;color:rgba(255,255,255,.75);background:transparent;font-weight:750;text-decoration:underline;text-underline-offset:4px}.review-panel .form-status{grid-column:1/-1;margin:0;color:#fff0bf}.review-panel .form-status[data-state="error"]{color:#ffd1cc}
  @media(max-width:950px){.form-layout{grid-template-columns:1fr}.form-rail{position:static;display:none}.choice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.builder-hero{padding-block:2.5rem 4rem}.form-intro,.form-grid,.date-grid,.size-grid,.review-panel{grid-template-columns:1fr}.form-intro{gap:.6rem}.choice-grid{grid-template-columns:1fr}.section-copy{margin-left:0}.upload-field{grid-template-columns:auto 1fr}.upload-field input{grid-column:1/-1;width:100%}.submit-actions{align-items:stretch;flex-direction:column}.submit-actions .button{width:100%}}
  @media(prefers-reduced-motion:reduce){.progress-track span,.form-rail nav a,.choice-card{transition:none}}
</style>
