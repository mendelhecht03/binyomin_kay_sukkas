---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormHeading from "../../components/FormHeading.astro";
import Field from "../../components/Field.astro";
import Choices from "../../components/Choices.astro";
import ProjectPathSelector from "../../components/ProjectPathSelector.astro";

const services = ["Bring out of storage", "Build", "Take down", "Bring to storage"];
const neighborhoods = [
  "Crown Heights",
  "East Flatbush",
  "Remsen Village",
  "Flatbush",
  "Boro Park",
  "Williamsburg",
  "Park Slope",
  "Manhattan",
  "Queens",
  "Monsey",
  "New Haven",
  "South Florida",
];
const states = [
  { code: "AL", name: "Alabama" },
  { code: "AK", name: "Alaska" },
  { code: "AZ", name: "Arizona" },
  { code: "AR", name: "Arkansas" },
  { code: "CA", name: "California" },
  { code: "CO", name: "Colorado" },
  { code: "CT", name: "Connecticut" },
  { code: "DE", name: "Delaware" },
  { code: "DC", name: "District of Columbia" },
  { code: "FL", name: "Florida" },
  { code: "GA", name: "Georgia" },
  { code: "HI", name: "Hawaii" },
  { code: "ID", name: "Idaho" },
  { code: "IL", name: "Illinois" },
  { code: "IN", name: "Indiana" },
  { code: "IA", name: "Iowa" },
  { code: "KS", name: "Kansas" },
  { code: "KY", name: "Kentucky" },
  { code: "LA", name: "Louisiana" },
  { code: "ME", name: "Maine" },
  { code: "MD", name: "Maryland" },
  { code: "MA", name: "Massachusetts" },
  { code: "MI", name: "Michigan" },
  { code: "MN", name: "Minnesota" },
  { code: "MS", name: "Mississippi" },
  { code: "MO", name: "Missouri" },
  { code: "MT", name: "Montana" },
  { code: "NE", name: "Nebraska" },
  { code: "NV", name: "Nevada" },
  { code: "NH", name: "New Hampshire" },
  { code: "NJ", name: "New Jersey" },
  { code: "NM", name: "New Mexico" },
  { code: "NY", name: "New York" },
  { code: "NC", name: "North Carolina" },
  { code: "ND", name: "North Dakota" },
  { code: "OH", name: "Ohio" },
  { code: "OK", name: "Oklahoma" },
  { code: "OR", name: "Oregon" },
  { code: "PA", name: "Pennsylvania" },
  { code: "RI", name: "Rhode Island" },
  { code: "SC", name: "South Carolina" },
  { code: "SD", name: "South Dakota" },
  { code: "TN", name: "Tennessee" },
  { code: "TX", name: "Texas" },
  { code: "UT", name: "Utah" },
  { code: "VT", name: "Vermont" },
  { code: "VA", name: "Virginia" },
  { code: "WA", name: "Washington" },
  { code: "WV", name: "West Virginia" },
  { code: "WI", name: "Wisconsin" },
  { code: "WY", name: "Wyoming" },
];
const sukkahTypes = ["Canvas", "Canvas Bingo", "Snap / panel", "Wood boards with bolts", "Schach and beams only"];
const schachTypes = ["Bamboo mat", "Bamboo sticks", "Evergreen"];
const addOns = ["Put up lights", "Pressure wash area day before", "Bamboo mat", "Evergreen"];
const fulfillmentMethods = ["I’ll pick it up", "Deliver it to me"];
const projectPaths = [
  {
    value: "I would like to buy",
    title: "I would like to buy",
    description: "Help me choose a new sukkah and plan the installation.",
  },
  {
    value: "I already have a sukkah",
    title: "I already have a sukkah",
    description: "Help me store, build, take down, or service my existing sukkah.",
  },
];
---

<BaseLayout title="Sukka Builder" description="Share your sukkah setup, location, timing, and site details with Benyamin Kay Sukkas.">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@11.2.3/public/assets/styles/choices.min.css" />
  </Fragment>
  <section class="builder-hero sukkah-hero-background">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Sukka Builder</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Sukka Builder</p>
          <h1>Your sukkah starts with a good plan.</h1>
          <p class="lead">Share the details below and we’ll follow up with a custom quote.</p>
          <p class="builder-notice">Your request will be sent securely to Benyamin.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="form-section" aria-labelledby="form-heading">
    <div class="shell form-shell">
      <div class="form-intro">
        <div>
          <p class="eyebrow">Project details</p>
          <h2 id="form-heading">Tell us about your sukkah</h2>
          <p>Choose a project path, then complete the six short sections. Required fields are marked with an asterisk.</p>
        </div>
      </div>

      <div class="form-layout">
        <aside class="form-rail" aria-label="Form sections">
          <p class="rail-title">Your progress</p>
          <div class="progress-track" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1"><span data-progress-bar></span></div>
          <p class="mobile-progress-label"><span data-current-step>1 of 7</span><strong data-current-label>Start</strong></p>
          <nav>
            <a href="#project-path" data-step-link="1"><span>1</span> Start</a>
            <a href="#contact-details" data-step-link="2"><span>2</span> Contact</a>
            <a href="#service-details" data-step-link="3"><span>3</span> Location</a>
            <a href="#sukkah-details" data-step-link="4"><span>4</span> Sukkah</a>
            <a href="#site-details" data-step-link="5"><span>5</span> Site</a>
            <a href="#timing-details" data-step-link="6"><span>6</span> Timing</a>
            <a href="#final-details" data-step-link="7"><span>7</span> Final details</a>
          </nav>
          <p class="rail-help">Need help?<br /><a href="tel:+13474542282">Call (347) 454-2282</a></p>
        </aside>

        <form class="builder-form" data-builder-form enctype="multipart/form-data">
          <div class="form-honeypot" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <section id="project-path" class="form-card form-group path-card" aria-labelledby="path-heading" data-form-step="1">
            <FormHeading icon="sukkah" eyebrow="Start here" heading="How can we help?" id="path-heading" />
            <ProjectPathSelector
              name="sukkahPlan"
              legend="Choose your project path"
              hint="We’ll tailor the remaining questions to your choice."
              hintId="branch-help"
              options={projectPaths}
              required
            />
            <div class="fulfillment-card" data-buy-only hidden>
              <Choices
                legend="How would you like to receive your sukkah?"
                name="fulfillmentMethod"
                options={fulfillmentMethods}
                type="radio"
                required
                requiredHint
              />
            </div>
          </section>

          <section id="contact-details" class="form-card form-group" aria-labelledby="contact-heading" data-form-step="2">
            <FormHeading icon="contact" eyebrow="Contact details" heading="How can we reach you?" id="contact-heading" />
            <p class="section-copy">We’ll only use these details to follow up about your sukkah.</p>
            <div class="form-grid contact-grid">
              <Field id="firstName" label="First name" autocomplete="given-name" required />
              <Field id="lastName" label="Last name" autocomplete="family-name" required />
              <Field id="phone" label="Phone number" type="tel" autocomplete="tel" required />
              <Field id="email" label="Email address" type="email" autocomplete="email" required />
            </div>
          </section>

          <section id="service-details" class="form-card form-group" aria-labelledby="service-heading" data-form-step="3">
            <FormHeading icon="location" eyebrow="Project location" heading="Where will the project be?" id="service-heading" />
            <div class="address-field" role="group" aria-label="Project address" aria-describedby="project-address-instruction">
              <p id="project-address-instruction" class="field-hint address-instruction">Enter the address where the sukkah will be used.</p>
              <div class="address-grid">
                <div class="field address-street">
                  <label for="address-line-1">Street address <span class="required-mark">*</span></label>
                  <input id="address-line-1" name="addressLine1" autocomplete="address-line1" required />
                </div>
                <div class="field address-city">
                  <label for="address-city">City <span class="required-mark">*</span></label>
                  <input id="address-city" name="city" autocomplete="address-level2" required />
                </div>
                <div class="field address-state">
                  <label for="address-state">State <span class="required-mark">*</span></label>
                  <select id="address-state" name="state" autocomplete="address-level1" required>
                    <option value="">Select state</option>
                    {states.map((state) => <option value={state.code}>{state.name}</option>)}
                  </select>
                </div>
                <div class="field address-postal">
                  <label for="address-postal">Zip Code <span class="required-mark">*</span></label>
                  <input id="address-postal" name="postalCode" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" size="10" maxlength="10" required />
                </div>
              </div>
            </div>
            <Choices legend="Neighborhood" name="neighborhood" options={neighborhoods} type="radio" required requiredHint otherLabel="Other neighborhood" />
            <div data-existing-only hidden>
              <Choices legend="Requested work" name="service" options={services} type="checkbox" required requiredHint otherLabel="Other requested service" />
            </div>
          </section>

          <section id="sukkah-details" class="form-card form-group" aria-labelledby="details-heading" data-form-step="4">
            <FormHeading icon="sukkah" eyebrow="Sukkah details" heading="Tell us about your sukkah" id="details-heading" />
            <fieldset class="size-field">
              <legend>Estimated size <span class="required-mark">*</span></legend>
              <p id="size-hint" class="field-hint">An estimate is fine. Adjust both sliders from 0 to 30 feet.</p>
              <div class="size-grid">
                <div class="size-control">
                  <div class="size-label-row">
                    <label for="estimated-width">Width</label>
                  </div>
                  <input id="estimated-width" name="estimatedWidth" type="range" min="0" max="30" step="1" value="10" aria-describedby="size-hint" data-size-slider />
                  <output for="estimated-width" aria-label="10 feet" data-size-output="estimated-width"><span data-size-number>10</span><span class="size-unit">ft</span></output>
                </div>
                <div class="size-control">
                  <div class="size-label-row">
                    <label for="estimated-length">Length</label>
                  </div>
                  <input id="estimated-length" name="estimatedLength" type="range" min="0" max="30" step="1" value="10" aria-describedby="size-hint" data-size-slider />
                  <output for="estimated-length" aria-label="10 feet" data-size-output="estimated-length"><span data-size-number>10</span><span class="size-unit">ft</span></output>
                </div>
              </div>
            </fieldset>
            <Choices legend="Sukkah type" name="sukkahType" options={sukkahTypes} type="radio" required requiredHint otherLabel="Other sukkah type" />
            <Choices legend="Schach type" name="schach" options={schachTypes} type="radio" required requiredHint otherLabel="Other schach type" />
            <Choices legend="Add-ons" name="addOns" options={addOns} type="checkbox" otherLabel="Other add-on" />
          </section>

          <section id="site-details" class="form-card form-group" aria-labelledby="site-heading" data-form-step="5">
            <FormHeading icon="site" eyebrow="Site details" heading="Help us understand the space" id="site-heading" />
            <div class="field">
              <label for="site-description">Where will the sukkah be built?</label>
              <textarea id="site-description" name="siteDescription"></textarea>
            </div>
            <div class="upload-field">
              <div class="upload-icon" aria-hidden="true">↑</div>
              <div><label for="site-photos">Add up to 3 photos of the area</label><p>Optional. JPG, PNG, or HEIC. 10 MB per photo.</p></div>
              <input id="site-photos" name="sitePhotos" type="file" accept=".jpg,.jpeg,.png,.heic,.heif,image/jpeg,image/png,image/heic,image/heif" multiple />
            </div>
          </section>

          <section id="timing-details" class="form-card form-group" aria-labelledby="timing-heading" data-form-step="6">
            <FormHeading icon="timing" eyebrow="Timing" heading="When should we come?" id="timing-heading" />
            <div data-purchase-timing>
              <p class="section-copy" data-timing-copy>Choose your preferred installation date. We’ll confirm availability when we follow up.</p>
              <div class="date-grid" data-date-grid data-single-date>
                <div class="field"><label for="build-date"><span data-build-date-label>Preferred installation date</span> <span class="required-mark">*</span></label><div class="date-control"><input id="build-date" name="buildDate" type="date" required /></div></div>
              </div>
            </div>
            <div class="conditional-schedule" data-pre-sukkos-schedule hidden>
              <p class="section-copy">Choose a preferred time from Motzei Yom Kippur through Erev Sukkos.</p>
              <div class="schedule-window">
                <div class="field">
                  <label for="pre-sukkos-date">Preferred day <span class="required-mark">*</span></label>
                  <select id="pre-sukkos-date" name="preSukkosDate" required data-holiday-date-select data-date-order="forward">
                    <option value="">Choose a date</option>
                    <option value="other" data-other-date-option>Other date</option>
                  </select>
                </div>
                <div class="field" data-other-date-field hidden>
                  <label for="custom-service-date">Choose another date <span class="required-mark">*</span></label>
                  <p id="custom-service-date-hint" class="field-hint" data-custom-date-range>Choose a date within the 30 days before Sukkos.</p>
                  <div class="date-control"><input id="custom-service-date" name="customServiceDate" type="date" aria-describedby="custom-service-date-hint" /></div>
                </div>
              </div>
            </div>
            <div class="conditional-schedule" data-reverse-sukkos-schedule hidden>
              <p class="section-copy">Choose each service day, starting with Erev Sukkos and working back toward Motzei Yom Kippur.</p>
              <div class="schedule-window schedule-window-grid">
                <div class="service-schedule" data-service-schedule="Take down" hidden>
                  <div class="field">
                    <label for="take-down-date">Take-down day <span class="required-mark">*</span></label>
                    <select id="take-down-date" name="takeDownDate" data-holiday-date-select data-date-order="reverse">
                      <option value="">Choose a date</option>
                      <option value="other" data-other-date-option>Other date</option>
                    </select>
                  </div>
                  <div class="field" data-other-date-field hidden>
                    <label for="custom-take-down-date">Choose another take-down date <span class="required-mark">*</span></label>
                    <p id="custom-take-down-date-hint" class="field-hint" data-custom-date-range>Choose a date within the 30 days before Sukkos.</p>
                    <div class="date-control"><input id="custom-take-down-date" name="customTakeDownDate" type="date" aria-describedby="custom-take-down-date-hint" /></div>
                  </div>
                </div>
                <div class="service-schedule" data-service-schedule="Bring to storage" hidden>
                  <div class="field">
                    <label for="bring-to-storage-date">Bring-to-storage day <span class="required-mark">*</span></label>
                    <select id="bring-to-storage-date" name="bringToStorageDate" data-holiday-date-select data-date-order="reverse">
                      <option value="">Choose a date</option>
                      <option value="other" data-other-date-option>Other date</option>
                    </select>
                  </div>
                  <div class="field" data-other-date-field hidden>
                    <label for="custom-storage-date">Choose another storage date <span class="required-mark">*</span></label>
                    <p id="custom-storage-date-hint" class="field-hint" data-custom-date-range>Choose a date within the 30 days before Sukkos.</p>
                    <div class="date-control"><input id="custom-storage-date" name="customStorageDate" type="date" aria-describedby="custom-storage-date-hint" /></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="field"><label for="timing-notes">Timing notes</label><input id="timing-notes" name="timingNotes" placeholder="Add any timing preferences or scheduling details" /></div>
          </section>

          <section id="final-details" class="form-card form-group" aria-labelledby="final-heading" data-form-step="7">
            <FormHeading icon="final" eyebrow="Final details" heading="Anything else we should know?" id="final-heading" />
            <div class="field"><label for="referral">How did you hear about us? <span class="required-mark">*</span></label><p class="field-hint">This helps us understand which advertising is useful.</p><input id="referral" name="referral" required /></div>
            <div class="field"><label for="comments">Comments or questions</label><textarea id="comments" name="comments" placeholder="Add any details that did not fit above."></textarea></div>
          </section>

          <div class="submit-row">
            <button class="button" type="submit" data-submit-button>Submit</button>
            <p data-submit-status role="status" aria-live="polite">Your information will be added to our private request sheet.</p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/choices.js@11.2.3/public/assets/scripts/choices.min.js"></script>
<script is:inline>
  const buildDateInput = document.querySelector("#build-date");

  if (window.flatpickr && buildDateInput) {
    const sharedOptions = {
      altInput: true,
      altInputClass: "builder-date-input",
      altFormat: "F j, Y",
      dateFormat: "Y-m-d",
      minDate: "today",
      disableMobile: false,
      monthSelectorType: "static",
      position: "below left",
    };

    const buildPicker = window.flatpickr(buildDateInput, sharedOptions);
    buildPicker.altInput?.setAttribute("aria-label", "Preferred installation date");
    buildPicker.altInput?.setAttribute("placeholder", "Select a date");
  }
</script>

<script>
  const progressBar = document.querySelector("[data-progress-bar]");
  const progressTrack = document.querySelector(".progress-track");
  const currentStep = document.querySelector("[data-current-step]");
  const currentLabel = document.querySelector("[data-current-label]");
  const stepLinks = Array.from(document.querySelectorAll("[data-step-link]"));
  const steps = Array.from(document.querySelectorAll("[data-form-step]"));
  const sizeSliders = Array.from(document.querySelectorAll("[data-size-slider]"));
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const sizeAnimations = new WeakMap();
  const branchInputs = Array.from(document.querySelectorAll("[data-branch-input]"));
  const branchSummary = document.querySelector("[data-branch-summary]");
  const buyOnly = document.querySelector("[data-buy-only]");
  const existingOnly = document.querySelector("[data-existing-only]");
  const timingDetails = document.querySelector("#timing-details");
  const purchaseTiming = document.querySelector("[data-purchase-timing]");
  const preSukkosSchedule = document.querySelector("[data-pre-sukkos-schedule]");
  const reverseSukkosSchedule = document.querySelector("[data-reverse-sukkos-schedule]");
  const serviceInputs = Array.from(document.querySelectorAll('input[name="service"]'));
  const forwardSchedule = {
    service: "forward",
    container: preSukkosSchedule,
    select: document.querySelector("#pre-sukkos-date"),
    otherDateField: preSukkosSchedule?.querySelector("[data-other-date-field]"),
    customDateInput: document.querySelector("#custom-service-date"),
    customDateRange: preSukkosSchedule?.querySelector("[data-custom-date-range]"),
    customDateLabel: "Choose another date",
  };
  const reverseSchedules = Array.from(document.querySelectorAll("[data-service-schedule]")).map((container) => ({
    service: container.getAttribute("data-service-schedule") ?? "",
    container,
    select: container.querySelector("[data-holiday-date-select]"),
    otherDateField: container.querySelector("[data-other-date-field]"),
    customDateInput: container.querySelector('input[type="date"]'),
    customDateRange: container.querySelector("[data-custom-date-range]"),
    customDateLabel: container.getAttribute("data-service-schedule") === "Take down"
      ? "Choose another take-down date"
      : "Choose another storage date",
  }));
  const scheduleConfigs = [forwardSchedule, ...reverseSchedules];
  const enhancedSelects = new WeakMap();
  const detailsHeading = document.querySelector("#details-heading");
  const timingHeading = document.querySelector("#timing-heading");
  const timingCopy = document.querySelector("[data-timing-copy]");
  const buildDateLabel = document.querySelector("[data-build-date-label]");
  const buildDateInput = document.querySelector("#build-date");
  const builderForm = document.querySelector("[data-builder-form]");
  const submitButton = document.querySelector("[data-submit-button]");
  const submitStatus = document.querySelector("[data-submit-status]");
  const sitePhotos = document.querySelector("#site-photos");
  let activeBranch = "";

  const setInputsDisabled = (container, disabled) => {
    if (!(container instanceof HTMLElement)) return;
    container.querySelectorAll("input, select, textarea").forEach((control) => {
      if (
        control instanceof HTMLInputElement ||
        control instanceof HTMLSelectElement ||
        control instanceof HTMLTextAreaElement
      ) {
        control.disabled = disabled;
      }
    });
  };

  const setContainerVisible = (container, visible) => {
    if (!(container instanceof HTMLElement)) return;
    container.hidden = !visible;
    setInputsDisabled(container, !visible);
  };

  const syncEnhancedSelect = (select) => {
    if (!(select instanceof HTMLSelectElement)) return;
    const enhancedSelect = enhancedSelects.get(select);
    if (!enhancedSelect) return;
    if (select.disabled) enhancedSelect.disable();
    else enhancedSelect.enable();
  };

  const updateOtherDateField = (config) => {
    const { container, select, otherDateField, customDateInput } = config;
    const showOtherDate =
      container instanceof HTMLElement &&
      !container.hidden &&
      select instanceof HTMLSelectElement &&
      select.value === "other";

    setContainerVisible(otherDateField, showOtherDate);
    if (customDateInput instanceof HTMLInputElement) {
      customDateInput.required = showOtherDate;
    }
  };

  const setScheduleVisible = (config, visible) => {
    setContainerVisible(config.container, visible);
    if (config.select instanceof HTMLSelectElement) {
      config.select.required = visible;
      syncEnhancedSelect(config.select);
    }
    updateOtherDateField(config);
  };

  const updateTimingSchedule = () => {
    const isBuy = activeBranch === "I would like to buy";
    const isExisting = activeBranch === "I already have a sukkah";
    const selectedServices = new Set(
      serviceInputs
        .filter((input) => input instanceof HTMLInputElement && input.checked)
        .map((input) => input.value),
    );
    const needsPreSukkosSchedule =
      isExisting &&
      (selectedServices.has("Bring out of storage") || selectedServices.has("Build"));
    const activeReverseSchedules = reverseSchedules.filter(
      (config) => isExisting && selectedServices.has(config.service),
    );
    const needsReverseSukkosSchedule = activeReverseSchedules.length > 0;
    const showTimingCard = isBuy || needsPreSukkosSchedule || needsReverseSukkosSchedule;

    setContainerVisible(timingDetails, showTimingCard);
    setContainerVisible(purchaseTiming, isBuy);
    setScheduleVisible(forwardSchedule, needsPreSukkosSchedule);
    setContainerVisible(reverseSukkosSchedule, needsReverseSukkosSchedule);
    reverseSchedules.forEach((config) => {
      setScheduleVisible(config, activeReverseSchedules.includes(config));
    });

    if (buildDateInput instanceof HTMLInputElement) buildDateInput.required = isBuy;
  };

  const setBranch = (branch) => {
    const isBuy = branch === "I would like to buy";
    const isExisting = branch === "I already have a sukkah";
    activeBranch = branch;

    if (buyOnly instanceof HTMLElement) {
      buyOnly.hidden = !isBuy;
      setInputsDisabled(buyOnly, !isBuy);
    }

    if (existingOnly instanceof HTMLElement) {
      existingOnly.hidden = !isExisting;
      setInputsDisabled(existingOnly, !isExisting);
    }

    if (detailsHeading instanceof HTMLElement) {
      detailsHeading.textContent = isBuy ? "Plan your new sukkah" : isExisting ? "Tell us what you have" : "Tell us about your sukkah";
    }
    if (timingHeading instanceof HTMLElement) {
      timingHeading.textContent = isBuy ? "When would you like it installed?" : "When should we come?";
    }
    if (timingCopy instanceof HTMLElement) {
      timingCopy.textContent = "Choose your preferred installation date. We’ll confirm availability when we follow up.";
    }
    if (buildDateLabel instanceof HTMLElement) {
      buildDateLabel.textContent = "Preferred installation date";
    }
    if (buildDateInput instanceof HTMLInputElement) {
      buildDateInput.setAttribute("aria-label", "Preferred installation date");
      const alternateInput = buildDateInput.parentElement?.querySelector(".builder-date-input");
      alternateInput?.setAttribute("aria-label", "Preferred installation date");
    }
    if (branchSummary instanceof HTMLElement) {
      branchSummary.textContent = isBuy
        ? "We’ll show questions for purchasing and installing a new sukkah."
        : isExisting
          ? "We’ll show questions for working with the sukkah you already own."
          : "Choose an option to personalize the form.";
    }
    updateTimingSchedule();
  };

  const atLocalNoon = (date) =>
    new Date(date.getFullYear(), date.getMonth(), date.getDate(), 12);

  const addCalendarDays = (date, days) => {
    const result = atLocalNoon(date);
    result.setDate(result.getDate() + days);
    return result;
  };

  const toIsoDate = (date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  };

  const hebrewDateFormatter = new Intl.DateTimeFormat("en-US-u-ca-hebrew", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
  const fullDateFormatter = new Intl.DateTimeFormat("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
  const shortDateFormatter = new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });

  const getHebrewDate = (date) => {
    const parts = hebrewDateFormatter.formatToParts(date);
    return {
      day: Number(parts.find((part) => part.type === "day")?.value ?? 0),
      month: parts.find((part) => part.type === "month")?.value ?? "",
    };
  };

  const findNextSukkos = () => {
    const today = atLocalNoon(new Date());
    for (let offset = 0; offset <= 500; offset += 1) {
      const candidate = addCalendarDays(today, offset);
      const hebrewDate = getHebrewDate(candidate);
      if (hebrewDate.day === 15 && /^Tishr/i.test(hebrewDate.month)) {
        return candidate;
      }
    }
    return null;
  };

  const initializeHolidayDates = () => {
    const sukkosDate = findNextSukkos();
    if (!(sukkosDate instanceof Date)) return;

    const motzeiYomKippur = addCalendarDays(sukkosDate, -5);
    const erevSukkos = addCalendarDays(sukkosDate, -1);
    const customMinimum = addCalendarDays(sukkosDate, -30);
    const availableDates = [];
    for (let date = motzeiYomKippur; date <= erevSukkos; date = addCalendarDays(date, 1)) {
      availableDates.push(date);
    }

    const getDateLabel = (date) => {
      if (date.getTime() === motzeiYomKippur.getTime()) {
        return `Motzei Yom Kippur — ${fullDateFormatter.format(date).replace(",", " evening,")}`;
      }
      if (date.getTime() === erevSukkos.getTime()) {
        return `Erev Sukkos — ${fullDateFormatter.format(date)}`;
      }
      return fullDateFormatter.format(date);
    };

    const minimumDate = toIsoDate(customMinimum);
    const maximumDate = toIsoDate(erevSukkos);

    scheduleConfigs.forEach((config) => {
      const { select, customDateInput, customDateRange, customDateLabel } = config;
      if (!(select instanceof HTMLSelectElement) || !(customDateInput instanceof HTMLInputElement)) {
        return;
      }

      const dates =
        select.dataset.dateOrder === "reverse"
          ? [...availableDates].reverse()
          : availableDates;
      const otherOption = select.querySelector("[data-other-date-option]");

      dates.forEach((date) => {
        const option = document.createElement("option");
        option.value = toIsoDate(date);
        option.textContent = getDateLabel(date);
        select.insertBefore(option, otherOption);
      });

      customDateInput.min = minimumDate;
      customDateInput.max = maximumDate;

      if (customDateRange instanceof HTMLElement) {
        customDateRange.textContent = `Choose a date from ${shortDateFormatter.format(customMinimum)} through ${shortDateFormatter.format(erevSukkos)}.`;
      }

      if (typeof window.flatpickr === "function") {
        const customDatePicker = window.flatpickr(customDateInput, {
          altInput: true,
          altInputClass: "builder-date-input",
          altFormat: "F j, Y",
          dateFormat: "Y-m-d",
          minDate: minimumDate,
          maxDate: maximumDate,
          disableMobile: false,
          monthSelectorType: "static",
          position: "below left",
        });
        customDatePicker.altInput?.setAttribute("aria-label", customDateLabel);
        customDatePicker.altInput?.setAttribute("placeholder", "Select a date");
      }

      if (typeof window.Choices === "function") {
        const enhancedSelect = new window.Choices(select, {
          allowHTML: false,
          itemSelectText: "",
          searchEnabled: false,
          shouldSort: false,
        });
        enhancedSelects.set(select, enhancedSelect);
      }
    });
  };

  initializeHolidayDates();

  const updateSizeValue = (slider) => {
    if (!(slider instanceof HTMLInputElement)) return;
    const output = document.querySelector(`[data-size-output="${slider.id}"]`);
    const minimum = Number(slider.min || 0);
    const maximum = Number(slider.max || 100);
    const value = Number(slider.value);
    if (output instanceof HTMLOutputElement) {
      const number = output.querySelector("[data-size-number]");
      const previousValue = Number(output.dataset.value ?? value);
      if (number instanceof HTMLElement) number.textContent = slider.value;
      output.setAttribute("aria-label", `${slider.value} feet`);

      if (
        previousValue !== value &&
        number instanceof HTMLElement &&
        !prefersReducedMotion.matches &&
        typeof number.animate === "function" &&
        typeof output.animate === "function"
      ) {
        sizeAnimations.get(number)?.cancel();
        sizeAnimations.get(output)?.cancel();
        const entryOffset = value > previousValue ? 5 : -5;

        sizeAnimations.set(number, number.animate(
          [
            { opacity: 0.45, transform: `translateY(${entryOffset}px) scale(.92)` },
            { opacity: 1, transform: "translateY(-1px) scale(1.08)", offset: 0.68 },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ],
          { duration: 220, easing: "cubic-bezier(.16,1,.3,1)" },
        ));
        sizeAnimations.set(output, output.animate(
          [
            { transform: "scale(.97)" },
            { transform: "scale(1.025)", offset: 0.65 },
            { transform: "scale(1)" },
          ],
          { duration: 220, easing: "cubic-bezier(.16,1,.3,1)" },
        ));
      }
      output.dataset.value = slider.value;
    }
    const progress = ((value - minimum) / (maximum - minimum)) * 100;
    slider.style.setProperty("--slider-progress", `${progress}%`);
  };

  sizeSliders.forEach((slider) => {
    updateSizeValue(slider);
    slider.addEventListener("input", () => updateSizeValue(slider));
  });

  serviceInputs.forEach((input) => {
    input.addEventListener("change", updateTimingSchedule);
  });
  scheduleConfigs.forEach((config) => {
    config.select?.addEventListener("change", () => updateOtherDateField(config));
  });

  branchInputs.forEach((input) => {
    input.addEventListener("change", () => {
      if (input instanceof HTMLInputElement && input.checked) setBranch(input.value);
    });
  });
  const selectedBranch = branchInputs.find((input) => input instanceof HTMLInputElement && input.checked);
  setBranch(selectedBranch instanceof HTMLInputElement ? selectedBranch.value : "");

  const setActiveStep = (stepNumber) => {
    stepLinks.forEach((link) => link.toggleAttribute("data-active", link.getAttribute("data-step-link") === stepNumber));
    if (progressBar instanceof HTMLElement) progressBar.style.width = `${(Number(stepNumber) / steps.length) * 100}%`;
    if (progressTrack instanceof HTMLElement) progressTrack.setAttribute("aria-valuenow", stepNumber);
    if (currentStep instanceof HTMLElement) currentStep.textContent = `${stepNumber} of ${steps.length}`;
    const activeLink = stepLinks.find((link) => link.getAttribute("data-step-link") === stepNumber);
    if (currentLabel instanceof HTMLElement && activeLink instanceof HTMLElement) {
      currentLabel.textContent = activeLink.textContent?.replace(stepNumber, "").trim() || "";
    }
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible instanceof IntersectionObserverEntry && visible.target instanceof HTMLElement) setActiveStep(visible.target.dataset.formStep ?? "1");
    }, { rootMargin: "-18% 0px -60%", threshold: [0.1, 0.35] });
    steps.forEach((step) => observer.observe(step));
  }
  setActiveStep("1");

  if (builderForm instanceof HTMLFormElement) {
    builderForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const photos =
        sitePhotos instanceof HTMLInputElement && sitePhotos.files
          ? Array.from(sitePhotos.files)
          : [];
      const invalidPhoto = photos.find((photo) => photo.size > 10 * 1024 * 1024);

      if (photos.length > 3 || invalidPhoto) {
        if (submitStatus instanceof HTMLElement) {
          submitStatus.textContent =
            photos.length > 3
              ? "Please choose no more than three photos."
              : "Each photo must be no larger than 10 MB.";
          submitStatus.dataset.state = "error";
        }
        if (sitePhotos instanceof HTMLInputElement) sitePhotos.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending...";
      }
      if (submitStatus instanceof HTMLElement) {
        submitStatus.textContent =
          photos.length > 0
            ? "Uploading your photos and sending your request..."
            : "Sending your request...";
        submitStatus.dataset.state = "working";
      }

      try {
        const response = await fetch("/api/sukkah-submissions", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(builderForm),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          throw new Error(result?.message || "We could not send your request.");
        }

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.textContent = "Request sent";
        }
        if (submitStatus instanceof HTMLElement) {
          submitStatus.textContent =
            result.message || "Thank you. Your request was sent to Benyamin.";
          submitStatus.dataset.state = "success";
        }
      } catch (error) {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = "Try again";
        }
        if (submitStatus instanceof HTMLElement) {
          submitStatus.textContent =
            error instanceof Error
              ? error.message
              : "We could not send your request. Please try again or call (347) 454-2282.";
          submitStatus.dataset.state = "error";
        }
      }
    });
  }

</script>

