---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ManagedRequestForm from "../../components/ManagedRequestForm.astro";
---

<BaseLayout
  title="Builds"
  description="Share your sukkah setup, location, timing, and site details with BK Sukkah."
  bodyClass="builds-page request-form-page"
>
  <section class="request-hero sukkah-hero-background">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Builds</span>
      </nav>
      <div class="request-hero-copy">
        <p class="eyebrow">BUILDS</p>
        <h1>Your sukkah starts with a good plan.</h1>
        <p class="lead">Share a few details and we’ll follow up with a custom quote.</p>
      </div>
    </div>
  </section>

  <ManagedRequestForm slug="builds" />
</BaseLayout>

<style>
  .request-hero { padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); }
  .request-hero-copy { width: min(100%, 760px); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: center; }
  .request-hero-copy .eyebrow { justify-content: center; margin-bottom: .8rem; }
  .request-hero h1 { max-width: 760px; margin: 0 auto 1rem; font-size: clamp(3.15rem, 6vw, 5rem); line-height: 1; }
  .request-hero .lead { max-width: 650px; margin: 0 auto; }
  @media (max-width: 700px) {
    .request-hero { padding-block: 1.35rem 2.5rem; }
    .request-hero-copy { margin-top: 2rem; }
    .request-hero h1 { font-size: clamp(2.55rem, 12vw, 3.7rem); }
  }
</style>
