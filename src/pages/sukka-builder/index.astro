    padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(3rem, 5vw, 4.25rem);
  }

  body.builds-page .builder-hero-inner {
    position: relative;
    z-index: 1;
  }

  body.builds-page .builder-hero-copy {
    width: min(100%, 760px);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    text-align: center;
  }

  body.builds-page .builder-hero-copy .eyebrow {
    display: flex;
    justify-content: center;
    margin-bottom: 0.8rem;
  }

  body.builds-page .builder-hero h1 {
    max-width: 760px;
    margin: 0 auto 1rem;
    font-size: clamp(3.15rem, 6vw, 5rem);
    line-height: 1;
  }

  body.builds-page .builder-hero .lead {
    max-width: 650px;
