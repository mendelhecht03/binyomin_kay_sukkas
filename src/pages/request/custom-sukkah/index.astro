---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FormPageActions from "../../../components/FormPageActions.astro";
import ManagedRequestForm from "../../../components/ManagedRequestForm.astro";
---

<BaseLayout
  title="Custom Sukkah request"
  description="Share the details of your custom sukkah project with BK Sukkah."
  bodyClass="request-form-page dynamic-request-page"
>
  <section class="dynamic-form-hero sukkah-hero-background">
    <div class="shell dynamic-form-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Custom Sukkah request</span>
      </nav>
      <div class="dynamic-form-hero__copy">
        <p class="eyebrow">Project request</p>
        <h1>Tell us what you need.</h1>
        <p class="lead">Share a few details and we’ll follow up.</p>
        <FormPageActions
          primaryLabel="Start a custom sukkah request"
          primaryHref="#custom-sukkah-request"
          secondaryLabel="See recent projects"
          secondaryHref="/custom-sukkahs/#recent-projects"
          ariaLabel="Custom sukkah request actions"
        />
      </div>
    </div>
  </section>

  <ManagedRequestForm slug="custom-sukkah" sectionId="custom-sukkah-request" priceNote="Custom sukkah projects start at $700. Final pricing is confirmed with BK Sukkah." />
</BaseLayout>

<style>
  .dynamic-form-hero { padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); }
  .dynamic-form-hero__copy { width: min(100%, 760px); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: center; }
  .dynamic-form-hero__copy .eyebrow { justify-content: center; }
  .dynamic-form-hero h1 { margin-bottom: .8rem; font-size: clamp(2.8rem, 6vw, 4.8rem); }
  .dynamic-form-hero .lead { max-width: 640px; margin-inline: auto; }
  @media (max-width: 700px) { .dynamic-form-hero__copy { margin-top: 2.5rem; } }
</style>
