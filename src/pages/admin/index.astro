---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FORM_DEFINITIONS } from "../../server/forms/registry.js";
import { DEFAULT_MANAGED_FORMS, SUPPORTED_FORM_FIELD_TYPES, SUPPORTED_FORM_STEP_ICONS } from "../../server/forms/form-schema.js";

const dashboardForms = FORM_DEFINITIONS.map(({ type, sourceKey, label, singularLabel }) => ({
  type,
  sourceKey,
  label,
  singularLabel,
}));
---

<BaseLayout
  title="Owner dashboard"
  description="Private owner dashboard for website submissions."
  bodyClass="admin-body"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <section class="admin-hero">
    <div class="shell admin-hero__inner">
      <div>
        <p class="eyebrow">Private owner view</p>
        <h1>Website submissions</h1>
        <p>Review customer requests and manage the forms that appear on the website.</p>
      </div>
      <div class="admin-account">
        <span id="viewer-email">Signed-in owner</span>
        <a href="/signout-with-chatgpt?return_to=/">Sign out</a>
      </div>
    </div>
  </section>

  <nav class="admin-tabs shell" role="tablist" aria-label="Dashboard sections" data-admin-tabs>
    <button id="builder-tab" class="admin-tab is-active" role="tab" type="button" data-admin-tab="builder" aria-controls="form-builder" aria-selected="true">Form builder</button>
    <button id="submissions-tab" class="admin-tab" role="tab" type="button" data-admin-tab="submissions" aria-controls="submissions-dashboard" aria-selected="false" tabindex="-1">Submissions</button>
  </nav>

  <section id="form-builder" class="section admin-form-builder" role="tabpanel" data-admin-panel="builder" aria-labelledby="builder-tab">
    <div class="shell">
      <div class="form-builder-heading">
        <div>
          <p class="eyebrow">No code required</p>
          <h2 id="form-builder-heading">Form builder</h2>
          <p>Create a form or safely edit a draft before publishing it to customers.</p>
        </div>
        <button class="button button-secondary" type="button" data-new-form>Create new form</button>
      </div>

      <div class="form-builder-layout">
        <aside class="form-list-panel" aria-label="Website forms">
          <h3>Your forms</h3>
          <div class="form-list-rail" data-form-list-rail>
            <button class="form-list-scroll-button" type="button" data-form-list-scroll="prev" aria-label="Previous form">←</button>
            <div data-form-list></div>
            <button class="form-list-scroll-button" type="button" data-form-list-scroll="next" aria-label="Next form">→</button>
          </div>
        </aside>

        <div class="form-editor-panel">
          <p class="form-editor-loading" data-form-editor-loading>Loading the form builder…</p>
          <div data-form-editor hidden>
            <div class="form-editor-toolbar">
              <div>
                <span class="form-draft-badge">Draft</span>
                <strong data-editor-form-name>Form</strong>
                <small data-editor-version>Not published yet</small>
              </div>
              <a class="button button-secondary form-public-link" data-public-form-link href="/request/custom-sukkah/" target="_blank" rel="noopener">Open published form</a>
            </div>

            <div class="form-settings-grid">
              <label><span>Form name</span><input data-form-setting="title" maxlength="120" /></label>
              <label><span>Public URL</span><div class="slug-field"><span>/request/</span><input data-form-setting="slug" maxlength="80" /></div></label>
              <label class="form-settings-full"><span>Introduction</span><textarea data-form-setting="description" rows="2" maxlength="500"></textarea></label>
              <label><span>Submit button text</span><input data-form-setting="submitLabel" maxlength="80" /></label>
              <label><span>Success heading</span><input data-form-setting="successTitle" maxlength="120" /></label>
              <label class="form-settings-full"><span>Success message</span><textarea data-form-setting="successMessage" rows="2" maxlength="500"></textarea></label>
            </div>

            <div class="form-editor-columns">
              <div>
                <div class="form-steps-heading"><h3>Steps and questions</h3><button type="button" data-add-step>+ Add step</button></div>
                <div class="form-step-editor" data-form-step-editor></div>
              </div>
              <aside class="form-preview-panel" aria-label="Live form preview">
                <div><p class="eyebrow">Live preview</p><span>Try the fields · scroll linked</span></div>
                <div data-form-preview></div>
              </aside>
            </div>

            <p class="form-editor-status" data-form-editor-status role="status"></p>
            <div class="form-editor-actions">
              <button class="button button-secondary" type="button" data-save-draft>Save draft</button>
              <button class="button" type="button" data-publish-form>Publish changes</button>
            </div>

            <details class="form-version-history">
              <summary>Version history</summary>
              <div data-version-history><p>Publish the form to create its first saved version.</p></div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="submissions-dashboard" class="section admin-dashboard" role="tabpanel" data-admin-panel="submissions" aria-labelledby="submissions-tab" hidden>
    <div class="shell">
      <h2 id="submissions-heading" class="sr-only">Submissions dashboard</h2>
      <section class="sheets-export-card" aria-labelledby="sheets-export-heading" data-sheets-export>
        <div class="sheets-export-card__copy">
          <p class="eyebrow">Optional reporting</p>
          <h2 id="sheets-export-heading">Google Sheets export</h2>
          <p>Send Builds, Rentals, Buy, Custom Sukkah, and Pergola requests to separate tabs. Testimonials are always excluded.</p>
        </div>
        <form class="sheets-settings-form" data-sheets-settings-form>
          <label><span>Google Sheet URL or ID</span><input data-sheets-spreadsheet placeholder="Paste a Google Sheet link" autocomplete="off" /></label>
          <button class="button button-secondary" type="submit" data-sheets-save>Test and save</button>
        </form>
        <div class="sheets-export-card__help">
          <strong>One-time setup</strong>
          <span>Share the Sheet with <code data-sheets-service-account>the site’s Google service account</code> as an Editor.</span>
        </div>
        <div class="sheets-export-card__actions">
          <div class="sheets-export-card__status">
            <p data-sheets-status role="status">Checking Google Sheets setup…</p>
            <p class="sheets-sync-indicator" data-sheets-sync data-state="checking" role="status"><span class="sheets-sync-indicator__dot" aria-hidden="true"></span><span data-sheets-sync-text>Checking sync status…</span></p>
          </div>
          <div><button class="button button-secondary" type="button" data-sheets-test>Test connection</button><button class="button" type="button" data-sheets-export-all disabled>Export all requests</button></div>
        </div>
      </section>
      <div class="admin-summary" aria-label="Loaded submission summary">
        <article><span>Loaded</span><strong id="count-all">—</strong></article>
        {dashboardForms.map((form) => (
          <article><span>{form.label}</span><strong id={`count-${form.type}`}>—</strong></article>
        ))}
      </div>

      <div class="admin-controls">
        <div>
          <p class="admin-controls__label">Show</p>
          <div class="admin-filters" role="group" aria-label="Filter submissions">
            <button class="is-active" type="button" data-type="all">All</button>
            {dashboardForms.map((form) => (
              <button type="button" data-type={form.type}>{form.label}</button>
            ))}
          </div>
        </div>
        <label class="admin-search">
          <span>Search submissions</span>
          <input id="admin-search" type="search" placeholder="Name, email, phone, or neighborhood" />
        </label>
      </div>

      <div id="source-status" class="source-status" aria-label="Data source status"></div>
      <p id="admin-message" class="admin-message" role="status">Loading submissions…</p>

      <div id="submission-table-shell" class="submission-table-shell" hidden>
        <table class="submission-table">
          <caption class="sr-only">Website submissions</caption>
          <thead>
            <tr>
              <th scope="col">Type</th>
              <th scope="col">Customer</th>
              <th scope="col">Request</th>
              <th scope="col">Submitted</th>
              <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody id="submission-list"></tbody>
        </table>
      </div>
      <div id="admin-empty" class="admin-empty" hidden>
        <h2>No matching submissions</h2>
        <p>Try another filter or search.</p>
      </div>
      <button id="load-more" class="button button-secondary load-more" type="button" hidden>Load more</button>
    </div>
  </section>

  <dialog id="submission-dialog" class="admin-dialog submission-dialog" aria-labelledby="submission-dialog-title">
    <button class="dialog-close" type="button" aria-label="Close submission details">×</button>
    <div id="dialog-content"></div>
    <p class="submission-edit-status" data-edit-status role="status"></p>
    <div class="dialog-actions">
      <button class="button button-edit" type="button" data-edit-current><span aria-hidden="true">✎</span> Edit responses</button>
      <button class="button" type="button" data-save-current hidden>Save changes</button>
      <button class="button button-secondary" type="button" data-cancel-edit hidden>Cancel</button>
      <button class="button button-approve" type="button" data-approve-current hidden>Approve and publish</button>
      <button class="button button-danger" type="button" data-delete-current>Delete submission</button>
      <button class="button button-secondary" type="button" data-close-details>Close</button>
    </div>
  </dialog>

  <dialog id="delete-dialog" class="admin-dialog delete-dialog" aria-labelledby="delete-heading" aria-describedby="delete-description delete-warning">
    <p class="eyebrow">Permanent action</p>
    <h2 id="delete-heading">Delete this submission?</h2>
    <p id="delete-description"></p>
    <p id="delete-warning" class="delete-warning">This cannot be undone. The database entry and its associated website photos will be permanently deleted.</p>
    <p id="delete-status" class="delete-status" role="status"></p>
    <div class="dialog-actions">
      <button id="confirm-delete" class="button button-danger" type="button">Delete permanently</button>
      <button class="button button-secondary" type="button" data-cancel-delete>Keep submission</button>
    </div>
  </dialog>

  <dialog id="new-form-dialog" class="admin-dialog new-form-dialog">
    <button class="dialog-close" type="button" aria-label="Close new form dialog">×</button>
    <p class="eyebrow">New website form</p>
    <h2>Create a form</h2>
    <p>Start with a simple Contact and Review flow. You can add steps and questions next.</p>
    <form data-new-form-form>
      <label><span>Form name</span><input name="title" maxlength="120" placeholder="For example, Pergola request" required /></label>
      <label><span>Public URL</span><div class="slug-field"><span>/request/</span><input name="slug" maxlength="80" placeholder="pergola-request" required /></div></label>
      <p class="form-editor-status" data-new-form-status role="status"></p>
      <div class="dialog-actions"><button class="button" type="submit">Create draft</button><button class="button button-secondary" type="button" data-cancel-new-form>Cancel</button></div>
    </form>
  </dialog>

  <script id="dashboard-form-definitions" type="application/json" set:html={JSON.stringify(dashboardForms)}></script>
  <script id="default-form-schemas" type="application/json" set:html={JSON.stringify(DEFAULT_MANAGED_FORMS)}></script>
  <script id="supported-field-types" type="application/json" set:html={JSON.stringify(SUPPORTED_FORM_FIELD_TYPES)}></script>
  <script id="supported-step-icons" type="application/json" set:html={JSON.stringify(SUPPORTED_FORM_STEP_ICONS)}></script>
  <script>
    import "../../scripts/admin-dashboard.js";
  </script>
</BaseLayout>

<style is:global>
  .admin-body { background: var(--cream-50); }
  .admin-hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 7vw, 5.5rem); color: white; background: var(--forest-950); }
  .admin-hero::after { position: absolute; right: -8rem; bottom: -15rem; width: 30rem; height: 30rem; border: 4rem solid rgba(255,255,255,.05); border-radius: 50%; content: ""; }
  .admin-hero__inner { position: relative; z-index: 1; display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .admin-hero h1 { max-width: 760px; margin-bottom: .75rem; color: white; font-size: clamp(2.7rem, 7vw, 5.4rem); }
  .admin-hero p:last-child { max-width: 650px; margin: 0; color: rgba(255,255,255,.72); font-size: 1.08rem; }
  .admin-hero .eyebrow, .admin-dialog .eyebrow { margin-bottom: .6rem; color: var(--wood-500); }
  .admin-account { min-width: 210px; display: grid; justify-items: end; gap: .25rem; padding: 1rem 1.1rem; border: 1px solid rgba(255,255,255,.16); border-radius: var(--radius); background: rgba(255,255,255,.06); font-size: .85rem; }
  .admin-account a { color: white; font-weight: 800; text-underline-offset: .2em; }
  .admin-tabs { display: flex; gap: .35rem; padding-top: 1rem; border-bottom: 1px solid var(--border); background: var(--cream-50); }
  .admin-tab { min-height: 44px; padding: .65rem 1rem; border: 0; border-bottom: 3px solid transparent; border-radius: 8px 8px 0 0; color: var(--ink-500); background: transparent; font: inherit; font-weight: 850; cursor: pointer; }
  .admin-tab:hover, .admin-tab:focus-visible { color: var(--forest-900); background: var(--cream-100); }
  .admin-tab.is-active { border-bottom-color: var(--wood-500); color: var(--forest-950); background: var(--cream-100); }
  .admin-dashboard { min-height: 42rem; padding-top: clamp(2rem, 5vw, 3.5rem); }
  .admin-form-builder { padding-block: clamp(2.5rem, 6vw, 5rem); border-bottom: 1px solid var(--border); background: var(--cream-100); }
  .form-builder-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .form-builder-heading h2 { margin-bottom: .4rem; font-size: clamp(2.1rem, 4vw, 3.4rem); }
  .form-builder-heading p:last-child { max-width: 650px; margin: 0; color: var(--ink-500); }
  .form-builder-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 1rem; align-items: start; }
  .form-list-panel, .form-editor-panel { border: 1px solid var(--border); border-radius: var(--radius-large); background: white; box-shadow: var(--shadow-small); }
  .form-list-panel { position: sticky; top: 80px; overflow: hidden; padding: .75rem; }
  .form-list-panel h3 { margin: .4rem .45rem .75rem; font-family: var(--font-body); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  .form-list-rail { position: relative; }
  .form-list-rail > div { display: grid; gap: .35rem; }
  .form-list-scroll-button { display: none; }
  .form-list-item { width: 100%; display: grid; gap: .2rem; padding: .75rem; border: 1px solid transparent; border-radius: 10px; color: var(--ink-900); background: transparent; text-align: left; cursor: pointer; }
  .form-list-item + .form-list-item { margin-top: .35rem; }
  .form-list-item:hover { background: var(--cream-100); }
  .form-list-item.is-active { border-color: var(--forest-700); background: var(--forest-100); }
  .form-list-item strong { font-size: .88rem; }
  .form-list-item small { color: var(--ink-500); font-size: .72rem; }
  .form-editor-panel { min-width: 0; padding: clamp(1rem, 3vw, 1.5rem); }
  .form-editor-loading { margin: 0; padding: 2rem; color: var(--ink-500); text-align: center; }
  .form-editor-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .form-editor-toolbar > div { display: grid; grid-template-columns: auto 1fr; gap: .15rem .55rem; align-items: center; }
  .form-editor-toolbar strong { color: var(--forest-950); font-size: 1.15rem; }
  .form-editor-toolbar small { grid-column: 2; color: var(--ink-500); }
  .form-draft-badge { grid-row: 1 / span 2; padding: .3rem .5rem; border-radius: 999px; color: #76501e; background: #f6e8d4; font-size: .68rem; font-weight: 850; text-transform: uppercase; }
  .form-public-link { min-height: 42px; padding: .55rem .8rem; font-size: .78rem; }
  .form-settings-grid, .field-editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .form-settings-grid { margin-block: 1.25rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--cream-50); }
  .form-settings-grid label, .field-editor-grid label, .condition-grid label, .new-form-dialog label { display: grid; gap: .35rem; color: var(--ink-700); font-size: .78rem; font-weight: 800; }
  .form-settings-grid input, .form-settings-grid textarea, .field-editor-grid input, .field-editor-grid select, .field-editor-grid textarea, .condition-grid input, .condition-grid select, .new-form-dialog input { width: 100%; min-height: 42px; padding: .55rem .65rem; border: 1px solid rgba(29,41,37,.22); border-radius: 8px; color: var(--ink-900); background: white; font: inherit; font-size: .87rem; }
  .form-settings-grid textarea, .field-editor-grid textarea { resize: vertical; }
  .form-settings-full, .field-editor-full { grid-column: 1 / -1; }
  .slug-field { display: flex; align-items: center; overflow: hidden; border: 1px solid rgba(29,41,37,.22); border-radius: 8px; background: white; }
  .slug-field > span { padding-left: .65rem; color: var(--ink-500); font-size: .8rem; font-weight: 700; }
  .slug-field input { border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
  .form-editor-columns { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(260px, .7fr); gap: 1rem; align-items: start; }
  .form-steps-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .75rem; }
  .form-steps-heading h3 { margin: 0; font-size: 1.25rem; }
  .form-steps-heading button, .add-question-button, .mini-actions button, .version-row button { min-height: 38px; padding: .4rem .65rem; border: 1px solid var(--border-strong); border-radius: 8px; color: var(--forest-800); background: white; font: inherit; font-size: .76rem; font-weight: 800; cursor: pointer; }
  .step-editor-card { position: relative; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--cream-50); }
  .step-editor-card.is-scroll-active { border-color: var(--forest-700); box-shadow: 0 0 0 2px rgba(47, 105, 82, .1); }
  .step-editor-card + .step-editor-card { margin-top: .85rem; }
  .step-editor-heading { display: grid; grid-template-columns: 2.15rem minmax(120px, 1fr) minmax(120px, 10rem) auto; gap: .65rem; align-items: center; padding: .75rem; border-bottom: 1px solid var(--border); background: var(--forest-100); }
  .step-editor-heading > span { display: grid; width: 2.15rem; height: 2.15rem; place-items: center; border-radius: 8px; color: white; background: var(--forest-800); font-weight: 850; }
  .step-editor-heading input { width: 100%; min-height: 38px; padding: .4rem .55rem; border: 1px solid var(--border-strong); border-radius: 7px; color: var(--forest-950); background: white; font: inherit; font-weight: 800; }
  .step-icon-setting { position: relative; min-width: 0; }
  .step-icon-picker { position: relative; }
  .step-icon-picker summary { display: flex; min-height: 38px; align-items: center; gap: .45rem; padding: .35rem .5rem; border: 1px solid var(--border-strong); border-radius: 7px; color: var(--forest-900); background: white; font-size: .76rem; font-weight: 750; list-style: none; cursor: pointer; }
  .step-icon-picker summary::-webkit-details-marker { display: none; }
  .step-icon-picker[open] summary { border-color: var(--forest-700); box-shadow: 0 0 0 2px rgba(47, 105, 82, .12); }
  .step-icon-picker__current { display: grid; width: 1.55rem; height: 1.55rem; flex: 0 0 auto; place-items: center; border-radius: 5px; color: white; background: var(--forest-800); }
  .step-icon-picker__current svg { width: 1rem; height: 1rem; }
  .step-icon-picker__label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .step-icon-picker__chevron { margin-left: auto; color: var(--ink-500); font-size: 1rem; line-height: 1; }
  .step-icon-picker__menu { position: absolute; z-index: 15; top: calc(100% + .35rem); right: 0; display: grid; width: min(300px, calc(100vw - 2rem)); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .3rem; padding: .45rem; border: 1px solid var(--border-strong); border-radius: 9px; background: white; box-shadow: 0 16px 32px rgba(16, 45, 37, .16); }
  .step-icon-picker__option { display: flex; min-height: 42px; align-items: center; gap: .45rem; padding: .35rem .4rem; border: 1px solid transparent; border-radius: 6px; color: var(--ink-700); background: transparent; font: inherit; font-size: .7rem; font-weight: 750; text-align: left; cursor: pointer; }
  .step-icon-picker__option:hover, .step-icon-picker__option:focus-visible, .step-icon-picker__option.is-selected { border-color: var(--border); color: var(--forest-900); background: var(--forest-100); }
  .step-icon-picker__option-icon { display: grid; width: 1.65rem; height: 1.65rem; flex: 0 0 auto; place-items: center; border-radius: 5px; color: var(--forest-800); background: var(--cream-100); }
  .step-icon-picker__option-icon svg { width: 1.05rem; height: 1.05rem; }
  .mini-actions { display: flex; flex-wrap: wrap; gap: .3rem; justify-content: flex-end; }
  .mini-actions button { min-width: 38px; min-height: 38px; padding: .35rem .5rem; }
  .mini-actions .is-danger { color: var(--danger); }
  .step-fields { display: grid; gap: .65rem; padding: .75rem; }
  .field-editor-card { padding: .8rem; border: 1px solid var(--border); border-radius: 10px; background: white; }
  .field-editor-card__top { display: flex; justify-content: space-between; gap: .75rem; align-items: center; margin-bottom: .75rem; }
  .field-type-badge { padding: .28rem .5rem; border-radius: 999px; color: var(--forest-800); background: var(--forest-100); font-size: .67rem; font-weight: 850; text-transform: uppercase; }
  .field-editor-grid label > span small { color: var(--ink-500); font-weight: 650; }
  .field-editor-grid .toggle-setting { display: flex; grid-column: 1 / -1; align-items: center; gap: .5rem; }
  .field-editor-grid .toggle-setting input { width: 1.1rem; min-height: 1.1rem; accent-color: var(--forest-700); }
  .condition-editor { margin-top: .8rem; padding-top: .7rem; border-top: 1px solid var(--border); }
  .condition-editor summary { width: fit-content; color: var(--forest-800); cursor: pointer; font-size: .78rem; font-weight: 850; }
  .condition-editor > p { margin: .45rem 0 .65rem; color: var(--ink-500); font-size: .75rem; }
  .condition-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; }
  .add-question-button { width: calc(100% - 1.5rem); margin: 0 .75rem .75rem; border-style: dashed; background: transparent; }
  .form-preview-panel { position: sticky; top: 80px; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: white; box-shadow: 0 14px 32px rgba(16,45,37,.07); }
  .form-preview-panel > div:first-child { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; padding: .8rem; color: var(--ink-500); background: var(--forest-950); }
  .form-preview-panel .eyebrow { margin: 0; color: var(--wood-500); font-size: .65rem; }
  .form-preview-panel > div:first-child span { color: rgba(255,255,255,.65); font-size: .68rem; }
  .form-preview-panel [data-form-preview] { max-height: 72vh; overflow-y: auto; padding: .9rem; }
  .form-preview-panel h4 { margin-bottom: .25rem; font-size: 1.25rem; }
