---
import "../../styles/global.css";

const pageTitle = "Owner Dashboard | Benyamin Kay";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>
  <body class="admin-body">
    <header class="admin-header">
      <div class="admin-shell admin-header__inner">
        <div>
          <p class="admin-eyebrow">Private owner view</p>
          <h1>BKAY submissions</h1>
          <p>Builds, rentals, and testimonials in one read-only view.</p>
        </div>
        <div class="admin-account">
          <span id="viewer-email"></span>
          <a href="/signout-with-chatgpt?return_to=/">Sign out</a>
        </div>
      </div>
    </header>

    <main class="admin-shell admin-main">
      <section class="admin-summary" aria-label="Submission summary">
        <article><span>Loaded submissions</span><strong id="count-all">—</strong></article>
        <article><span>Build requests</span><strong id="count-build">—</strong></article>
        <article><span>Rental requests</span><strong id="count-rental">—</strong></article>
        <article><span>Testimonials</span><strong id="count-testimonial">—</strong></article>
      </section>

      <section id="source-status" class="source-status" aria-label="Data source status"></section>

      <div class="admin-toolbar">
        <div class="admin-filters" role="group" aria-label="Filter submissions">
          <button class="is-active" type="button" data-type="all">All</button>
          <button type="button" data-type="build">Builds</button>
          <button type="button" data-type="rental">Rentals</button>
          <button type="button" data-type="testimonial">Testimonials</button>
        </div>
        <label class="admin-search">
          <span class="sr-only">Search submissions</span>
          <input id="admin-search" type="search" placeholder="Search name, email, phone, or neighborhood" />
        </label>
      </div>

      <p id="admin-message" class="admin-message" role="status">Loading submissions…</p>
      <section id="submission-list" class="submission-list" aria-label="Submissions"></section>
      <button id="load-more" class="load-more" type="button" hidden>Load more</button>
    </main>

    <dialog id="submission-dialog" class="submission-dialog">
      <button class="dialog-close" type="button" aria-label="Close submission details">×</button>
      <div id="dialog-content"></div>
    </dialog>

    <script is:inline>
      const fixtureData = {
        ok: true,
        viewer: { email: "owner@example.com" },
        sources: { builds: { ok: true }, rentals: { ok: true }, testimonials: { ok: true } },
        submissions: [
          {
            id: "build-demo",
            type: "build",
            submittedAt: "2026-08-13T23:42:18.000Z",
            customer: { name: "Sample Build Customer", phone: "(555) 010-1111", email: "build@example.com" },
            location: { address: "123 Sample Street", city: "Brooklyn", state: "NY", zip: "11213", neighborhood: "Crown Heights" },
            summary: "Setup and takedown · 10 × 12 ft",
            answers: { service: ["Setup", "Takedown"], estimatedSize: "10 × 12 ft", sukkahType: "Canvas", schach: ["Bamboo mat"] },
            details: [
              { key: "service", label: "Requested work", value: ["Setup", "Takedown"] },
              { key: "estimatedSize", label: "Estimated size", value: "10 × 12 ft" },
              { key: "sukkahType", label: "Sukkah type", value: "Canvas" },
            ],
            source: { provider: "google-form", key: "builds" },
          },
          {
            id: "rental-demo",
            type: "rental",
            submittedAt: "2026-08-13T21:15:00.000Z",
            customer: { name: "Sample Rental Customer", phone: "(555) 010-2222" },
            location: { city: "Brooklyn", state: "NY", neighborhood: "Flatbush" },
            summary: "12 × 16 ft · September 18, 2026",
            answers: { estimatedSize: "12 × 16 ft", buildDay: "2026-09-18", takeDownDay: "2026-10-05" },
            details: [
              { key: "estimatedSize", label: "Rental size", value: "12 × 16 ft" },
              { key: "buildDay", label: "Setup date", value: "2026-09-18" },
              { key: "takeDownDay", label: "Takedown date", value: "2026-10-05" },
            ],
            source: { provider: "google-form", key: "rentals" },
          },
          {
            id: "testimonial-demo",
            type: "testimonial",
            submittedAt: "2026-08-13T20:04:00.000Z",
            customer: { name: "Sample Reviewer", email: "review@example.com" },
            summary: "The team was responsive and the finished sukkah was exactly what we needed.",
            answers: { testimonial: "The team was responsive and the finished sukkah was exactly what we needed.", status: "Pending review" },
            details: [
              { key: "testimonial", label: "Testimonial", value: "The team was responsive and the finished sukkah was exactly what we needed." },
              { key: "status", label: "Status", value: "Pending review" },
            ],
            source: { provider: "google-sheet", key: "testimonials" },
          },
        ],
      };

      const state = { type: "all", search: "", nextCursor: "", submissions: [], loading: false };
      const list = document.querySelector("#submission-list");
      const message = document.querySelector("#admin-message");
      const loadMore = document.querySelector("#load-more");
      const dialog = document.querySelector("#submission-dialog");
      const isLocalFixture = ["localhost", "127.0.0.1"].includes(location.hostname) && new URLSearchParams(location.search).get("fixture") === "1";

      function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, (character) => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
        }[character]));
      }

      function displayValue(value) {
        return escapeHtml(Array.isArray(value) ? value.join(", ") : value);
      }

      function customerName(record) {
        return record.customer?.name || [record.customer?.firstName, record.customer?.lastName].filter(Boolean).join(" ") || "Name not provided";
      }

      function formatDate(value) {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? "Date unavailable" : new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short" }).format(date);
      }

      function locationLabel(record) {
        return record.location?.neighborhood || [record.location?.city, record.location?.state].filter(Boolean).join(", ") || "";
      }

      function updateCounts() {
        document.querySelector("#count-all").textContent = state.submissions.length;
        ["build", "rental", "testimonial"].forEach((type) => {
          document.querySelector(`#count-${type}`).textContent = state.submissions.filter((item) => item.type === type).length;
        });
      }

      function renderStatuses(sources = {}) {
        const labels = { builds: "Builds", rentals: "Rentals", testimonials: "Testimonials" };
        document.querySelector("#source-status").innerHTML = Object.entries(labels).map(([key, label]) => {
          const source = sources[key];
          const className = source?.ok === false ? "is-error" : source?.ok === true ? "is-ok" : "";
          const text = source?.ok === false ? `${label}: temporarily unavailable` : source?.ok === true ? `${label}: loaded` : `${label}: not requested`;
          return `<span class="${className}">${escapeHtml(text)}</span>`;
        }).join("");
      }

      function renderList() {
        updateCounts();
        if (!state.submissions.length) {
          list.innerHTML = '<div class="admin-empty"><h2>No matching entries</h2><p>Try another filter or search.</p></div>';
          return;
        }

        list.innerHTML = state.submissions.map((record) => `
          <button class="submission-card" type="button" data-id="${escapeHtml(record.id)}">
            <span class="submission-type submission-type--${escapeHtml(record.type)}">${escapeHtml(record.type)}</span>
            <span class="submission-card__main">
              <strong>${escapeHtml(customerName(record))}</strong>
              <small>${escapeHtml(formatDate(record.submittedAt))}${locationLabel(record) ? ` · ${escapeHtml(locationLabel(record))}` : ""}</small>
              <span>${escapeHtml(record.summary || "Submission")}</span>
            </span>
            <span class="submission-open">View →</span>
          </button>
        `).join("");
      }

      function detailSection(title, entries) {
        const visible = entries.filter(([, value]) => value && (!Array.isArray(value) || value.length));
        if (!visible.length) return "";
        return `<section class="detail-section"><h3>${escapeHtml(title)}</h3><dl>${visible.map(([label, value]) => `<div><dt>${escapeHtml(label)}</dt><dd>${displayValue(value)}</dd></div>`).join("")}</dl></section>`;
      }

      function openDetails(record) {
        const answerDetails = (record.details || []).map((detail) => [detail.label, detail.value]);
        const photos = (record.photos || []).map((photo) => `<a href="${escapeHtml(photo.url)}" target="_blank" rel="noopener"><img src="${escapeHtml(photo.url)}" alt="${escapeHtml(photo.label || "Submission photo")}" /></a>`).join("");
        document.querySelector("#dialog-content").innerHTML = `
          <p class="admin-eyebrow">${escapeHtml(record.type)} request</p>
          <h2>${escapeHtml(customerName(record))}</h2>
          <p class="detail-date">${escapeHtml(formatDate(record.submittedAt))}</p>
          ${detailSection("Contact", [["Phone", record.customer?.phone], ["Email", record.customer?.email]])}
          ${detailSection("Location", [["Address", record.location?.address], ["City", record.location?.city], ["State", record.location?.state], ["ZIP Code", record.location?.zip], ["Neighborhood", record.location?.neighborhood]])}
          ${detailSection(record.type === "testimonial" ? "Testimonial" : "Request details", answerDetails)}
          ${photos ? `<section class="detail-section"><h3>Photos</h3><div class="detail-photos">${photos}</div></section>` : ""}
        `;
        dialog.showModal();
      }

      async function load({ append = false } = {}) {
        if (state.loading) return;
        state.loading = true;
        message.textContent = append ? "Loading more…" : "Loading submissions…";
        message.hidden = false;
        loadMore.disabled = true;
        try {
          const params = new URLSearchParams({ type: state.type, limit: "60" });
          if (state.search) params.set("search", state.search);
          if (append && state.nextCursor) params.set("cursor", state.nextCursor);
          const data = isLocalFixture ? fixtureData : await fetch(`/api/admin/submissions?${params}`).then(async (response) => {
            const body = await response.json().catch(() => null);
            if (!response.ok) throw new Error(body?.message || "The dashboard could not load.");
            return body;
          });
          state.submissions = append ? [...state.submissions, ...data.submissions] : data.submissions;
          state.nextCursor = data.nextCursor || "";
          document.querySelector("#viewer-email").textContent = data.viewer?.email || "";
          renderStatuses(data.sources);
          renderList();
          message.hidden = true;
          loadMore.hidden = !state.nextCursor || isLocalFixture;
        } catch (error) {
          message.textContent = error.message || "The dashboard could not load.";
          if (!append) list.innerHTML = "";
        } finally {
          state.loading = false;
          loadMore.disabled = false;
        }
      }

      document.querySelector(".admin-filters").addEventListener("click", (event) => {
        const button = event.target.closest("[data-type]");
        if (!button) return;
        document.querySelectorAll("[data-type]").forEach((item) => item.classList.toggle("is-active", item === button));
        state.type = button.dataset.type;
        state.nextCursor = "";
        load();
      });

      let searchTimer;
      document.querySelector("#admin-search").addEventListener("input", (event) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.search = event.target.value.trim();
          state.nextCursor = "";
          load();
        }, 300);
      });
      list.addEventListener("click", (event) => {
        const card = event.target.closest("[data-id]");
        const record = state.submissions.find((item) => item.id === card?.dataset.id);
        if (record) openDetails(record);
      });
      loadMore.addEventListener("click", () => load({ append: true }));
      dialog.querySelector(".dialog-close").addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
      load();
    </script>
  </body>
</html>

<style is:global>
  .admin-body { margin: 0; color: #173d33; background: #f7f4eb; font-family: "Inter", sans-serif; }
  .admin-shell { width: min(1160px, calc(100% - 32px)); margin-inline: auto; }
  .admin-header { color: white; background: #0d4336; border-bottom: 5px solid #c47d2f; }
  .admin-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 28px; }
  .admin-header h1 { margin: 0 0 4px; color: white; font: 700 clamp(2rem, 5vw, 3rem)/1.05 Georgia, serif; }
  .admin-header p { margin: 0; color: #d6e6e0; }
  .admin-eyebrow { margin: 0 0 6px !important; color: #e8b370 !important; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .admin-account { display: grid; justify-items: end; gap: 5px; font-size: .85rem; }
  .admin-account a { color: white; }
  .admin-main { padding-block: 28px 60px; }
  .admin-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
  .admin-summary article { padding: 18px; border: 1px solid #d8e2dc; border-radius: 14px; background: white; box-shadow: 0 10px 24px rgb(13 67 54 / .06); }
  .admin-summary span { display: block; color: #65766f; font-size: .78rem; font-weight: 700; }
  .admin-summary strong { display: block; margin-top: 5px; color: #0d4336; font-size: 1.8rem; }
  .source-status { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .source-status span { padding: 6px 10px; border-radius: 999px; color: #5f6e68; background: #e9edea; font-size: .75rem; font-weight: 700; }
  .source-status .is-ok { color: #125b43; background: #dceee6; }
  .source-status .is-error { color: #8a3327; background: #f7ded9; }
  .admin-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .admin-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .admin-filters button, .load-more { min-height: 44px; padding: 9px 15px; border: 1px solid #cbd8d1; border-radius: 999px; color: #0d4336; background: white; font: inherit; font-weight: 750; cursor: pointer; }
  .admin-filters button:hover, .admin-filters button.is-active { color: white; border-color: #0d4336; background: #0d4336; }
  .admin-search { width: min(390px, 100%); }
  .admin-search input { width: 100%; min-height: 46px; padding: 10px 13px; border: 1px solid #cbd8d1; border-radius: 10px; font: inherit; background: white; }
  .admin-search input:focus { outline: 3px solid rgb(196 125 47 / .25); border-color: #c47d2f; }
  .admin-message { color: #65766f; }
  .submission-list { display: grid; gap: 10px; }
  .submission-card { display: grid; grid-template-columns: 105px minmax(0, 1fr) auto; align-items: center; gap: 16px; width: 100%; padding: 16px 18px; border: 1px solid #d8e2dc; border-radius: 14px; color: inherit; background: white; text-align: left; box-shadow: 0 8px 20px rgb(13 67 54 / .04); cursor: pointer; }
  .submission-card:hover { border-color: #c47d2f; transform: translateY(-1px); }
  .submission-type { justify-self: start; padding: 5px 9px; border-radius: 999px; color: #0d4336; background: #e1efe9; font-size: .72rem; font-weight: 850; text-transform: uppercase; }
  .submission-type--rental { color: #6d4718; background: #f8ead6; }
  .submission-type--testimonial { color: #4d3e77; background: #ece7fa; }
  .submission-card__main { display: grid; gap: 2px; min-width: 0; }
  .submission-card__main strong { font-size: 1rem; }
  .submission-card__main small { color: #65766f; }
  .submission-card__main > span { overflow: hidden; color: #314f47; text-overflow: ellipsis; white-space: nowrap; }
  .submission-open { color: #0d4336; font-size: .82rem; font-weight: 800; }
  .load-more { display: block; margin: 22px auto 0; border-radius: 10px; }
  .load-more[hidden] { display: none; }
  .admin-empty { padding: 34px; border: 1px dashed #b8cac1; border-radius: 14px; text-align: center; }
  .admin-empty h2 { margin: 0 0 4px; font: 700 1.4rem Georgia, serif; }
  .admin-empty p { margin: 0; color: #65766f; }
  .submission-dialog { width: min(780px, calc(100% - 24px)); max-height: min(86vh, 900px); padding: 28px; border: 0; border-radius: 18px; color: #173d33; box-shadow: 0 25px 70px rgb(0 0 0 / .28); }
  .submission-dialog::backdrop { background: rgb(5 27 21 / .55); }
  .submission-dialog h2 { margin: 0; font: 700 clamp(1.7rem, 5vw, 2.4rem)/1.1 Georgia, serif; }
  .dialog-close { position: absolute; top: 13px; right: 15px; width: 42px; height: 42px; border: 0; border-radius: 50%; color: #0d4336; background: #edf2ef; font-size: 1.7rem; cursor: pointer; }
  .detail-date { color: #65766f; }
  .detail-section { padding-top: 18px; margin-top: 18px; border-top: 1px solid #dce4df; }
  .detail-section h3 { margin: 0 0 11px; color: #0d4336; font-size: .78rem; letter-spacing: .11em; text-transform: uppercase; }
  .detail-section dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px 20px; margin: 0; }
  .detail-section dt { color: #65766f; font-size: .75rem; font-weight: 750; }
  .detail-section dd { margin: 2px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .detail-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .detail-photos img { width: 100%; aspect-ratio: 4 / 3; border-radius: 9px; object-fit: cover; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .admin-shell { width: min(100% - 22px, 600px); }
    .admin-header__inner, .admin-toolbar { align-items: stretch; flex-direction: column; }
    .admin-account { justify-items: start; }
    .admin-summary { grid-template-columns: repeat(2, 1fr); }
    .admin-search { width: 100%; }
    .submission-card { grid-template-columns: 1fr auto; }
    .submission-type { grid-column: 1 / -1; }
    .submission-card__main > span { white-space: normal; }
    .detail-section dl, .detail-photos { grid-template-columns: 1fr; }
  }
</style>
