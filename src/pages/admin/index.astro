    function previewControl(field) {
      const optional = field.required ? " *" : " (Optional)";
      if (["radio", "checkboxes"].includes(field.type)) return `<fieldset><legend>${escapeHtml(field.label + optional)}</legend><div class="preview-choice-grid">${(field.options || []).slice(0, 4).map((option) => `<span>○ ${escapeHtml(option)}</span>`).join("")}</div></fieldset>`;
      if (field.type === "textarea") return `<label>${escapeHtml(field.label + optional)}<span class="preview-textarea">${escapeHtml(field.placeholder || "")}</span></label>`;
      if (field.type === "select") return `<label>${escapeHtml(field.label + optional)}<span class="preview-input">Choose an option⌄</span></label>`;
      if (field.type === "photos") return `<label>${escapeHtml(field.label + optional)}<span class="preview-upload">Choose photos</span></label>`;
      return `<label>${escapeHtml(field.label + optional)}<span class="preview-input">${field.type === "date" ? "mm/dd/yyyy" : field.placeholder || ""}</span></label>`;
    }

    function renderEditorPreview() {
      if (!editor.schema) return;
