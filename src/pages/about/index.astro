---
import BaseLayout from "../../layouts/BaseLayout.astro";

const biography =
  "Started at just 15 years old as a humble side hustle with only a handful of clients, Benyamin has grown year after year. Working alongside multiple name-brand sukkah companies, he now serves hundreds of satisfied customers from multiple locations across multiple states.";

const whatWeDo =
  "We offer a comprehensive range of services tailored to bring any vision to life. Whether you need regular sukkah builds, custom sukkah designs, elegant pergolas, rentals, or anything in between, we handle it all. If a project needs a specific item you do not have on hand, we track it down and get it for you so you never have to worry about a thing.";

const whyChooseUs = [
  {
    title: "Industry partnerships",
    body: "We collaborate with multiple name-brand sukkah companies to bring top-tier products and expertise to our clients.",
  },
  {
    title: "End-to-end service",
    body: "We manage every detail from start to finish with the highest level of professionalism for a seamless experience.",
  },
  {
    title: "Zero stress",
    body: "We handle every hurdle and supply missing materials so you can enjoy a genuinely stress-free holiday.",
  },
  {
    title: "Expert team",
    body: "Our qualified, responsible, and dedicated professionals treat every structure with the utmost care.",
  },
];

---

<BaseLayout
  title="About"
  description="A short introduction to Benyamin Kay and his practical approach to sukkah and outdoor work."
>
  <div class="about-page">
    <section class="about-hero sukkah-hero-background" aria-labelledby="about-heading">
      <div class="shell about-hero__inner">
        <div class="about-hero__copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">About</span>
          </nav>
          <p class="eyebrow">About Benyamin</p>
          <h1 id="about-heading">A stress-free Yom Tov starts here.</h1>
          <p class="lead">From the first conversation through the finished work, we take care of the details from A to Z.</p>
          <p class="about-hero__bio">{biography}</p>
          <div class="button-row">
            <a class="button" href="/contact/">Request a quote</a>
          </div>
        </div>

        <figure class="about-photo">
          <img
            src="/assets/images/profile-photo1.jpg"
            alt="Benyamin Kay smiling as he crosses the finish line of a road race"
            width="1448"
            height="1086"
            loading="eager"
          />
          <figcaption>Benyamin Kay</figcaption>
        </figure>
      </div>
    </section>

    <section class="about-details" aria-labelledby="about-details-heading">
      <div class="shell about-details__inner">
        <article class="about-detail about-detail-wide">
          <p class="eyebrow">What we do</p>
          <h2 id="about-details-heading">Bring your vision to life.</h2>
          <p>{whatWeDo}</p>
        </article>

        <article class="about-detail about-detail-wide">
          <p class="eyebrow">Why choose us</p>
          <div class="about-reasons">
            {whyChooseUs.map((reason) => (
              <div class="about-reason">
                <h3>{reason.title}</h3>
                <p>{reason.body}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="about-detail about-contact-detail">
          <p class="eyebrow">Get in touch</p>
          <h2>Ready for a completely stress-free holiday?</h2>
          <p>Contact us today to book your build, custom project, or rental and let Benyamin take care of the rest.</p>
          <a class="button" href="/contact/">Contact us</a>
        </article>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-page {
    overflow: clip;
    padding-bottom: 1.5rem;
  }

  .about-hero {
    padding-block: 1.15rem clamp(1.75rem, 4vw, 3rem);
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-hero__copy,
  .about-photo {
    min-width: 0;
  }

  .about-hero__copy h1 {
    max-width: 11ch;
    margin-bottom: 1.1rem;
    font-size: clamp(3rem, 7vw, 5.4rem);
    line-height: 0.96;
  }

  .about-hero__copy .lead {
    max-width: 34rem;
    margin-bottom: 0.75rem;
  }

  .about-hero__bio {
    max-width: 34rem;
    margin-bottom: 1rem;
    color: var(--ink-700);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .about-photo {
    position: relative;
    margin: 0;
    padding: 0 0 1rem 1rem;
  }

  .about-photo::before {
    position: absolute;
    inset: 1rem 1rem 0 0;
    z-index: 0;
    border-radius: var(--radius-large);
    content: "";
    background: var(--wood-500);
  }

  .about-photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-medium);
    object-fit: cover;
    object-position: 42% center;
  }

  .about-photo figcaption {
    position: absolute;
    right: 1.6rem;
    bottom: 1.8rem;
    z-index: 2;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--forest-950);
    background: rgba(255, 253, 248, 0.9);
    font-size: 0.86rem;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  .about-details {
    padding-block: 1.5rem 2.5rem;
    background: var(--cream-50);
  }

  .about-details__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .about-detail {
    min-width: 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(23, 63, 52, 0.18);
  }

  .about-detail-wide {
    grid-column: 1 / -1;
  }

  .about-detail h2 {
    max-width: 24ch;
    margin-bottom: 0.65rem;
    font-size: clamp(1.65rem, 3vw, 2.35rem);
  }

  .about-detail p {
    max-width: 72ch;
    margin-bottom: 0;
    color: var(--ink-700);
    line-height: 1.55;
  }

  .about-reasons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
  }

  .about-reason h3 {
    margin-bottom: 0.25rem;
    color: var(--forest-900);
    font-size: 1rem;
    text-transform: none;
  }

  .about-reason p {
    font-size: 0.93rem;
  }

  .about-contact-detail {
    align-self: start;
  }

  .about-contact-detail .button {
    margin-top: 1rem;
  }

  @media (max-width: 58rem) {
    .about-hero__inner {
      grid-template-columns: 1fr;
    }

    .about-photo {
      max-width: 32rem;
    }
  }

  @media (max-width: 42rem) {
    .about-hero {
      padding-block: 1rem 2rem;
    }

    .about-hero__inner {
      gap: 1.25rem;
      margin-top: 1.75rem;
    }

    .about-hero__copy h1 {
      font-size: clamp(2.65rem, 13vw, 3.9rem);
    }

    .about-hero__copy .button {
      width: 100%;
    }

    .about-hero__copy .button-row {
      display: grid;
    }

    .about-details__inner,
    .about-reasons {
      grid-template-columns: 1fr;
    }

    .about-detail-wide {
      grid-column: auto;
    }

    .about-contact-detail .button {
      width: 100%;
    }
  }
</style>
