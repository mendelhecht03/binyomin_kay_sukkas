---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Replace these placeholders only after the business history and totals are approved.
const biography =
  "Benyamin helps families and communities plan practical sukkah and outdoor projects with clear communication from the first conversation through the finished work.";

const aboutStats = [
  { label: "Sukkahs built", value: 0 },
  { label: "Years working", value: 0 },
];
---

<BaseLayout
  title="About"
  description="A short introduction to Benyamin Kay and his practical approach to sukkah and outdoor work."
>
  <div class="about-page">
    <section class="about-hero sukkah-hero-background" aria-labelledby="about-heading">
      <div class="shell about-hero__inner">
        <div class="about-hero__copy">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">About</span>
          </nav>
          <p class="eyebrow">About Benyamin</p>
          <h1 id="about-heading">Practical work. Clear communication.</h1>
          <p class="lead">A straightforward way to plan sukkah-season projects and outdoor work.</p>
          <div class="button-row">
            <a class="button" href="/contact/">Request a quote</a>
          </div>
        </div>

        <figure class="about-photo">
          <img
            src="/assets/images/profile-photo1.jpg"
            alt="Benyamin Kay smiling as he crosses the finish line of a road race"
            width="1448"
            height="1086"
            loading="eager"
          />
          <figcaption>Benyamin Kay</figcaption>
        </figure>
      </div>
    </section>

    <section class="about-stats section-muted" aria-labelledby="about-stats-heading">
      <div class="shell">
        <div class="about-stats__heading">
          <p class="eyebrow">At a glance</p>
          <h2 id="about-stats-heading">The numbers can tell the story.</h2>
          <p class="about-edit-note">Placeholder totals — update these values after they are confirmed.</p>
        </div>
        <div class="about-stats__grid">
          {aboutStats.map((stat) => (
            <article class="about-stat">
              <strong class="about-stat__value" data-counter-target={stat.value}>0</strong>
              <span>{stat.label}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-story" aria-labelledby="about-story-heading">
      <div class="shell about-story__panel">
        <div>
          <p class="eyebrow">A little more</p>
          <h2 id="about-story-heading">A clear plan before the work begins.</h2>
        </div>
        <div class="about-story__copy">
          <p>{biography}</p>
          <p class="about-edit-note">Editable placeholder biography — replace this paragraph with the approved business history.</p>
        </div>
      </div>
    </section>

    <section class="section-compact about-cta" aria-labelledby="about-cta-heading">
      <div class="shell">
        <div class="cta-panel">
          <div>
            <p class="eyebrow">Get started</p>
            <h2 id="about-cta-heading">Have a project in mind?</h2>
            <p>Share the location, timing, and the details you already know.</p>
          </div>
          <a class="button button-light" href="/contact/">Contact Benyamin</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const counters = [...document.querySelectorAll("[data-counter-target]")];
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function renderCounter(counter, value) {
    counter.textContent = new Intl.NumberFormat("en-US").format(value);
  }

  function animateCounter(counter) {
    const target = Number(counter.dataset.counterTarget);
    if (!Number.isFinite(target) || target <= 0 || prefersReducedMotion) {
      renderCounter(counter, Number.isFinite(target) ? target : 0);
      return;
    }

    const duration = 700;
    const startedAt = performance.now();

    function tick(now) {
      const progress = Math.min((now - startedAt) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      renderCounter(counter, Math.round(target * eased));
      if (progress < 1) window.requestAnimationFrame(tick);
    }

    window.requestAnimationFrame(tick);
  }

  if ("IntersectionObserver" in window && !prefersReducedMotion) {
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
        animateCounter(entry.target);
        currentObserver.unobserve(entry.target);
      });
    }, { threshold: 0.35 });
    counters.forEach((counter) => observer.observe(counter));
  } else {
    counters.forEach(animateCounter);
  }
</script>

<style>
  .about-page {
    overflow: clip;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .about-hero {
    padding-block: clamp(1.35rem, 3vw, 2.5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .about-hero__copy,
  .about-photo {
    min-width: 0;
  }

  .about-hero__copy h1 {
    max-width: 11ch;
    margin-bottom: 1.1rem;
    font-size: clamp(3rem, 7vw, 5.4rem);
    line-height: 0.96;
  }

  .about-hero__copy .lead {
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .about-photo {
    position: relative;
    margin: 0;
    padding: 0 0 1rem 1rem;
  }

  .about-photo::before {
    position: absolute;
    inset: 1rem 1rem 0 0;
    z-index: 0;
    border-radius: var(--radius-large);
    content: "";
    background: var(--wood-500);
  }

  .about-photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-medium);
    object-fit: cover;
    object-position: 42% center;
  }

  .about-photo figcaption {
    position: absolute;
    right: 1.6rem;
    bottom: 1.8rem;
    z-index: 2;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--forest-950);
    background: rgba(255, 253, 248, 0.9);
    font-size: 0.86rem;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  .about-stats {
    padding-block: clamp(2.75rem, 6vw, 4.75rem);
  }

  .about-stats__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0 2rem;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .about-stats__heading .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: 0.75rem;
  }

  .about-stats__heading h2,
  .about-stats__heading p:last-child {
    margin-bottom: 0;
  }

  .about-edit-note {
    color: var(--ink-500);
    font-size: 0.88rem;
  }

  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .about-stat {
    display: flex;
    min-height: 9rem;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
    border: 1px solid rgba(23, 63, 52, 0.14);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.66);
  }

  .about-stat__value {
    color: var(--forest-950);
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    line-height: 0.95;
  }

  .about-stat span {
    margin-top: 0.6rem;
    color: var(--ink-700);
    font-weight: 800;
  }

  .about-story {
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .about-story__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 7vw, 5rem);
    align-items: start;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: white;
    box-shadow: var(--shadow-small);
  }

  .about-story__panel h2 {
    max-width: 12ch;
  }

  .about-story__copy p:first-child {
    margin-bottom: 0.85rem;
    color: var(--ink-700);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .about-story__copy p:last-child {
    margin-bottom: 0;
  }

  .about-cta {
    padding-bottom: 0;
  }

  .about-cta .eyebrow {
    color: #f0bd7e;
  }

  .about-cta .button {
    flex: 0 0 auto;
  }

  @media (max-width: 58rem) {
    .about-hero__inner,
    .about-story__panel {
      grid-template-columns: 1fr;
    }

    .about-photo {
      max-width: 32rem;
    }
  }

  @media (max-width: 42rem) {
    .about-hero {
      padding-block: 1.35rem 3rem;
    }

    .about-hero__inner {
      gap: 1.75rem;
      margin-top: 2.25rem;
    }

    .about-hero__copy h1 {
      font-size: clamp(2.65rem, 13vw, 3.9rem);
    }

    .about-hero__copy .button,
    .about-cta .button {
      width: 100%;
    }

    .about-hero__copy .button-row {
      display: grid;
    }

    .about-stats__heading {
      display: block;
    }

    .about-stats__heading h2 {
      margin-bottom: 0.75rem;
    }

    .about-stats__grid {
      grid-template-columns: 1fr;
    }

    .about-cta .cta-panel {
      align-items: stretch;
      grid-template-columns: 1fr;
    }
  }
</style>
