---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormHeading from "../../components/FormHeading.astro";
import PaymentMethods from "../../components/PaymentMethods.astro";
import SitePhotoUpload from "../../components/SitePhotoUpload.astro";
import { neighborhoods, states } from "../../data/form-options.js";
import "../../styles/guided-request-form.css";

const addOns = [
  { label: "Lighting", value: "Put up lights" },
  { label: "Furniture", value: "Furniture" },
  { label: "Pressure washing", value: "Pressure wash area day before" },
];
---

<BaseLayout
  title="Sukkah Rentals"
  description="Request a sukkah rental and share your location, size, setup, and takedown preferences."
  bodyClass="rentals-page request-form-page"
>
  <section class="rental-hero sukkah-hero-background">
    <div class="shell rental-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Sukkah Rentals</span>
      </nav>
      <div class="rental-hero-copy">
        <p class="eyebrow">SUKKAH RENTALS</p>
        <h1>Tell us what you need.</h1>
        <p class="lead">Share a few details and we’ll follow up with availability and pricing.</p>
      </div>
    </div>
  </section>

  <section id="rental-request" class="form-section" aria-labelledby="rental-request-heading">
    <div class="shell form-shell">
      <h2 id="rental-request-heading" class="sr-only">Rental request</h2>

      <form class="rental-wizard guided-request-form" data-rental-form novalidate>
        <div class="form-honeypot" aria-hidden="true">
          <label for="rental-website">Leave this field empty</label>
          <input id="rental-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <section class="rental-package-summary" aria-labelledby="rental-package-heading">
          <div class="rental-package-placeholder" role="img" aria-label="Rental sukkah photo coming soon">
            <span>Rental photo coming soon</span>
          </div>
          <div class="rental-package-copy">
            <p class="eyebrow">Rental sukkah</p>
            <h2 id="rental-package-heading">A simple seasonal setup</h2>
            <p>Comes with a basic metal frame with a variety of canvas tarps to choose from.</p>
          </div>
        </section>

        <div class="wizard-progress" data-progress-region aria-live="polite">
          <p>
            <span>Step <strong data-current-step>1</strong> of 5</span>
            <span class="progress-separator" aria-hidden="true">·</span>
            <strong data-current-label>Contact</strong>
          </p>
          <div class="progress-track" role="progressbar" aria-label="Rental request progress" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" aria-valuetext="Step 1 of 5: Contact">
            <span data-progress-bar></span>
          </div>
        </div>

        <div class="wizard-card">
          <section id="rental-contact" class="form-step" aria-labelledby="rental-contact-heading" data-form-step="1">
            <FormHeading icon="contact" eyebrow="Contact" heading="How can we reach you?" id="rental-contact-heading" />
            <div class="form-grid contact-grid">
              <div class="field">
                <label for="name">Name <span class="required-mark">*</span></label>
                <input id="name" name="name" autocomplete="name" maxlength="200" required />
                <p class="field-error" id="name-error" data-error-for="name"></p>
              </div>
              <div class="field">
                <label for="phone">Phone number <span class="required-mark">*</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="100" required />
                <p class="field-error" id="phone-error" data-error-for="phone"></p>
              </div>
              <div class="field field-full">
                <label for="email">Email address <span class="optional-text">Optional</span></label>
                <input id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" />
                <p class="field-error" id="email-error" data-error-for="email"></p>
              </div>
            </div>
          </section>

          <section id="rental-location" class="form-step" aria-labelledby="rental-location-heading" data-form-step="2" hidden>
            <FormHeading icon="location" eyebrow="Location" heading="Where will the sukkah be?" id="rental-location-heading" />
            <div class="address-grid">
              <div class="field address-street">
                <label for="address-line-1">Street address <span class="required-mark">*</span></label>
                <input id="address-line-1" name="addressLine1" autocomplete="address-line1" maxlength="1000" required />
                <p class="field-error" id="address-line-1-error" data-error-for="address-line-1"></p>
              </div>
              <div class="field">
                <label for="address-city">City <span class="required-mark">*</span></label>
                <input id="address-city" name="city" autocomplete="address-level2" maxlength="200" required />
                <p class="field-error" id="address-city-error" data-error-for="address-city"></p>
              </div>
              <div class="field">
                <label for="address-state">State <span class="required-mark">*</span></label>
                <select id="address-state" name="state" autocomplete="address-level1" required>
                  <option value="">Select state</option>
                  {states.map(([code, name]) => <option value={code}>{name}</option>)}
                </select>
                <p class="field-error" id="address-state-error" data-error-for="address-state"></p>
              </div>
              <div class="field address-postal">
                <label for="address-postal">Zip code <span class="required-mark">*</span></label>
                <input id="address-postal" name="postalCode" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required />
                <p class="field-error" id="address-postal-error" data-error-for="address-postal"></p>
              </div>
            </div>
            <div class="field">
              <label for="neighborhood">Neighborhood <span class="required-mark">*</span></label>
              <select id="neighborhood" name="neighborhood" aria-controls="neighborhood-other-field" aria-expanded="false" required data-neighborhood-select>
                <option value="">Choose a neighborhood</option>
                {neighborhoods.map((neighborhood) => <option value={neighborhood}>{neighborhood}</option>)}
                <option value="Other">Other</option>
              </select>
              <p class="field-error" id="neighborhood-error" data-error-for="neighborhood"></p>
            </div>
            <div id="neighborhood-other-field" class="field conditional-field" data-neighborhood-other hidden>
              <label for="neighborhoodOther">Other neighborhood <span class="required-mark">*</span></label>
              <input id="neighborhoodOther" name="neighborhoodOther" maxlength="200" disabled />
              <p class="field-error" id="neighborhoodOther-error" data-error-for="neighborhoodOther"></p>
            </div>
            <div class="field">
              <label for="estimated-size">Approximate sukkah size <span class="required-mark">*</span></label>
              <input id="estimated-size" name="estimatedSize" maxlength="200" placeholder="For example, 10 × 12 ft" required />
              <p class="field-error" id="estimated-size-error" data-error-for="estimated-size"></p>
            </div>
            <div class="field">
              <label for="site-description">Where will the sukkah be built?</label>
              <textarea id="site-description" name="siteDescription" rows="4" maxlength="4000" placeholder="Backyard, patio, driveway, rooftop, balcony, etc."></textarea>
              <p class="field-error" id="site-description-error" data-error-for="site-description"></p>
            </div>
            <SitePhotoUpload />
          </section>

          <section id="rental-timing" class="form-step" aria-labelledby="rental-timing-heading" data-form-step="3" hidden>
            <FormHeading icon="timing" eyebrow="Timing" heading="When do you need it?" id="rental-timing-heading" />
            <div class="form-grid timing-grid">
              <div class="field">
                <label for="buildDay">Preferred setup date <span class="required-mark">*</span></label>
                <input id="buildDay" name="buildDay" type="date" required />
                <p class="field-error" id="buildDay-error" data-error-for="buildDay"></p>
              </div>
              <div class="field">
                <label for="takeDownDay">Preferred takedown date <span class="required-mark">*</span></label>
                <input id="takeDownDay" name="takeDownDay" type="date" required />
                <p class="field-error" id="takeDownDay-error" data-error-for="takeDownDay"></p>
              </div>
            </div>
            <div class="field">
              <label for="timing-notes">Timing notes <span class="optional-text">Optional</span></label>
              <input id="timing-notes" name="timingNotes" maxlength="1000" placeholder="Any timing preferences or scheduling details" />
              <p class="field-error" id="timing-notes-error" data-error-for="timing-notes"></p>
            </div>
          </section>

          <section id="rental-extras" class="form-step" aria-labelledby="rental-extras-heading" data-form-step="4" hidden>
            <FormHeading icon="sukkah" eyebrow="Extras" heading="Anything else you need?" id="rental-extras-heading" />
            <p class="step-intro"><span class="optional-text">Optional</span> Choose any additional services you’d like to include.</p>
            <fieldset class="extras-fieldset">
              <legend class="sr-only">Additional services</legend>
              <div class="choice-grid extras-grid">
                {addOns.map((addOn) => (
                  <label class="choice-card">
                    <input
                      type="checkbox"
                      name="addOns"
                      value={addOn.value}
                      data-review-label={addOn.label}
                      aria-controls={addOn.value === "Furniture" ? "furniture-details-field" : undefined}
                      aria-expanded={addOn.value === "Furniture" ? "false" : undefined}
                      data-furniture-toggle={addOn.value === "Furniture" ? "true" : undefined}
                    />
                    <span>{addOn.label}</span>
                  </label>
                ))}
                <label class="choice-card">
                  <input type="checkbox" name="addOns" value="Other" aria-controls="other-addon-field" aria-expanded="false" data-other-addon data-review-label="Other" />
                  <span>Other</span>
                </label>
              </div>
            </fieldset>
            <div id="furniture-details-field" class="field conditional-field" data-furniture-details hidden>
              <label for="furniture-details">What furniture is required? <span class="required-mark">*</span></label>
              <textarea id="furniture-details" name="furnitureDetails" rows="3" maxlength="1000" placeholder="For example, tables and chairs for 12 guests." disabled></textarea>
              <p class="field-error" id="furniture-details-error" data-error-for="furniture-details"></p>
            </div>
            <div id="other-addon-field" class="field conditional-field" data-other-addon-field hidden>
              <label for="addOnsOther">Other service</label>
              <input id="addOnsOther" name="addOnsOther" maxlength="500" placeholder="Tell us what you need" disabled />
              <p class="field-error" id="addOnsOther-error" data-error-for="addOnsOther"></p>
            </div>
            <div class="extra-labor-group">
              <input type="hidden" name="extraServiceRequired" value="No" data-extra-service-required />
              <label class="choice-card extra-service-check">
                <input type="checkbox" aria-controls="extra-service-details-field" aria-expanded="false" data-extra-service-toggle />
                <span>
                  <strong>Special access or extra labor</strong>
                  <small>For example, a rooftop sukkah or unusual access.</small>
                </span>
              </label>
              <div id="extra-service-details-field" class="field conditional-field" data-extra-service-details hidden>
                <label for="rental-extra-service-details">What extra help is needed? <span class="required-mark">*</span></label>
                <textarea id="rental-extra-service-details" name="extraServiceDetails" rows="3" maxlength="2000" disabled></textarea>
                <p class="field-error" id="rental-extra-service-details-error" data-error-for="rental-extra-service-details"></p>
              </div>
            </div>
          </section>

          <section id="rental-final" class="form-step" aria-labelledby="rental-final-heading" data-form-step="5" hidden>
            <FormHeading icon="final" eyebrow="Review" heading="Review and send" id="rental-final-heading" />
            <div class="request-review" aria-labelledby="request-review-heading">
              <div class="review-heading">
                <h4 id="request-review-heading">Your request</h4>
                <p>Check the key details before sending.</p>
              </div>
              <dl class="review-list">
                <div><dt>Contact</dt><dd data-review-contact>Not added yet</dd><button type="button" data-edit-step="1">Edit<span class="sr-only"> contact details</span></button></div>
                <div><dt>Location</dt><dd data-review-location>Not added yet</dd><button type="button" data-edit-step="2">Edit<span class="sr-only"> location details</span></button></div>
                <div><dt>Timing</dt><dd data-review-timing>Not added yet</dd><button type="button" data-edit-step="3">Edit<span class="sr-only"> timing details</span></button></div>
                <div><dt>Extras</dt><dd data-review-extras>None selected</dd><button type="button" data-edit-step="4">Edit<span class="sr-only"> extra services</span></button></div>
              </dl>
            </div>
            <div class="field">
              <label for="comments">Comments or special requests <span class="required-mark">*</span></label>
              <textarea id="comments" name="comments" rows="3" maxlength="1000" required></textarea>
              <p class="field-error" id="comments-error" data-error-for="comments"></p>
            </div>
            <div class="question-group">
              <label class="choice-card question-toggle">
                <input type="checkbox" aria-controls="question-field" aria-expanded="false" data-question-toggle />
                <span>I have a question for Benyamin</span>
              </label>
              <div id="question-field" class="field conditional-field" data-question-field hidden>
                <label for="questions">Your question <span class="optional-text">Optional</span></label>
                <textarea id="questions" name="questions" rows="3" maxlength="1000" disabled></textarea>
                <p class="field-error" id="questions-error" data-error-for="questions"></p>
              </div>
            </div>
            <PaymentMethods />
          </section>

          <div class="wizard-actions">
            <button class="wizard-back" type="button" data-step-back hidden>Back</button>
            <button class="button wizard-continue" type="button" data-step-next>Continue</button>
            <button class="button form-submit-button" type="submit" data-submit-button hidden>
              <span data-submit-label>Request availability</span>
            </button>
          </div>
          <p class="submit-reassurance" data-submit-status role="status" aria-live="polite" hidden>No payment required. Benyamin will follow up with availability and pricing.</p>
        </div>
        <div class="rental-success request-success" data-success-panel hidden tabindex="-1">
          <p class="eyebrow">Request sent</p>
          <h3>Thank you.</h3>
          <p data-success-message>Benyamin received your rental request and will follow up with availability and pricing.</p>
          <a class="button" href="/">Return home</a>
        </div>
      </form>
      <noscript>
        <p class="noscript-note">JavaScript is needed to use this guided form. Please call <a href="tel:+13474542282">(347) 454-2282</a> or email <a href="mailto:bkaysukkahbuilders@gmail.com">bkaysukkahbuilders@gmail.com</a>.</p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const rentalForm = document.querySelector("[data-rental-form]");
  const steps = Array.from(document.querySelectorAll("[data-form-step]"));
  const progressBar = document.querySelector("[data-progress-bar]");
  const progressTrack = progressBar?.parentElement;
  const currentStep = document.querySelector("[data-current-step]");
  const currentLabel = document.querySelector("[data-current-label]");
  const backButton = document.querySelector("[data-step-back]");
  const nextButton = document.querySelector("[data-step-next]");
  const submitButton = document.querySelector("[data-submit-button]");
  const submitLabel = document.querySelector("[data-submit-label]");
  const submitStatus = document.querySelector("[data-submit-status]");
  const neighborhoodSelect = document.querySelector("[data-neighborhood-select]");
  const neighborhoodOther = document.querySelector("[data-neighborhood-other]");
  const neighborhoodOtherInput = document.querySelector("#neighborhoodOther");
  const otherAddOn = document.querySelector("[data-other-addon]");
  const otherAddOnField = document.querySelector("[data-other-addon-field]");
  const otherAddOnInput = document.querySelector("#addOnsOther");
  const furnitureToggle = document.querySelector("[data-furniture-toggle]");
  const furnitureDetails = document.querySelector("[data-furniture-details]");
  const furnitureDetailsInput = document.querySelector("#furniture-details");
  const extraServiceToggle = document.querySelector("[data-extra-service-toggle]");
  const extraServiceRequired = document.querySelector("[data-extra-service-required]");
  const extraServiceDetails = document.querySelector("[data-extra-service-details]");
  const extraServiceDetailsInput = document.querySelector("#rental-extra-service-details");
  const questionToggle = document.querySelector("[data-question-toggle]");
  const questionField = document.querySelector("[data-question-field]");
  const questionInput = document.querySelector("#questions");
  const progressRegion = document.querySelector("[data-progress-region]");
  const wizardCard = document.querySelector(".wizard-card");
  const successPanel = document.querySelector("[data-success-panel]");
  const successMessage = document.querySelector("[data-success-message]");
  const sitePhotos = document.querySelector("#site-photos");
  const selectedPhotos = document.querySelector("[data-selected-photos]");
  const editButtons = Array.from(document.querySelectorAll("[data-edit-step]"));
  const stepNames = ["Contact", "Location", "Timing", "Extras", "Review and send"];
  let activeStep = 1;

  function fieldErrorElement(field) {
    return rentalForm?.querySelector(`[data-error-for="${field.id}"]`);
  }

  function clearFieldError(field) {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
    field.removeAttribute("aria-invalid");
    field.removeAttribute("aria-describedby");
    const error = fieldErrorElement(field);
    if (error instanceof HTMLElement) error.textContent = "";
  }

  function fieldErrorMessage(field) {
    if (field.validity.valueMissing) return "Please complete this field.";
    if (field.validity.typeMismatch && field.type === "email") return "Enter a valid email address.";
    return "Check this field and try again.";
  }

  function showFieldError(field) {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
    const error = fieldErrorElement(field);
    field.setAttribute("aria-invalid", "true");
    if (error instanceof HTMLElement) {
      error.textContent = fieldErrorMessage(field);
      if (error.id) field.setAttribute("aria-describedby", error.id);
    }
  }

  function controlsForStep(stepNumber) {
    const step = steps[stepNumber - 1];
    if (!(step instanceof HTMLElement)) return [];
    return Array.from(step.querySelectorAll("input, select, textarea")).filter(
      (control) => control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement,
    );
  }

  function validatePhotos() {
    if (!(sitePhotos instanceof HTMLInputElement)) return true;
    clearFieldError(sitePhotos);
    const photos = sitePhotos.files ? Array.from(sitePhotos.files) : [];
    if (photos.length > 3) {
      showFieldError(sitePhotos);
      const error = fieldErrorElement(sitePhotos);
      if (error instanceof HTMLElement) error.textContent = "Choose no more than three photos.";
      return false;
    }
    if (photos.some((photo) => photo.size > 10 * 1024 * 1024)) {
      showFieldError(sitePhotos);
      const error = fieldErrorElement(sitePhotos);
      if (error instanceof HTMLElement) error.textContent = "Each photo must be no larger than 10 MB.";
      return false;
    }
    return true;
  }

  function renderSelectedPhotos() {
    if (!(selectedPhotos instanceof HTMLElement) || !(sitePhotos instanceof HTMLInputElement)) return;
    selectedPhotos.replaceChildren();
    const files = sitePhotos.files ? Array.from(sitePhotos.files) : [];
    files.forEach((file, index) => {
      const row = document.createElement("div");
      row.className = "selected-photo";
      const name = document.createElement("span");
      name.textContent = file.name;
      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Remove";
      remove.setAttribute("aria-label", `Remove ${file.name}`);
      remove.addEventListener("click", () => {
        const transfer = new DataTransfer();
        files.forEach((item, itemIndex) => {
          if (itemIndex !== index) transfer.items.add(item);
        });
        sitePhotos.files = transfer.files;
        renderSelectedPhotos();
      });
      row.append(name, remove);
      selectedPhotos.append(row);
    });
  }

  function validateStep(stepNumber, focusFirst = true) {
    const invalid = controlsForStep(stepNumber).filter((control) => {
      if (control.disabled || control.type === "hidden") return false;
      clearFieldError(control);
      if (control.checkValidity()) return false;
      showFieldError(control);
      return true;
    });
    if (stepNumber === 2 && !validatePhotos() && sitePhotos instanceof HTMLInputElement) invalid.push(sitePhotos);
    if (invalid.length > 0 && focusFirst) {
      invalid[0].focus({ preventScroll: true });
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      invalid[0].scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
    }
    return invalid.length === 0;
  }

  function displayValue(name, fallback = "Not added yet") {
    if (!(rentalForm instanceof HTMLFormElement)) return fallback;
    const field = rentalForm.elements.namedItem(name);
    if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
      return field.value.trim() || fallback;
    }
    return fallback;
  }

  function selectedOrOther(name) {
    const value = displayValue(name, "");
    return value === "Other" ? displayValue(`${name}Other`) : value;
  }

  function formattedDate(name) {
    const value = displayValue(name, "");
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return selectedOrOther(name);
    const date = new Date(`${value}T00:00:00`);
    return new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", year: "numeric" }).format(date);
  }

  function updateReview() {
    const reviewContact = document.querySelector("[data-review-contact]");
    const reviewLocation = document.querySelector("[data-review-location]");
    const reviewTiming = document.querySelector("[data-review-timing]");
    const reviewExtras = document.querySelector("[data-review-extras]");
    if (reviewContact instanceof HTMLElement) {
      const email = displayValue("email", "");
      reviewContact.textContent = [displayValue("name"), displayValue("phone"), email].filter(Boolean).join(" · ");
    }
    if (reviewLocation instanceof HTMLElement) {
      const address = [displayValue("addressLine1", ""), displayValue("city", ""), displayValue("state", ""), displayValue("postalCode", "")].filter(Boolean).join(", ");
      const photoCount = sitePhotos instanceof HTMLInputElement && sitePhotos.files ? sitePhotos.files.length : 0;
      reviewLocation.textContent = [address, selectedOrOther("neighborhood"), displayValue("estimatedSize", ""), displayValue("siteDescription", ""), photoCount ? `${photoCount} photo${photoCount === 1 ? "" : "s"} selected` : ""].filter(Boolean).join(" · ");
    }
    if (reviewTiming instanceof HTMLElement) {
      reviewTiming.textContent = [`Setup: ${formattedDate("buildDay")}`, `Takedown: ${formattedDate("takeDownDay")}`, displayValue("timingNotes", "")].filter(Boolean).join(" · ");
    }
    if (reviewExtras instanceof HTMLElement && rentalForm instanceof HTMLFormElement) {
      const extras = Array.from(rentalForm.querySelectorAll('input[name="addOns"]:checked')).map((input) => {
        if (!(input instanceof HTMLInputElement)) return "";
        if (input.value === "Other") return displayValue("addOnsOther", "Other");
        if (input.value === "Furniture") return `Furniture: ${displayValue("furnitureDetails", "details not added")}`;
        return input.dataset.reviewLabel || input.value;
      }).filter(Boolean);
      if (extraServiceToggle instanceof HTMLInputElement && extraServiceToggle.checked) extras.push("Special access or extra labor");
      reviewExtras.textContent = extras.length > 0 ? extras.join(", ") : "None selected";
    }
  }

  function setActiveStep(stepNumber, options = {}) {
    activeStep = Math.min(Math.max(Number(stepNumber) || 1, 1), steps.length);
    steps.forEach((step, index) => {
      if (step instanceof HTMLElement) step.hidden = index + 1 !== activeStep;
    });
    const step = steps[activeStep - 1];
    if (step instanceof HTMLElement) step.setAttribute("aria-current", "step");
    steps.forEach((item, index) => {
      if (item instanceof HTMLElement && index + 1 !== activeStep) item.removeAttribute("aria-current");
    });
    if (activeStep === 5) updateReview();
    if (progressBar instanceof HTMLElement) progressBar.style.width = `${activeStep * 20}%`;
    if (progressTrack instanceof HTMLElement) {
      progressTrack.setAttribute("aria-valuenow", String(activeStep));
      progressTrack.setAttribute("aria-valuetext", `Step ${activeStep} of 5: ${stepNames[activeStep - 1]}`);
    }
    if (currentStep instanceof HTMLElement) currentStep.textContent = String(activeStep);
    if (currentLabel instanceof HTMLElement) currentLabel.textContent = stepNames[activeStep - 1];
    if (backButton instanceof HTMLButtonElement) backButton.hidden = activeStep === 1;
    if (nextButton instanceof HTMLButtonElement) nextButton.hidden = activeStep === steps.length;
    if (submitButton instanceof HTMLButtonElement) submitButton.hidden = activeStep !== steps.length;
    if (submitStatus instanceof HTMLElement && submitStatus.dataset.state !== "success" && submitStatus.dataset.state !== "error") {
      submitStatus.hidden = activeStep !== steps.length;
    }
    if (options.scroll) {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      step?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
    }
    if (options.focusHeading) {
      const heading = step?.querySelector("h3");
      if (heading instanceof HTMLElement) {
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      }
    }
  }

  function updateNeighborhoodOther() {
    if (!(neighborhoodSelect instanceof HTMLSelectElement)) return;
    const show = neighborhoodSelect.value === "Other";
    neighborhoodSelect.setAttribute("aria-expanded", String(show));
    if (neighborhoodOther instanceof HTMLElement) neighborhoodOther.hidden = !show;
    if (neighborhoodOtherInput instanceof HTMLInputElement) {
      neighborhoodOtherInput.disabled = !show;
      neighborhoodOtherInput.required = show;
      if (!show) {
        neighborhoodOtherInput.value = "";
        clearFieldError(neighborhoodOtherInput);
      }
    }
  }

  neighborhoodSelect?.addEventListener("change", updateNeighborhoodOther);
  updateNeighborhoodOther();

  sitePhotos?.addEventListener("change", () => {
    validatePhotos();
    renderSelectedPhotos();
  });

  function updateOtherAddOn() {
    const show = otherAddOn instanceof HTMLInputElement && otherAddOn.checked;
    if (otherAddOn instanceof HTMLInputElement) otherAddOn.setAttribute("aria-expanded", String(show));
    if (otherAddOnField instanceof HTMLElement) otherAddOnField.hidden = !show;
    if (otherAddOnInput instanceof HTMLInputElement) {
      otherAddOnInput.disabled = !show;
      otherAddOnInput.required = show;
      if (!show) {
        otherAddOnInput.value = "";
        clearFieldError(otherAddOnInput);
      }
    }
  }

  otherAddOn?.addEventListener("change", updateOtherAddOn);
  updateOtherAddOn();

  function updateFurnitureDetails() {
    const needsDetails = furnitureToggle instanceof HTMLInputElement && furnitureToggle.checked;
    if (furnitureToggle instanceof HTMLInputElement) furnitureToggle.setAttribute("aria-expanded", String(needsDetails));
    if (furnitureDetails instanceof HTMLElement) furnitureDetails.hidden = !needsDetails;
    if (furnitureDetailsInput instanceof HTMLTextAreaElement) {
      furnitureDetailsInput.disabled = !needsDetails;
      furnitureDetailsInput.required = needsDetails;
      if (!needsDetails) {
        furnitureDetailsInput.value = "";
        clearFieldError(furnitureDetailsInput);
      }
    }
  }

  furnitureToggle?.addEventListener("change", updateFurnitureDetails);
  updateFurnitureDetails();

  function updateExtraServiceDetails() {
    const needsDetails = extraServiceToggle instanceof HTMLInputElement && extraServiceToggle.checked;
    if (extraServiceToggle instanceof HTMLInputElement) extraServiceToggle.setAttribute("aria-expanded", String(needsDetails));
    if (extraServiceRequired instanceof HTMLInputElement) extraServiceRequired.value = needsDetails ? "Yes" : "No";
    if (extraServiceDetails instanceof HTMLElement) extraServiceDetails.hidden = !needsDetails;
    if (extraServiceDetailsInput instanceof HTMLTextAreaElement) {
      extraServiceDetailsInput.disabled = !needsDetails;
      extraServiceDetailsInput.required = needsDetails;
      if (!needsDetails) {
        extraServiceDetailsInput.value = "";
        clearFieldError(extraServiceDetailsInput);
      }
    }
  }

  extraServiceToggle?.addEventListener("change", updateExtraServiceDetails);
  updateExtraServiceDetails();

  function updateQuestionField() {
    const show = questionToggle instanceof HTMLInputElement && questionToggle.checked;
    if (questionToggle instanceof HTMLInputElement) questionToggle.setAttribute("aria-expanded", String(show));
    if (questionField instanceof HTMLElement) questionField.hidden = !show;
    if (questionInput instanceof HTMLTextAreaElement) {
      questionInput.disabled = !show;
      if (!show) {
        questionInput.value = "";
        clearFieldError(questionInput);
      }
    }
  }

  questionToggle?.addEventListener("change", updateQuestionField);
  updateQuestionField();

  rentalForm?.querySelectorAll("input, select, textarea").forEach((field) => {
    field.addEventListener("input", () => clearFieldError(field));
    field.addEventListener("change", () => clearFieldError(field));
  });

  nextButton?.addEventListener("click", () => {
    if (!validateStep(activeStep)) return;
    setActiveStep(activeStep + 1, { scroll: true, focusHeading: true });
  });

  backButton?.addEventListener("click", () => setActiveStep(activeStep - 1, { scroll: true, focusHeading: true }));
  editButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) return;
      setActiveStep(Number(button.dataset.editStep), { scroll: true, focusHeading: true });
    });
  });

  setActiveStep(1);

  rentalForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(rentalForm instanceof HTMLFormElement)) return;
    const invalidStep = steps.findIndex((_, index) => !validateStep(index + 1, false));
    if (invalidStep >= 0) {
      setActiveStep(invalidStep + 1, { scroll: true });
      validateStep(invalidStep + 1);
      return;
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
    }
    if (submitLabel instanceof HTMLElement) submitLabel.textContent = "Sending request...";
    rentalForm.setAttribute("aria-busy", "true");
    if (submitStatus instanceof HTMLElement) {
      submitStatus.hidden = false;
      submitStatus.textContent = "Sending your rental request...";
      submitStatus.dataset.state = "working";
    }

    try {
      const formData = new FormData(rentalForm);
      if (!String(formData.get("questions") || "").trim()) formData.set("questions", "No questions submitted.");
      const response = await fetch("/api/rental-submissions", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: formData,
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok !== true) throw new Error(result?.message || "We could not send your request.");
      rentalForm.reset();
      updateNeighborhoodOther();
      updateOtherAddOn();
      updateFurnitureDetails();
      updateExtraServiceDetails();
      updateQuestionField();
      renderSelectedPhotos();
      if (submitButton instanceof HTMLButtonElement) submitButton.removeAttribute("aria-busy");
      if (submitLabel instanceof HTMLElement) submitLabel.textContent = "Request sent";
      rentalForm.removeAttribute("aria-busy");
      if (submitStatus instanceof HTMLElement) {
        submitStatus.textContent = result.message || "Thank you. Your rental request was sent.";
        submitStatus.dataset.state = "success";
      }
      if (progressRegion instanceof HTMLElement) progressRegion.hidden = true;
      if (wizardCard instanceof HTMLElement) wizardCard.hidden = true;
      if (successMessage instanceof HTMLElement && result?.message) successMessage.textContent = result.message;
      if (successPanel instanceof HTMLElement) {
        successPanel.hidden = false;
        successPanel.focus({ preventScroll: true });
        successPanel.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "center",
        });
      }
    } catch (error) {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
      }
      if (submitLabel instanceof HTMLElement) submitLabel.textContent = "Try again";
      rentalForm.removeAttribute("aria-busy");
      if (submitStatus instanceof HTMLElement) {
        submitStatus.hidden = false;
        submitStatus.textContent = error instanceof Error ? error.message : "We could not send your request. Please try again or call (347) 454-2282.";
        submitStatus.dataset.state = "error";
      }
    }
  });
</script>

