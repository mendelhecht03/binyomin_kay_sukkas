---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sukkah Rentals"
  description="Request a sukkah rental and share your dates, delivery, setup, takedown, and schach preferences."
>
  <section class="rental-hero">
    <div class="shell rental-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Sukkah Rentals</span>
      </nav>
      <p class="eyebrow">Sukkah rentals</p>
      <h1>Tell us what you need.</h1>
      <p class="lead">
        Share your dates and service preferences. We’ll follow up to confirm the
        exact sukkah, availability, and price.
      </p>
    </div>
  </section>

  <section
    id="rental-request"
    class="section google-form-section"
    aria-labelledby="rental-request-heading"
  >
    <div class="narrow-shell">
      <div class="section-heading">
        <p class="eyebrow">Rental request</p>
        <h2 id="rental-request-heading">Complete the form below.</h2>
      </div>

      <div class="google-form-frame">
        <iframe
          class="google-form"
          src="https://docs.google.com/forms/d/e/1FAIpQLSdvF8UbJgSVrSy6ebK6j93vSfEVlkCXshEIHGj1HxFp1bRGBg/viewform?embedded=true"
          title="Sukkah rental request form"
          loading="lazy"
        >
          Loading…
        </iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rental-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    background:
      linear-gradient(90deg, rgba(248, 244, 234, 0.98) 0%, rgba(248, 244, 234, 0.94) 52%, rgba(248, 244, 234, 0.46) 100%),
      url("/assets/images/sample-sukka5.jpg") center / cover;
  }

  .rental-hero::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(180deg, transparent 72%, rgba(16, 45, 37, 0.08));
    pointer-events: none;
  }

  .rental-hero-inner {
    position: relative;
    z-index: 1;
  }

  .rental-hero h1 {
    max-width: 760px;
    font-size: clamp(3rem, 7vw, 5.6rem);
  }

  .rental-hero .lead {
    max-width: 680px;
  }

  .google-form-section {
    background: var(--cream-50);
  }

  .google-form-frame {
    margin-top: 2rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-large);
    background: white;
    box-shadow: var(--shadow-soft);
  }

  .google-form {
    width: 100%;
    height: 2609px;
    display: block;
    border: 0;
  }

  @media (max-width: 640px) {
    .rental-hero {
      padding-block: 3.5rem;
    }

    .google-form-section {
      padding-inline: 0;
    }

    .google-form-section .narrow-shell {
      width: 100%;
    }

    .google-form-section .section-heading {
      width: min(100% - 32px, 720px);
      margin-inline: auto;
    }

    .google-form-frame {
      margin-top: 1.5rem;
      border-inline: 0;
      border-radius: 0;
    }
  }
</style>
