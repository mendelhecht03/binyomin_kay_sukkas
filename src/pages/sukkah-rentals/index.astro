---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormPageActions from "../../components/FormPageActions.astro";
import ManagedRequestForm from "../../components/ManagedRequestForm.astro";
import RentalOverview from "../../components/RentalOverview.astro";
---

<BaseLayout
  title="Sukkah Rentals"
  description="Request a sukkah rental and share your location, size, setup, and takedown preferences."
  bodyClass="rentals-page request-form-page"
>
  <section class="request-hero sukkah-hero-background">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Sukkah Rentals</span>
      </nav>
      <div class="request-hero-copy">
        <p class="eyebrow">SUKKAH RENTALS</p>
        <h1>Tell us what you need.</h1>
        <p class="lead">Share a few details and we’ll follow up with availability and pricing.</p>
        <FormPageActions
          primaryLabel="Start a rental request"
          primaryHref="#rental-request"
          secondaryLabel="See rental details"
          secondaryHref="#rental-overview"
          ariaLabel="Rental request actions"
        />
      </div>
    </div>
  </section>

  <div id="rental-overview"><RentalOverview /></div>
  <ManagedRequestForm slug="rentals" sectionId="rental-request" />
</BaseLayout>

<style>
  .request-hero { padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem); }
  .request-hero-copy { width: min(100%, 880px); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: center; }
  .request-hero-copy .eyebrow { justify-content: center; margin-bottom: .8rem; }
  .request-hero h1 { max-width: 850px; margin: 0 auto 1rem; font-size: clamp(3.15rem, 6vw, 5rem); line-height: 1; }
  .request-hero .lead { max-width: 700px; margin: 0 auto; }
  @media (max-width: 700px) {
    .request-hero { padding-block: 1.35rem 2.5rem; }
    .request-hero-copy { margin-top: 2rem; }
    .request-hero h1 { font-size: clamp(2.55rem, 12vw, 3.7rem); }
  }
</style>
