---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormPageActions from "../../components/FormPageActions.astro";

const pergolaFormHref = "/request/?form=pergolas";

const featuredProject = {
  title: "Freestanding Pergola",
  description:
    "An open timber frame creates a defined backyard room, with a light overhead roof and comfortable seating below.",
  src: "/assets/images/pergola-freestanding-backyard-enhanced.jpg",
  alt: "Freestanding timber pergola over backyard seating with a slatted roof",
  width: 588,
  height: 441,
  tags: ["Freestanding", "Backyard"],
};

const recentProjects = [
  {
    title: "Porch Pergola",
    description:
      "A house-attached porch structure uses bamboo schach overhead and integrated lighting to extend the outdoor living area.",
    src: "/assets/images/pergola-attached-porch.jpeg",
    alt: "House-attached porch pergola with bamboo schach and hanging lights",
    width: 1200,
    height: 1600,
    tags: ["Attached", "Bamboo schach"],
    className: "project-card--porch",
  },
  {
    title: "Courtyard Gathering Pergola",
    description:
      "A wide timber structure spans a paved courtyard, with bamboo overhead, evening lighting, and room for flexible seating.",
    src: "/assets/images/pergola-courtyard-evening.jpeg",
    alt: "Large timber pergola over a paved courtyard with bamboo roof and evening lighting",
    width: 1536,
    height: 2048,
    tags: ["Courtyard", "Bamboo roof", "Evening lighting"],
    className: "project-card--evening",
  },
  {
    title: "Cloth-screened Garden Pergola",
    description:
      "A compact freestanding frame uses soft white cloth screening to create privacy while keeping the structure bright and open.",
    src: "/assets/images/pergola-cloth-screen.jpeg",
    alt: "Freestanding pergola with white cloth side screening beside a row house",
    width: 2016,
    height: 1134,
    tags: ["Freestanding", "Cloth screening", "Privacy"],
    className: "project-card--cloth",
  },
  {
    title: "Open Garden Shade",
    description:
      "An open-sided timber pergola frames a garden seating area and firepit, keeping the space flexible for everyday use.",
    src: "/assets/images/pergola-open-garden.jpeg",
    alt: "Open-sided timber pergola over garden seating and a firepit",
    width: 516,
    height: 387,
    tags: ["Freestanding", "Open sides", "Garden seating"],
    className: "project-card--garden",
  },
];

const supportingProjects = recentProjects.slice(0, 2);
const additionalProjects = recentProjects.slice(2);

const siteFitGroups = [
  {
    title: "How it meets the ground",
    text: "Choose a ground-connected layout, a surface-mounted structure, or a solution that works with an existing deck, patio, or terrace.",
    options: ["Ground-connected posts", "Surface-mounted footings", "Existing deck or patio", "Rooftop or terrace"],
  },
  {
    title: "How it meets the house",
    text: "The frame can be planned around the building instead of forcing the space into a preset footprint.",
    options: ["Freestanding", "Attached to the house", "Partly attached / partly freestanding", "Set beside a porch or deck"],
  },
  {
    title: "What the site needs",
    text: "Access, drainage, grade changes, trees, utilities, doors, and sightlines all shape a comfortable result.",
    options: ["Backyards", "Porches and decks", "Courtyards", "Side yards", "Driveways", "Rooftops and terraces"],
  },
];

const customizationGroups = [
  {
    slug: "structure",
    title: "Structure and materials",
    summary: "Start with the frame, proportions, and finish that fit the property.",
    prompt: "View structure options",
    items: [
      { title: "Wood frame", description: "A warm natural frame that can be left clear, stained, painted, or coordinated with the house." },
      { title: "Metal frame", description: "A clean profile with a painted or powder-coated finish for a more contemporary direction." },
      { title: "Mixed materials", description: "Combine a wood appearance with metal details, brackets, screening, or custom trim." },
      { title: "Proportions and details", description: "Tune post placement, beam depth, roof height, trim, and clearances around the way the space is used." },
    ],
  },
  {
    slug: "roof",
    title: "Roof and shade",
    summary: "Create an open roof, seasonal shade, or a more covered outdoor room.",
    prompt: "View roof options",
    items: [
      { title: "Open slats", description: "A classic pergola roof that keeps the structure airy while adding rhythm and partial shade." },
      { title: "Bamboo schach", description: "A natural overhead layer that can also support a Sukkos-oriented layout where appropriate." },
      { title: "Fabric canopy", description: "Cloth panels or a canopy for a softer look and adjustable shade." },
      { title: "Retractable tarp or shade", description: "A flexible covering direction for changing sun, weather, or seasonal use." },
      { title: "Solid or weather cover", description: "Discuss a more protective roof when shelter from rain or snow is part of the goal." },
    ],
  },
  {
    slug: "sides",
    title: "Sides, screens, and siding",
    summary: "Keep the sides open or add privacy, wind protection, and visual character.",
    prompt: "View side options",
    items: [
      { title: "Wood slats or lattice", description: "Add texture and partial privacy while keeping light and air moving through the space." },
      { title: "Metal panels", description: "Use a durable painted or powder-coated panel for a stronger graphic finish." },
      { title: "Fabric or cloth", description: "Soft curtains and cloth panels can make a compact porch or garden structure feel more private." },
      { title: "Clear or screened panels", description: "Consider clear panels, insect screening, or a combination where the site calls for it." },
      { title: "Custom artwork", description: "Plan a mural, printed panel, decorative cutout, or other artwork as part of the side treatment." },
    ],
  },
  {
    slug: "comfort",
    title: "Comfort and expression",
    summary: "Finish the pergola around how you actually want to spend time there.",
    prompt: "View finishing options",
    items: [
      { title: "Lighting and electrical", description: "Plan practical lighting, string lights, outlets, switches, and fixture locations." },
      { title: "Fans, heaters, and shades", description: "Leave room for comfort features that extend the useful season." },
      { title: "Seating and serving", description: "Coordinate built-in seating, a counter, table area, gates, or storage where useful." },
      { title: "Greenery and planters", description: "Use planters, trellises, or climbing greenery to soften the frame and connect it to the garden." },
      { title: "Color and finish", description: "Match the house, keep a natural wood look, or choose a stronger painted metal or fabric color." },
    ],
  },
];

const planningSteps = [
  ["1", "Share the space", "Send approximate dimensions, a few wide photos, and the way you want to use the area."],
  ["2", "Plan the structure", "Review attachment, ground connection, roof, screening, materials, and useful finishing details."],
  ["3", "Confirm the next step", "BK Sukkah can review the scope, access, timing, and quote before anything is scheduled."],
];
---

<BaseLayout
  title="Pergolas"
  description="Explore pergola projects planned around backyards, porches, courtyards, and other outdoor spaces."
>
  <div class="pergola-page">
    <section class="custom-hero sukkah-hero-background" aria-labelledby="pergola-heading">
      <div class="shell custom-hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span>Pergolas</span>
        </nav>
        <div class="custom-hero__copy">
          <p class="eyebrow">Custom pergolas</p>
          <h1 id="pergola-heading">Built around the way you use the outdoors.</h1>
          <p class="lead">
            From a freestanding backyard shade structure to a house-attached porch,
            each pergola is planned around the site, the connection, and the finish you want.
          </p>
          <FormPageActions
            primaryLabel="Start a pergola request"
            primaryHref={pergolaFormHref}
            secondaryLabel="See recent projects"
            secondaryHref="#recent-projects"
            ariaLabel="Pergola actions"
          />
        </div>
      </div>
    </section>

    <section id="recent-projects" class="section projects-section" aria-labelledby="recent-projects-heading">
      <div class="shell">
        <div class="section-heading projects-heading">
          <p class="eyebrow">Recent projects</p>
          <h2 id="recent-projects-heading">A few ways the frame can work.</h2>
          <p class="lead">Every site asks for a slightly different answer. These examples show the range from open garden shade to attached porch and courtyard structures.</p>
        </div>

        <div class="project-showcase">
          <article class="featured-project">
            <figure class="featured-project__media"><img src={featuredProject.src} alt={featuredProject.alt} width={featuredProject.width} height={featuredProject.height} loading="eager" fetchpriority="high" /></figure>
            <div class="featured-project__content">
              <p class="project-kicker">Featured build</p><h3>{featuredProject.title}</h3><p>{featuredProject.description}</p>
              <ul class="project-tags" aria-label="Featured project details">{featuredProject.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
          <div class="project-showcase__side">
            {supportingProjects.map((project) => (
              <article class:list={["project-card", "project-card--compact", project.className]}>
                <figure class="project-card__media"><img src={project.src} alt={project.alt} width={project.width} height={project.height} loading="lazy" /></figure>
                <div class="project-card__content"><p class="project-kicker">Recent work</p><h3>{project.title}</h3><p>{project.description}</p><ul class="project-tags" aria-label={project.title + " details"}>{project.tags.map((tag) => <li>{tag}</li>)}</ul></div>
              </article>
            ))}
          </div>
        </div>

        <div class="project-grid">
          {additionalProjects.map((project) => (
            <article class:list={["project-card", project.className]}>
              <figure class="project-card__media"><img src={project.src} alt={project.alt} width={project.width} height={project.height} loading="lazy" /></figure>
              <div class="project-card__content"><p class="project-kicker">Recent work</p><h3>{project.title}</h3><p>{project.description}</p><ul class="project-tags" aria-label={project.title + " details"}>{project.tags.map((tag) => <li>{tag}</li>)}</ul></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted fit-section" aria-labelledby="designed-around-heading">
      <div class="shell fit-panel">
        <div><p class="eyebrow">Designed around the site</p><h2 id="designed-around-heading">The connection is part of the design.</h2></div>
        <div class="fit-copy"><p>A pergola can be connected to the ground, connected to the house, or planned as a freestanding structure. We can work through the practical tradeoffs around the property instead of starting with a one-size-fits-all kit.</p><div class="site-fit-grid">{siteFitGroups.map((group) => <article><h3>{group.title}</h3><p>{group.text}</p><ul class="use-case-list">{group.options.map((option) => <li>{option}</li>)}</ul></article>)}</div></div>
      </div>
    </section>

    <section class="section customization-section" aria-labelledby="customization-heading">
      <div class="shell">
        <div class="section-heading customization-heading"><p class="eyebrow">Customize your build</p><h2 id="customization-heading">Make the shade, sides, and details feel like yours.</h2><p>Open each category to explore directions for the conversation. Exact materials, availability, and construction details are confirmed for the specific site.</p></div>
        <div class="customization-grid">
          {customizationGroups.map((group) => (
            <details class="customization-card">
              <summary aria-controls={"customization-" + group.slug}><span class="customization-card__title">{group.title}</span><span class="customization-card__summary">{group.summary}</span><span class="customization-card__prompt"><span class="prompt-closed">{group.prompt}</span><span class="prompt-open">Hide options</span></span></summary>
              <div class="customization-card__body" id={"customization-" + group.slug}><ul class="option-list">{group.items.map((item) => <li><h3>{item.title}</h3><p>{item.description}</p></li>)}</ul></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section planning-section" aria-labelledby="planning-heading">
      <div class="shell planning-panel"><div class="planning-intro"><p class="eyebrow">A clear starting point</p><h2 id="planning-heading">From a few photos to a practical plan.</h2><p class="site-visit-copy">You do not need every answer before reaching out.</p><p>Start with the space, the way you want to use it, and the details you already know. The rest can be worked through during the conversation.</p></div><ol class="process-list">{planningSteps.map(([number, title, text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div>
    </section>

    <section class="section-compact custom-cta" aria-labelledby="quote-heading">
      <div class="shell"><div class="cta-panel"><div><p class="eyebrow">Pergola quote</p><h2 id="quote-heading">Have a space in mind?</h2><p>Tell us where the pergola would go, how you want to use it, and which materials or shade ideas caught your eye.</p></div><div class="button-row"><a class="button button-light" href={pergolaFormHref}>Start a pergola request</a><a class="button custom-cta__phone" href="tel:+13474542282">Call (347) 454-2282</a></div></div></div>
    </section>
  </div>
</BaseLayout>

<style>
  .pergola-page { overflow: clip; padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .custom-hero { padding-block: clamp(1.75rem, 3vw, 2.5rem) clamp(3rem, 5vw, 4.25rem); }
  .custom-hero__inner { position: relative; z-index: 1; }
  .custom-hero .breadcrumb { margin-bottom: 0; }
  .custom-hero__copy { width: min(100%, 820px); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: center; }
  .custom-hero__copy .eyebrow { justify-content: center; margin-bottom: .8rem; }
  .custom-hero h1 { max-width: 800px; margin: 0 auto 1rem; font-size: clamp(3rem, 6vw, 5rem); line-height: 1; }
  .custom-hero .lead { max-width: 700px; margin: 0 auto; font-size: clamp(1.05rem, 1.7vw, 1.2rem); }
  .section { padding-block: clamp(4rem, 8vw, 7rem); }
  .projects-section { padding-top: clamp(3rem, 6vw, 5rem); }
  .section-heading { max-width: 52rem; margin-bottom: 2rem; }
  .section-heading h2 { max-width: 18ch; }
  .section-heading .lead { max-width: 44rem; }
  .project-showcase { display: grid; grid-template-columns: minmax(0, 1.22fr) minmax(18rem, .78fr); gap: 1rem; }
  .featured-project, .project-card { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--white); box-shadow: 0 16px 38px rgba(16,45,37,.06); }
  .featured-project { display: grid; grid-template-rows: minmax(16rem, 1fr) auto; }
  .featured-project__media, .project-card__media { position: relative; overflow: hidden; min-width: 0; margin: 0; background: var(--forest-100); }
  .featured-project__media { min-height: 22rem; }
  .featured-project__media img, .project-card__media img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; transition: transform 280ms ease; }
  .featured-project:hover img, .project-card:hover img { transform: scale(1.025); }
  .featured-project__content, .project-card__content { padding: clamp(1.35rem, 3vw, 2rem); }
  .project-kicker { margin: 0 0 .5rem; color: var(--wood-600); font-size: .73rem; font-weight: 850; letter-spacing: .09em; text-transform: uppercase; }
  .featured-project h3, .project-card h3 { margin: 0 0 .5rem; color: var(--forest-950); font-family: var(--font-heading); font-size: clamp(1.55rem, 2.7vw, 2.25rem); line-height: 1.08; }
  .project-card h3 { font-size: clamp(1.35rem, 2.2vw, 1.8rem); }
  .featured-project p:not(.project-kicker), .project-card p:not(.project-kicker) { margin: 0 0 1rem; color: var(--ink-500); line-height: 1.55; }
  .project-tags, .use-case-list { display: flex; flex-wrap: wrap; gap: .48rem; margin: 0; padding: 0; list-style: none; }
  .project-tags li, .use-case-list li { min-height: 32px; display: inline-flex; align-items: center; padding: .36rem .66rem; border: 1px solid rgba(23,63,52,.15); border-radius: 999px; color: var(--forest-900); background: rgba(255,255,255,.72); font-size: .76rem; font-weight: 800; line-height: 1.2; }
  .project-showcase__side { display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .project-card--compact { display: grid; grid-template-columns: minmax(8rem, .82fr) minmax(0, 1.18fr); min-width: 0; }
  .project-card--compact .project-card__media { min-height: 0; }
  .project-card--compact .project-card__content { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 1.2rem; }
  .project-card--compact .project-card__content > p:not(.project-kicker) { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  .project-card--compact .project-tags li:nth-child(n + 3) { display: none; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .project-card__media { aspect-ratio: 16 / 10; }
  .project-card--porch .project-card__media img { object-position: center 62%; }
  .project-card--evening .project-card__media img { object-position: center 52%; }
  .project-card--cloth .project-card__media img { object-position: center 48%; }
  .project-card--garden .project-card__media img { object-position: center 45%; }
  .fit-panel { display: grid; grid-template-columns: minmax(16rem, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 7vw, 5rem); align-items: start; }
  .fit-panel h2 { max-width: 11ch; }
  .fit-copy > p:first-child { max-width: 44rem; margin-bottom: 1.6rem; font-size: 1.06rem; line-height: 1.65; }
  .site-fit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .site-fit-grid article { padding-top: 1rem; border-top: 1px solid rgba(23,63,52,.16); }
  .site-fit-grid h3 { margin: 0 0 .4rem; color: var(--forest-900); font-family: var(--font-nav); font-size: 1rem; }
  .site-fit-grid p { margin: 0 0 .85rem; color: var(--ink-500); font-size: .88rem; line-height: 1.5; }
  .site-fit-grid .use-case-list { display: grid; gap: .4rem; }
  .site-fit-grid .use-case-list li { min-height: auto; padding: .48rem .6rem; border-radius: var(--radius-small); background: var(--white); font-size: .74rem; }
  .customization-heading { max-width: 48rem; }
  .customization-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .customization-card { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--white); transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .customization-card:hover, .customization-card:focus-within { border-color: var(--border-strong); box-shadow: 0 20px 48px rgba(16,45,37,.08); transform: translateY(-2px); }
  .customization-card[open] { border-color: rgba(150,87,32,.32); }
  .customization-card summary { position: relative; min-height: 14rem; display: flex; flex-direction: column; padding: 1.35rem 3rem 1.25rem 1.25rem; cursor: pointer; list-style: none; }
  .customization-card summary::-webkit-details-marker { display: none; }
  .customization-card summary::after { position: absolute; top: 1.2rem; right: 1.1rem; width: 2rem; height: 2rem; display: grid; place-items: center; border: 1px solid rgba(23,63,52,.18); border-radius: 999px; color: var(--forest-900); content: "+"; font-size: 1.15rem; transition: transform 180ms ease, background-color 180ms ease; }
  .customization-card[open] summary::after { content: "−"; background: var(--forest-100); transform: rotate(180deg); }
  .customization-card__title { max-width: 12ch; color: var(--forest-950); font-family: var(--font-heading); font-size: 1.45rem; font-weight: 700; line-height: 1.08; }
  .customization-card__summary { margin-top: .65rem; color: var(--ink-500); font-size: .87rem; line-height: 1.5; }
  .customization-card__prompt { margin-top: auto; padding-top: 1rem; color: var(--wood-600); font-size: .77rem; font-weight: 850; }
  .prompt-open, .customization-card[open] .prompt-closed { display: none; }
  .customization-card[open] .prompt-open { display: inline; }
  .customization-card__body { padding: 0 1.25rem 1.25rem; border-top: 1px solid rgba(23,63,52,.11); }
  .option-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .option-list li { padding: .9rem 0; border-bottom: 1px solid rgba(23,63,52,.1); }
  .option-list li:last-child { padding-bottom: 0; border-bottom: 0; }
  .option-list h3 { margin: 0 0 .2rem; color: var(--forest-900); font-family: var(--font-nav); font-size: .9rem; }
  .option-list p { margin: 0; color: var(--ink-500); font-size: .82rem; line-height: 1.48; }
  .planning-panel { display: grid; grid-template-columns: minmax(0, .9fr) minmax(24rem, 1.1fr); gap: clamp(2.5rem, 7vw, 5rem); padding: clamp(2rem, 5vw, 4rem); border: 1px solid rgba(23,63,52,.13); border-radius: var(--radius-large); background: var(--forest-100); }
  .planning-intro h2 { max-width: 13ch; }
  .site-visit-copy { color: var(--forest-900); font-size: 1.08rem; font-weight: 750; line-height: 1.55; }
  .planning-intro p:last-child { margin-bottom: 0; }
  .process-list { display: grid; align-content: start; margin: 0; padding: 0; list-style: none; }
  .process-list li { display: grid; grid-template-columns: 2rem 1fr; gap: .9rem; padding: 1.05rem 0; border-top: 1px solid rgba(23,63,52,.16); }
  .process-list li:last-child { border-bottom: 1px solid rgba(23,63,52,.16); }
  .process-list > li > span { width: 2rem; height: 2rem; display: grid; place-items: center; border: 1px solid rgba(150,87,32,.3); border-radius: var(--radius-small); color: var(--wood-600); background: rgba(255,253,248,.62); font-size: .82rem; font-weight: 850; }
  .process-list h3 { margin: 0 0 .25rem; color: var(--forest-900); font-family: var(--font-nav); font-size: 1rem; }
  .process-list p { margin: 0; font-size: .92rem; line-height: 1.5; }
  .custom-cta .cta-panel { gap: clamp(1.5rem, 4vw, 3rem); }
  .custom-cta .eyebrow { color: #f0bd7e; }
  .custom-cta__phone { border-color: rgba(255,255,255,.72); color: var(--cream-50); background: transparent; }
  .custom-cta__phone:hover { border-color: var(--cream-50); color: var(--forest-950); background: var(--cream-50); }
  @media (max-width: 70rem) { .customization-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 60rem) { .project-showcase, .fit-panel, .planning-panel { grid-template-columns: 1fr; } .project-showcase__side { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; } .project-card--compact { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, auto); align-content: start; } .project-card--compact .project-card__media { width: 100%; height: auto; min-height: 0; aspect-ratio: 16 / 10; } .project-card--compact .project-card__content { min-height: 0; overflow: hidden; justify-content: flex-start; } .site-fit-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 46rem) { .custom-hero { padding-block: 1.35rem 2.5rem; } .custom-hero__copy { margin-top: 2rem; } .custom-hero h1 { font-size: clamp(2.55rem, 12vw, 3.7rem); } .project-showcase__side, .project-grid, .site-fit-grid, .customization-grid { grid-template-columns: 1fr; } .featured-project__media, .project-card__media { aspect-ratio: 16 / 10; min-height: 0; } .featured-project__content, .project-card__content { padding: 1.3rem; } .planning-panel { padding: 1.35rem; } }
  @media (max-width: 30rem) { .featured-project, .project-card, .customization-card, .planning-panel { border-radius: var(--radius); } .featured-project__media, .project-card__media { aspect-ratio: 4 / 3; } }
  @media (prefers-reduced-motion: reduce) { .featured-project__media img, .project-card__media img, .customization-card, .customization-card summary::after { transition: none; } }
</style>
