---
const { icon, eyebrow, heading, id } = Astro.props;
---

<div class="form-group-heading">
  <span class="step-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {icon === "contact" && <><circle cx="12" cy="8" r="3.25" /><path d="M5.75 19c.65-3.25 2.75-5 6.25-5s5.6 1.75 6.25 5" /></>}
      {icon === "location" && <><path d="M19 10c0 5-7 10-7 10S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.25" /></>}
      {icon === "sukkah" && <><path d="M5 20V9h14v11M4 9h16" /><path d="M5 7.5c1-1 2-1 3 0s2 1 3 0 2-1 3 0 2 1 3 0 2-1 3 0M9.5 20v-7h5v7" /></>}
      {icon === "site" && <><rect x="3.5" y="5" width="17" height="14" rx="2" /><circle cx="9" cy="10" r="1.5" /><path d="m5.5 17 4-4 3 3 2-2 4 3" /></>}
      {icon === "timing" && <><rect x="4" y="5.5" width="16" height="14" rx="2" /><path d="M8 3.5v4M16 3.5v4M4 10h16" /><path d="m9.5 15 1.5 1.5 3.5-4" /></>}
      {icon === "final" && <><path d="M8 5h8M9 3.5h6v3H9z" /><path d="M7 5.5H5.5v15h13v-15H17" /><path d="m8.5 14 2.25 2.25 4.75-5" /></>}
    </svg>
  </span>
  <div><p class="eyebrow">{eyebrow}</p><h3 id={id}>{heading}</h3></div>
</div>
