---
const { legend, name, options, type, required = false, requiredHint = false, otherLabel, stacked = false } = Astro.props;
---

<fieldset>
  <legend>{legend} {(required || requiredHint) && <span class="required-mark">*</span>}</legend>
  {requiredHint && <p class="field-hint">{type === "radio" ? "Choose one." : "Choose one or more."}</p>}
  <div class={stacked ? "choice-stack" : "choice-grid"}>
    {options.map((option) => (
      <label class="choice-card"><input type={type} name={name} value={option} required={type === "radio" && required} /><span>{option}</span></label>
    ))}
    <label class="choice-card choice-other">
      <input type={type} name={name} value="Other" required={type === "radio" && required} />
      <span>Other</span>
      <input name={`${name}Other`} aria-label={otherLabel} placeholder="Please describe" />
    </label>
  </div>
</fieldset>
