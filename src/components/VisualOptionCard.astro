---
interface Props {
  title: string;
  description?: string;
  src: string;
  alt: string;
  width: number;
  height: number;
  className?: string;
}

const { title, description, src, alt, width, height, className = "" } = Astro.props;
---

<figure class:list={["visual-option-card", className]}>
  <div class="visual-option-card__media">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" />
  </div>
  <figcaption>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </figcaption>
</figure>

<style>
  .visual-option-card {
    min-width: 0;
    height: 100%;
    display: flex;
    margin: 0;
    overflow: hidden;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 6px 18px rgba(16, 45, 37, 0.055);
  }

  .visual-option-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--cream-200);
  }

  .visual-option-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 0.4rem;
    padding: 1.15rem 1.2rem 1.25rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.28rem, 2vw, 1.55rem);
  }

  p {
    margin: 0;
    color: var(--ink-600);
    font-size: 0.94rem;
    line-height: 1.52;
  }
</style>
