---
interface Props {
  label: string;
  description?: string;
  ratio?: "wide" | "standard" | "square" | "portrait";
}

const {
  label,
  description = "A real project photo will be added here when it is available.",
  ratio = "standard",
} = Astro.props;
---

<figure class="media-placeholder" data-ratio={ratio}>
  <div class="media-placeholder__frame">
    <svg
      class="media-placeholder__icon"
      viewBox="0 0 48 48"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M8 35V15l16-8 16 8v20" />
      <path d="M4 35h40M14 35V19h20v16M20 35V24h8v11" />
      <path d="M14 15h20" />
    </svg>
    <span>Photo coming soon</span>
  </div>
  <figcaption>
    <strong>{label}</strong>
    <span>{description}</span>
  </figcaption>
</figure>

<style>
  .media-placeholder {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
    margin: 0;
  }

  .media-placeholder__frame {
    aspect-ratio: 4 / 3;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px dashed rgba(23, 63, 50, 0.38);
    border-radius: 0.9rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(235, 226, 207, 0.65)),
      #f7f2e8;
    color: #315c4c;
    text-align: center;
  }

  [data-ratio="wide"] .media-placeholder__frame {
    aspect-ratio: 16 / 10;
  }

  [data-ratio="square"] .media-placeholder__frame {
    aspect-ratio: 1;
  }

  [data-ratio="portrait"] .media-placeholder__frame {
    aspect-ratio: 4 / 5;
  }

  .media-placeholder__icon {
    width: 3rem;
    height: 3rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .media-placeholder__frame span {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
    color: #56645e;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  figcaption strong {
    color: #173f32;
    font-size: 1rem;
  }

  figcaption span {
    max-width: 36rem;
  }
</style>
