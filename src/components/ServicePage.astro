---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Action {
  label: string;
  href: string;
}

interface TextItem {
  title: string;
  text: string;
}

interface Service {
  slug: string;
  eyebrow: string;
  title: string;
  metaTitle: string;
  description: string;
  summary: string;
  heroPlaceholder: string;
  primaryAction: Action;
  secondaryAction?: Action;
  highlights: TextItem[];
  requestItems: string[];
  mediaPlaceholders: string[];
  steps: TextItem[];
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const heroHeadingId = `${service.slug}-heading`;
---

<BaseLayout title={service.metaTitle} description={service.description}>
  <div class="service-page">
    <section class="service-hero" aria-labelledby={heroHeadingId}>
      <div class="service-hero__copy">
        <p class="eyebrow">{service.eyebrow}</p>
        <h1 id={heroHeadingId}>{service.title}</h1>
        <p class="service-hero__summary">{service.summary}</p>
        <div class="action-row">
          <a class="action action--primary" href={service.primaryAction.href}>
            {service.primaryAction.label}
          </a>
          {
            service.secondaryAction && (
              <a class="action action--secondary" href={service.secondaryAction.href}>
                {service.secondaryAction.label}
              </a>
            )
          }
        </div>
      </div>

      <div class="service-hero__media">
        <MediaPlaceholder
          label={service.heroPlaceholder}
          description="This space is reserved for a real example of this service."
          ratio="wide"
        />
      </div>
    </section>

    <section class="section-shell" aria-labelledby={`${service.slug}-details-heading`}>
      <div class="section-heading">
        <p class="eyebrow">A clearer starting point</p>
        <h2 id={`${service.slug}-details-heading`}>Useful details before you reach out</h2>
      </div>
      <div class="highlight-grid">
        {
          service.highlights.map((highlight) => (
            <article class="highlight-card">
              <h3>{highlight.title}</h3>
              <p>{highlight.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="request-section" aria-labelledby={`${service.slug}-request-heading`}>
      <div>
        <p class="eyebrow">What to share</p>
        <h2 id={`${service.slug}-request-heading`}>Help make the first conversation useful.</h2>
        <p>
          You do not need every answer before getting in touch. These details simply make
          it easier to understand the request.
        </p>
      </div>
      <ul class="check-list">
        {service.requestItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section-shell" aria-labelledby={`${service.slug}-process-heading`}>
      <div class="section-heading">
        <p class="eyebrow">Simple process</p>
        <h2 id={`${service.slug}-process-heading`}>From request to next step</h2>
      </div>
      <ol class="process-grid">
        {
          service.steps.map((step, index) => (
            <li>
              <span aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section-shell" aria-labelledby={`${service.slug}-photos-heading`}>
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Project photos</p>
          <h2 id={`${service.slug}-photos-heading`}>Real examples will be added here.</h2>
        </div>
        <p>
          These fixed-size spaces keep the page ready for photography without pretending
          that temporary images are completed customer projects.
        </p>
      </div>
      <div class="media-grid">
        {
          service.mediaPlaceholders.map((label) => (
            <MediaPlaceholder label={label} />
          ))
        }
      </div>
    </section>

    <section class="contact-band" aria-labelledby={`${service.slug}-contact-heading`}>
      <div>
        <p class="eyebrow">Ready to ask?</p>
        <h2 id={`${service.slug}-contact-heading`}>Start with the details you already have.</h2>
      </div>
      <a class="action action--light" href={service.primaryAction.href}>
        {service.primaryAction.label}
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .service-page {
    width: min(100% - 2rem, 74rem);
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }

  .service-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(19rem, 0.96fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(1.4rem, 4vw, 3.5rem);
    border: 1px solid rgba(23, 63, 50, 0.13);
    border-radius: 1.25rem;
    background: linear-gradient(135deg, #fffdf8 0%, #f5ecdc 100%);
    box-shadow: 0 1.25rem 3.5rem rgba(35, 46, 40, 0.08);
  }

  .service-hero__copy,
  .service-hero__media,
  .section-heading,
  .request-section > div {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #33654f;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: #173f32;
    text-wrap: balance;
  }

  h1 {
    max-width: 13ch;
    margin-bottom: 1.25rem;
    font-size: clamp(2.35rem, 6vw, 4.7rem);
    line-height: 0.98;
  }

  h2 {
    margin-bottom: 0.8rem;
    font-size: clamp(1.75rem, 3.5vw, 2.7rem);
    line-height: 1.1;
  }

  h3 {
    margin-bottom: 0.45rem;
    font-size: 1.12rem;
  }

  p {
    color: #59675f;
    line-height: 1.7;
  }

  .service-hero__summary {
    max-width: 38rem;
    margin-bottom: 1.5rem;
    font-size: 1.08rem;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 0.7rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .action:hover {
    transform: translateY(-1px);
  }

  .action:focus-visible {
    outline: 3px solid rgba(184, 137, 66, 0.55);
    outline-offset: 3px;
  }

  .action--primary {
    background: #1f5f46;
    color: white;
  }

  .action--primary:hover {
    background: #173f32;
  }

  .action--secondary {
    border-color: rgba(23, 63, 50, 0.25);
    background: rgba(255, 255, 255, 0.76);
    color: #173f32;
  }

  .action--secondary:hover {
    border-color: rgba(23, 63, 50, 0.42);
    background: white;
  }

  .section-shell {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .section-heading {
    max-width: 46rem;
    margin-bottom: 1.75rem;
  }

  .section-heading--split {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: 2rem;
    align-items: end;
  }

  .section-heading--split p:last-child {
    margin-bottom: 0.35rem;
  }

  .highlight-grid,
  .media-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .highlight-card {
    padding: 1.35rem;
    border: 1px solid rgba(23, 63, 50, 0.14);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.78);
  }

  .highlight-card p {
    margin-bottom: 0;
  }

  .request-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 1.1rem;
    background: #173f32;
  }

  .request-section h2,
  .request-section .eyebrow,
  .request-section p {
    color: white;
  }

  .request-section .eyebrow {
    color: #e7c88f;
  }

  .request-section p {
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .check-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    color: white;
    list-style: none;
  }

  .check-list li {
    position: relative;
    padding: 0.85rem 1rem 0.85rem 3rem;
    border: 1px solid rgba(255, 255, 255, 0.17);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.06);
    line-height: 1.55;
  }

  .check-list li::before {
    content: "✓";
    position: absolute;
    top: 0.78rem;
    left: 1rem;
    color: #e7c88f;
    font-weight: 900;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-grid li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .process-grid li > span {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #e8d3ab;
    color: #173f32;
    font-weight: 900;
  }

  .process-grid p {
    margin-bottom: 0;
  }

  .contact-band {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 1.1rem;
    background: linear-gradient(110deg, #1f5f46, #173f32);
  }

  .contact-band .eyebrow {
    color: #e7c88f;
  }

  .contact-band h2 {
    max-width: 24ch;
    margin-bottom: 0;
    color: white;
  }

  .action--light {
    flex: 0 0 auto;
    background: #fffaf0;
    color: #173f32;
  }

  .action--light:hover {
    background: white;
  }

  @media (max-width: 56rem) {
    .service-hero,
    .request-section {
      grid-template-columns: 1fr;
    }

    .service-hero__media {
      max-width: 40rem;
    }

    .highlight-grid,
    .media-grid,
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-heading--split {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 40rem) {
    .service-page {
      width: min(100% - 1.25rem, 74rem);
    }

    .service-hero {
      gap: 1.5rem;
      border-radius: 1rem;
    }

    .highlight-grid,
    .media-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .action-row,
    .contact-band {
      align-items: stretch;
      flex-direction: column;
    }

    .action-row .action,
    .contact-band .action {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }
  }
</style>
