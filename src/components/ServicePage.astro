---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

interface Action {
  label: string;
  href: string;
}

interface TextItem {
  title: string;
  text: string;
}

interface Service {
  slug: string;
  eyebrow: string;
  title: string;
  metaTitle: string;
  description: string;
  summary: string;
  heroPlaceholder?: string;
  heroNote?: string;
  showMedia?: boolean;
  primaryAction: Action;
  secondaryAction?: Action;
  highlights: TextItem[];
  requestItems: string[];
  mediaPlaceholders: string[];
  steps: TextItem[];
  quote?: TextItem;
}

interface Props {
  service: Service;
  showSecondaryAction?: boolean;
  showRequestSection?: boolean;
}

const {
  service,
  showSecondaryAction = true,
  showRequestSection = true,
} = Astro.props;
const showMedia = service.showMedia !== false;
const heroHeadingId = `${service.slug}-heading`;
---

<BaseLayout title={service.metaTitle} description={service.description}>
  <div class:list={["service-page", { "service-page--text-first": !showMedia }]}>
    <section class="service-hero sukkah-hero-background" aria-labelledby={heroHeadingId}>
      <div class="shell">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{service.eyebrow}</span>
        </nav>

        <div class="service-hero__inner">
          <div class="service-hero__copy">
            <p class="eyebrow">{service.eyebrow}</p>
            <h1 id={heroHeadingId}>{service.title}</h1>
            <p class="lead">{service.summary}</p>
            <div class="button-row">
              <a class="button" href={service.primaryAction.href}>{service.primaryAction.label}</a>
              {
                showSecondaryAction && service.secondaryAction && (
                  <a class="button button-secondary" href={service.secondaryAction.href}>
                    {service.secondaryAction.label}
                  </a>
                )
              }
            </div>
          </div>

          {
            showMedia ? (
              <div class="service-hero__media">
                <MediaPlaceholder
                  label={service.heroPlaceholder || "A real project example will be added here"}
                  description="This space is reserved for a real example of this service."
                  ratio="wide"
                />
              </div>
            ) : (
              <aside class="service-hero__note" aria-label="Service note">
                <p class="eyebrow">A clear starting point</p>
                <strong>{service.heroNote || "Start with the space and the details you already have."}</strong>
                <p>Share what you know, and we can work through the practical next step together.</p>
              </aside>
            )
          }
        </div>
      </div>
    </section>

    {
      service.quote && (
        <section class="section service-quote" aria-labelledby={`${service.slug}-quote-heading`}>
          <div class="shell">
            <div class="section-heading service-quote__copy">
              <p class="eyebrow">{service.quote.title}</p>
              <h2 id={`${service.slug}-quote-heading`}>A clear way to start.</h2>
              <p>{service.quote.text}</p>
            </div>
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby={`${service.slug}-details-heading`}>
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">A practical scope</p>
          <h2 id={`${service.slug}-details-heading`}>Start with the part of the site that needs attention.</h2>
        </div>

        <div class="service-highlight-grid">
          {
            service.highlights.map((highlight) => (
              <article class="service-highlight">
                <h3>{highlight.title}</h3>
                <p>{highlight.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {
      showRequestSection && (
        <section class="section section-muted" aria-labelledby={`${service.slug}-request-heading`}>
          <div class="shell service-request-grid">
            <div>
              <p class="eyebrow">What to share</p>
              <h2 id={`${service.slug}-request-heading`}>Make the first conversation useful.</h2>
              <p>
                You do not need every answer before getting in touch. These details simply make
                it easier to understand the location and the work you have in mind.
              </p>
            </div>
            <ul class="feature-list">
              {service.requestItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby={`${service.slug}-process-heading`}>
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">A clear process</p>
          <h2 id={`${service.slug}-process-heading`}>From the first message to the next step.</h2>
        </div>
        <ol class="service-process-grid">
          {
            service.steps.map((step, index) => (
              <li>
                <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      showMedia && service.mediaPlaceholders.length > 0 && (
        <section class="section section-muted" aria-labelledby={`${service.slug}-photos-heading`}>
          <div class="shell">
            <div class="section-heading">
              <p class="eyebrow">Project photos</p>
              <h2 id={`${service.slug}-photos-heading`}>Real examples can be added here.</h2>
              <p>These fixed-size spaces keep the page ready for approved project photography.</p>
            </div>
            <div class="service-media-grid">
              {service.mediaPlaceholders.map((label) => <MediaPlaceholder label={label} />)}
            </div>
          </div>
        </section>
      )
    }

    <section class="section-compact service-cta" aria-labelledby={`${service.slug}-contact-heading`}>
      <div class="shell">
        <div class="cta-panel">
          <div>
            <p class="eyebrow">Ready to talk?</p>
            <h2 id={`${service.slug}-contact-heading`}>Contact today and start with the details you have.</h2>
            <p>We can review the location, timing, and practical next step together.</p>
          </div>
          <a class="button button-light" href={service.primaryAction.href}>{service.primaryAction.label}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-page {
    overflow: clip;
    padding-bottom: 1.5rem;
  }

  .service-page > .section {
    padding-block: clamp(2.25rem, 4vw, 3.75rem);
  }

  .service-page > .section-compact {
    padding-block: 2rem;
  }

  .service-hero {
    padding-block: 1.15rem clamp(2rem, 4vw, 3.25rem);
  }

  .service-hero .breadcrumb {
    margin-bottom: 0;
  }

  .service-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.95fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .service-page--text-first .service-hero__inner {
    grid-template-columns: minmax(0, 1.08fr) minmax(17rem, 0.72fr);
  }

  .service-hero__copy,
  .service-hero__media,
  .service-hero__note {
    min-width: 0;
  }

  .service-hero__copy h1 {
    max-width: 12ch;
    margin-bottom: 1.15rem;
    font-size: clamp(2.9rem, 6vw, 5.2rem);
    line-height: 0.98;
  }

  .service-hero__copy .lead {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .service-hero__note {
    display: flex;
    min-height: 11rem;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.15rem, 3vw, 1.75rem);
    border: 1px solid rgba(23, 63, 52, 0.14);
    border-radius: var(--radius-large);
    background: rgba(255, 255, 255, 0.68);
    box-shadow: var(--shadow-small);
  }

  .service-hero__note .eyebrow {
    margin-bottom: 1rem;
  }

  .service-hero__note strong {
    max-width: 16ch;
    color: var(--forest-950);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.08;
  }

  .service-hero__note p:last-child {
    max-width: 28ch;
    margin: 1rem 0 0;
  }

  .service-highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .service-highlight {
    min-width: 0;
    padding-top: 1.1rem;
    border-top: 2px solid var(--wood-500);
  }

  .service-highlight h3 {
    margin-bottom: 0.45rem;
    font-family: var(--font-nav);
    font-size: 1.15rem;
  }

  .service-highlight p {
    margin-bottom: 0;
  }

  .service-request-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(20rem, 1.18fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }

  .service-request-grid > * {
    min-width: 0;
  }

  .service-request-grid h2 {
    max-width: 14ch;
  }

  .service-request-grid .feature-list {
    margin-top: 0;
  }

  .service-quote {
    padding-top: 0;
  }

  .service-quote__copy {
    max-width: 48rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-left: 2px solid var(--wood-500);
    background: var(--cream-100);
  }

  .service-quote__copy .eyebrow,
  .service-quote__copy h2,
  .service-quote__copy p {
    margin-bottom: 0.5rem;
  }

  .service-quote__copy p:last-child {
    margin-bottom: 0;
  }

  .service-process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-process-grid li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    min-width: 0;
  }

  .service-process-grid li > span {
    color: var(--wood-600);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .service-process-grid h3 {
    margin-bottom: 0.35rem;
    font-family: var(--font-nav);
    font-size: 1.08rem;
  }

  .service-process-grid p {
    margin-bottom: 0;
  }

  .service-media-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-cta {
    padding-bottom: 0;
  }

  .service-cta .button {
    flex: 0 0 auto;
  }

  .service-cta .eyebrow {
    color: #f0bd7e;
  }

  @media (max-width: 58rem) {
    .service-hero__inner,
    .service-page--text-first .service-hero__inner,
    .service-request-grid {
      grid-template-columns: 1fr;
    }

    .service-hero__media,
    .service-hero__note {
      max-width: 40rem;
    }

    .service-highlight-grid,
    .service-process-grid,
    .service-media-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .service-hero {
      padding-block: 1.35rem 3rem;
    }

    .service-hero__inner {
      gap: 1.75rem;
      margin-top: 2.25rem;
    }

    .service-hero__copy h1 {
      font-size: clamp(2.55rem, 12vw, 3.8rem);
    }

    .service-highlight-grid,
    .service-process-grid,
    .service-media-grid {
      grid-template-columns: 1fr;
    }

    .service-hero__copy .button-row,
    .service-cta .button {
      width: 100%;
    }

    .service-hero__copy .button-row {
      display: grid;
    }

    .service-cta .cta-panel {
      align-items: stretch;
      grid-template-columns: 1fr;
    }
  }
</style>
